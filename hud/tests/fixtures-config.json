    "sp-implementer": "build",
    "review-verifier": "smart",
    "verifier": "smart",
    "tester": "worker",
    "reviewer": "review",
    "review-*": "review",
    "researcher": "smart"
  },
  // The HUD's deployment copy: what each swap costs the rest of the machine, said where the
  // choice is made (the F11 picker) and while the user waits (the prepare notice).
  "hud": {
    "profiles": {
      "uncensored": {
        "badge": "R:unc",
        "prepareNotice": "Swapping GPU 1 to the uncensored 27b -- 1-3 minutes."
      },
      "uncensored-offline": {
        "badge": "R:unc-off",
        "prepareNotice": "Swapping GPU 1 to the uncensored 27b -- 1-3 minutes."
      },
      "uncensored-70b": {
        "badge": "R:unc-70b",
        "description": "Takes BOTH GPUs for several minutes and evicts every other resident model until you leave this profile",
        "prepareNotice": "Loading the 70B across BOTH GPUs -- several minutes. Every other local model is down until you leave this profile."
      },
      "vision": {
        "description": "Pins the local vision model instead of letting the broker pick the coder",
        "prepareNotice": "Bringing the vision model back. If another session is mid-conversation on the model that displaced it, this waits for them rather than taking it -- retry once they are done."
      }
    },
    "swapBack": {
      "profiles": ["uncensored*"],
      "command": ["true", "default"]
    }
  }
}
