// The burn watch (lib/burn-watch.js): fed by every /usage report and every plan
// reading, so it sees all sessions on this host at once. In memory on purpose -- its
// windows are minutes long, and a restart losing them only delays a trip.
const burnWatch = CONFIG.burnWatch.enabled ? createBurnWatch({ config: CONFIG.burnWatch }) : null;
const notifyBurn = (alert) => {
  console.error(`[opencode-broker] ${alert.title}: ${alert.body}`);
  const [command, ...args] = notifyArgv(CONFIG.burnWatch.notifyCommand, alert);
  if (!command) return;
  try {
    // Detached and ignored: an alert must never hold up the /usage reply it rides on.
    const child = spawn(command, args, { stdio: "ignore", detached: true });
    child.on("error", (error) => console.error(`[opencode-broker] burn alert failed: ${error?.message ?? error}`));
    child.unref();
  } catch (error) {
    console.error(`[opencode-broker] burn alert failed: ${error?.message ?? error}`);
  }
};
// The request queue's health, reported on /status and read by `opencode-broker health`.
// A queue wait past QUEUE_WAIT_ALERT_MS already means callers are timing out (the client
// gives up at 2.5 s), so it is worth a notification; alerts are rate-limited to one per
// STALL_ALERT_INTERVAL_MS, while every occurrence still reaches the journal.
const QUEUE_WAIT_ALERT_MS = 10_000;
const STALL_ALERT_INTERVAL_MS = 600_000;
const queueStats = { depth: 0, abandoned: 0, slowWaits: 0, deadlineHits: 0, lastDeadlineAt: null, lastAlertAt: 0 };
const localProviderIDs = (targets) => new Set(Object.values(targets)
  .filter((target) => target?.kind === "local").map((target) => target.providerID));

const STATE_ROOT = routingStateDir();
const STATE_PATH = join(STATE_ROOT, "broker.json");
// Every routing decision -- grants, revalidations, stickiness, REFUSALS and
// reported failures -- lands here as one JSON line, so "why did this session get
// that model" is always answerable after the fact. Bounded by truncation: this
// is a trace, not an audit ledger.
const DECISION_LOG = join(routingStateDir(), "decisions.jsonl");
const DECISION_LOG_MAX = 4 * 1024 * 1024;
const logDecision = (record) => {
  try {
    ensureRoutingStateDir();
    if (statSync(DECISION_LOG, { throwIfNoEntry: false })?.size > DECISION_LOG_MAX) {
      writeFileSync(DECISION_LOG, JSON.stringify({ at: Date.now(), event: "truncated" }) + "\n");
    }
    appendFileSync(DECISION_LOG, JSON.stringify(record) + "\n");
  } catch {}
};
// The usage log (lib/usage-log.js): one line per provider request with the prompt size it
// actually carried, for tuning local windows. ROTATED rather than truncated, unlike the
// decision trace: a size distribution is only worth anything with history behind it, so the
// previous generation is kept as usage.jsonl.1 (~2 x 8 MB, ~2-3 weeks of a busy host).
const USAGE_LOG = join(routingStateDir(), "usage.jsonl");
const USAGE_LOG_MAX = 8 * 1024 * 1024;
const logUsage = (record) => {
  try {
    ensureRoutingStateDir();
    if (statSync(USAGE_LOG, { throwIfNoEntry: false })?.size > USAGE_LOG_MAX) renameSync(USAGE_LOG, `${USAGE_LOG}.1`);
    appendFileSync(USAGE_LOG, JSON.stringify(record) + "\n");
  } catch {}
};
const TURN_EFFORT_LOG = join(routingStateDir(), "turn-effort.jsonl");
const TURN_EFFORT_LOG_MAX = 8 * 1024 * 1024;
const logTurnClass = (value) => value === undefined
  ? null
  : (TURN_CLASSES.includes(value) ? value : "invalid");
const logTurnReason = (value) => value === undefined
  ? null
  : (TURN_REASONS.has(value) ? value : "invalid");
const logResolvedFrom = (value) => value === undefined
  ? null
  : (["normal", "hard"].includes(value) ? value : "invalid");
const logTurnEffort = (record) => {
  try {
    ensureRoutingStateDir();
    if (statSync(TURN_EFFORT_LOG, { throwIfNoEntry: false })?.size > TURN_EFFORT_LOG_MAX) {
      renameSync(TURN_EFFORT_LOG, `${TURN_EFFORT_LOG}.1`);
    }
    appendFileSync(TURN_EFFORT_LOG, JSON.stringify(record) + "\n");
  } catch (error) {
    console.error(`[opencode-broker] could not write turn effort log: ${error?.message ?? error}`);
  }
};
// ☠️ A WAIT IS LOGGED ONCE A MINUTE PER SESSION, NOT ONCE PER POLL. A caller that waits out a
// busy or absent local model re-leases every few seconds, and each refusal was a decision line:
// a 36-request background burst waiting its turn wrote ~850 B/s, which would have truncated this
// 4 MiB trace -- and every routing decision in it -- within half an hour. The first wait, and one
// a minute after it, say everything a reader needs; the eventual lease or refusal follows.
const WAIT_LOG_INTERVAL_MS = 60_000;
const waitLogged = new Map(); // `${sessionID}\0${code}` -> at
const waitIsFresh = (decision) => {
  if (decision?.policy !== "waiting" || !decision.sessionID) return false;
  const key = `${decision.sessionID}\0${decision.code ?? ""}`;
  const last = waitLogged.get(key);
  if (last !== undefined && decision.at - last < WAIT_LOG_INTERVAL_MS) return true;
  waitLogged.set(key, decision.at);
  if (waitLogged.size > 2000) waitLogged.delete(waitLogged.keys().next().value);
  return false;
};
const recordDecision = (state, decision) => {
  state.lastDecision = decision;
  if (waitIsFresh(decision)) return;
  logDecision(decision);
};
const LEASE_TTL_MS = 2 * 60 * 60 * 1000;
// ☆ How long an IDLE session keeps its pin, counted from its last activity (see
// assignmentLastActive), not from when the model was picked. A pin buys two things: no
// re-read at full price, which the provider prompt cache (5 min to 1 h) has already lost
// after a few hours either way, and model continuity within a working stretch, which a
// lunch break should keep and the next day need not. It was 14 days until 2026-10-09,
// when ~500 sessions/day filled the cap and pins were evicted by count at ~22 h anyway.
const ASSIGNMENT_TTL_MS = 4 * 60 * 60 * 1000;
// A pin's own `updatedAt` moves only on a fresh SELECTION; a session that keeps reusing
// its pin moves `activeAt` instead (stampPinActivity, as each lease ends), so a long busy session
// is not treated as idle the moment its lease is released.
// After this long with no activity a session's provider prompt cache is gone (Anthropic's
// longest TTL is 1 h; OpenAI's is shorter), so its next lease is re-balanced instead of pinned.
const PIN_COLD_REBALANCE_MS = 60 * 60 * 1000;
// ☆ Worker-tier pins (opencode subagents) are EPHEMERAL: a subagent runs one task and is then
// deleted, so its pin has no "next day" to return to. Past the cache-cold mark the pin buys
// nothing -- its next lease re-balances anyway (PIN_COLD_REBALANCE_MS) -- yet it holds a cap slot
// for the full ASSIGNMENT_TTL_MS, and a fan-out of subagents is exactly what fills the map: 267 of
// 487 stale pins were a single worker model on 2026-10-21, forcing the cap to evict live-session
// pins (the stranding this prevents). So an IDLE worker pin is reclaimed at the cache-cold mark,
// not at 4 h. An ACTIVE subagent is never touched here: it holds a live lease (excluded below),
// and activeAt keeps its pin fresh between turns. The cap stays 512, so the per-request
// writeState() cost the cap comment weighs is unchanged -- this empties the map, not enlarges it.
const WORKER_ASSIGNMENT_TTL_MS = PIN_COLD_REBALANCE_MS;
const assignmentLastActive = (assignment) =>
  Math.max(Number(assignment?.updatedAt) || 0, Number(assignment?.activeAt) || 0);
// ☠️ A COUNT CAP, because the TTL alone is not a bound on anything that matters.
// writeState() serialises the WHOLE state and rename-writes it on EVERY request --
// /lease, /touch, /release, all of them -- so the size of this map is a per-request
// cost paid by every session, on a single-threaded daemon they all share. With only a
// 14-day TTL it grew with usage rather than with concurrency: measured 2026-09-08,
// 2,958 assignments and a 405 KB state file, and /status p50 at 23.0 ms. Pruning to
// the most recent 152 took the same call to 3.3 ms. The TTL says "old"; this says
// "too many", and they are different questions.
// ☆ 512 is generous on purpose: with the 4 h idle TTL, what the map holds is the
// sessions active in the last few hours, not every session of the last two weeks.
// Measured 2026-10-09: the per-request write is 1.8 ms p50 at 512 (124 KB) and 4.9 ms
// at 2048, so the cap is not something to raise to quiet the eviction warning.
const MAX_ASSIGNMENTS = 512;
const RATE_LIMIT_MS = 5 * 60 * 1000;
// A brief provider overload (529/503) is transient: fence the target for a few
// seconds so a quick recovery returns to the SAME provider, record no health
// evidence, and never quarantine. Kept under opencode's ~30s retry so its own
// backoff rides it out without a switch.
const OVERLOAD_MS = 15 * 1000;
// An unreachable endpoint, provider-scoped. Long enough that a restarting container is not
// hammered on every turn, short enough that a lane which comes back is used again promptly --
// llama.cpp's own app restart took ~90 s door to door on 2026-09-14.
const CONNECT_MS = 60 * 1000;
// How long a session steers clear of what a provider guard refused or rerouted (see the
// `policy` kind in lib/routing.js). Claude Code keeps a flagged session on its fallback for
// the rest of the session, and OpenAI's cyber flags are account-level; 12 h covers a working
// session without pinning a long-lived one forever. Bounded like assignments.
const POLICY_AVOID_MS = 12 * 60 * 60 * 1000;
const MAX_POLICY_AVOIDS = 512;
// Quota with no known reset: re-probe at a bounded cadence (one failed request
// per probe) instead of holding the provider out until state surgery.
const QUOTA_REPROBE_MS = 15 * 60 * 1000;
// TRAP: FAST-MODE-CREDITS: SAME CLASS OF FACT AS A LAPSED PLAN, SAME HOLD. The
// account owner must buy credits to lift it (a human action, no reset time
// announced), and no background check can exercise fast mode for free -- so the
// expiry IS the re-probe. One real request per hold window:
//   - gateway own-lease path: fails over inside the same request.
//   - bound session: one failed turn the session's router re-routes.
// An operator who has just bought credits lifts it at once with /rearm per
// target. This is NOT the model-probation machinery (lib/model-probation.js) --
// that is the dormant-model promotion runtime, not circuit recovery.
const FAST_MODE_CREDITS_HOLD_MS = LAPSED_HOLD_MS;
// Hosts auto-compact a session near (context - output reserve) -- about 60-70%
// of the declared window. A model whose window the session has burned past
// this share of is one the host will imminently compress on; selection should
// move the session to a roomier window first.
const CONTEXT_PRESSURE = 0.6;
const LOCAL_MODELS_URL = envSetting("OPENCODE_BROKER_LOCAL_MODELS_URL", "OPENCODE_MODEL_ROUTER_LOCAL_MODELS_URL") ?? CONFIG.localModelsUrl;
const PROVIDER_SCOPE = /^provider:([a-z0-9][a-z0-9._:-]{0,180})$/;
const REASON_CODE = /^[a-z0-9][a-z0-9._:-]{0,63}$/;

const emptyInventory = () => ({ targets: {}, providers: {}, modelContexts: {}, modelOutputs: {}, modelVariants: {}, authRevision: null, updatedAt: 0 });
// One derivation of auth revision/types for the whole product: routing.js
// owns it (authSnapshot); duplicating the parse here desynchronized once.
const authRevision = () => authSnapshot().revision;
const authTypes = () => authSnapshot().types;
const emptyHealth = () => normalizeHealth({});
// What an admission filter refused, on stderr. A poisoned publication is the operator's
// only signal that some pane is still running pre-fix plugin code, so it is reported on
// every ingest rather than once: it stops when the offending publisher does. The name
// list is bounded because a missing resolver view drops the whole catalog at once.
// `source` names the boundary that refused it -- `/inventory` for a client publication,
// `broker.json` for the stored inventory reloaded at startup -- because the two call for
// different operator action: a live publisher to find versus a state file already written.
// Nothing is logged when nothing was dropped, so a clean start stays silent.
const reportInventoryDrops = ({ droppedTargets, droppedModelKeys }, source = "/inventory") => {
  const overflow = (list, shown) => (list.length > shown ? `, and ${list.length - shown} more` : "");
  if (droppedTargets.length) {
    const named = droppedTargets.slice(0, 10)
      .map((drop) => `${drop.providerID}/${drop.modelID} (${drop.reason})`).join(", ");
    console.error(`[opencode-broker] ${source} dropped ${droppedTargets.length} target(s) this host cannot resolve: ${named}${overflow(droppedTargets, 10)}`);
  }
  if (droppedModelKeys.length) {
    const named = droppedModelKeys.slice(0, 10).join(", ");
    console.error(`[opencode-broker] ${source} dropped catalog data for ${droppedModelKeys.length} unresolvable model(s): ${named}${overflow(droppedModelKeys, 10)}`);
  }
};
const emptyState = () => ({ version: 5, leases: {}, assignments: {}, circuits: {}, cursors: {}, inventory: emptyInventory(), health: emptyHealth(), budgets: {}, lastDecision: null, planUsage: {}, rebalances: {}, modelPolicy: emptyModelPolicy(), outages: emptyOutages(), policyAvoids: {}, apiContinuations: {} });
const readState = () => {
  let source;
  try {
    source = readFileSync(STATE_PATH, "utf8");
  } catch (error) {
    if (error?.code === "ENOENT") return emptyState();
    throw error;
  }
  let value;
  try {
    value = JSON.parse(source);
  } catch (error) {
    throw new Error(`broker state is corrupt: ${error.message}`);
  }
  if (value?.version !== 4 && value?.version !== 5) {
    throw new Error(`broker state version ${JSON.stringify(value?.version)} is unsupported`);
  }
  const modelPolicy = value.version === 4
    ? emptyModelPolicy()
    : normalizeModelPolicy(value.modelPolicy, { modelRoles: CONFIG.modelRoles, staticTargets: TARGETS });
  {
    // CRITICAL: THE DAEMON DOES NOT TRUST ITS OWN STATE FILE. /inventory is only one of the
    // two ways discovered inventory enters this process; the other is this reload. A daemon
    // poisoned before the ingest filter existed -- or by any pane still publishing pre-fix --
    // has already written those targets to broker.json, and without this they come straight
    // back at the next restart with no client involved (measured on this host 2026-09-23:
    // broker.json held gpt-6-astra/-luna/-sol, so a restart routed worker and deep to
    // unresolvable models until some later ingest happened to clean them out).
    //
    // Same filter, same fail-closed semantics as ingest: a missing or unusable resolver view
    // admits NOTHING, which leaves every tier on its configured static pins -- the known-good
    // ones, which this filter never touches. Scope is the DISCOVERED inventory only; every
    // other field below keeps its existing shape-normalization behavior untouched.
    const admitted = admitResolvableInventory(normalizeDiscoveredInventory(value?.inventory), readResolvableModels());
    reportInventoryDrops(admitted, "broker.json");
    const inventory = admitted.inventory;
    const health = normalizeHealth(value?.health);
    // Restore the plan-usage readings the previous process had. Without this the
    // cache is empty on boot, nothing counts as OBSERVED, and the unobserved
    // balancing stands down until the first refresh lands -- a window in which
    // an unreadable quota is once again the leanest-looking lane.
    seedPlanUsageCache(value?.planUsage);
    return {
      version: 5,
      leases: value?.leases && typeof value.leases === "object" ? value.leases : {},
      assignments: value?.assignments && typeof value.assignments === "object" ? value.assignments : {},
      circuits: value?.circuits && typeof value.circuits === "object" ? value.circuits : {},
      cursors: value?.cursors && typeof value.cursors === "object" ? value.cursors : {},
      inventory: {
        ...inventory,
        authRevision: typeof value?.inventory?.authRevision === "string" ? value.inventory.authRevision : null,
        updatedAt: Number(value?.inventory?.updatedAt) || 0,
      },
      health,
      budgets: value?.budgets && typeof value.budgets === "object" ? value.budgets : {},
      planUsage: value?.planUsage && typeof value.planUsage === "object" ? value.planUsage : {},
      // Per-session rebalance clock. This MUST survive a reload: readState is a
      // whitelist, and a dropped map reads as "never rebalanced", which turns the
      // cooldown off and lets every restart move a session to a new provider.
      rebalances: value?.rebalances && typeof value.rebalances === "object" ? value.rebalances : {},
      lastDecision: value?.lastDecision && typeof value.lastDecision === "object" ? value.lastDecision : null,
      modelPolicy,
      // Optional outage-episode state (lib/model-outage-state.js): whitelisted field by field,
      // never passed through. Whatever does not decode restores as "can authorize nothing".
       outages: decodeOutages(value?.outages, { policy: CONFIG.modelOutages }),
      policyAvoids: normalizePolicyAvoids(value?.policyAvoids),
      // Subscription-quota source proof (lib/api-continuation.js). Untrusted on reload like
      // everything else here: a malformed or non-durable record is dropped, never repaired. The
      // decoded map is frozen, so a mutable copy is kept; serve()'s first sweep then re-proves
      // every survivor against the live circuit, auth and policy before anything reads it.
      apiContinuations: { ...normalizeApiContinuationRecords(value?.apiContinuations, { now: Date.now(), max: MAX_ASSIGNMENTS }) },
    };
  }
};

const allTargets = (state) => ({
  ...TARGETS,
  ...Object.fromEntries(Object.entries(state.inventory?.targets ?? {}).map(([id, target]) => {
    const key = `${target.providerID}/${target.modelID}`;
    return [id, {
      ...target,
      ...(state.inventory?.modelContexts?.[key] ? { context: state.inventory.modelContexts[key] } : {}),
      ...(state.inventory?.modelOutputs?.[key] ? { output: state.inventory.modelOutputs[key] } : {}),
      ...(state.inventory?.modelVariants?.[key] ? { variants: [...state.inventory.modelVariants[key]] } : {}),
    }];
  })),
});

// Ordinary writes atomically rename the replacement without fsync, so they provide a visible,
// torn-free state but no crash-durability guarantee. `requireDurable` is the outage commit mode:
// it fsyncs both the replacement file and its directory; a directory-fsync failure stays visible
// and throws for the strict caller, so uncertain probe reservations never reach gateway dispatch.
const boundedEqual = (left, right, limit = 4096) => {
  let remaining = limit;
  const equal = (a, b) => {
    if (--remaining < 0) return false;
    if (Object.is(a, b)) return true;
    if (!a || !b || typeof a !== "object" || typeof b !== "object" || Array.isArray(a) !== Array.isArray(b)) return false;
    const aKeys = Object.keys(a);
    const bKeys = Object.keys(b);
    if (aKeys.length !== bKeys.length) return false;
    for (const key of aKeys) if (!Object.hasOwn(b, key) || !equal(a[key], b[key])) return false;
    return true;
  };
  return equal(left, right);
};

// State mutations happen before their atomic replacement write. Retain that intent when a sweep
// or a failed write changes the in-memory image, so a later read cannot treat it as durably
// acknowledged. A strict outage write keeps its stronger requirement until a later strict write
// fsyncs the directory.
const persistenceIntents = new WeakMap();
const pendingPersistence = (state) => persistenceIntents.get(state) ?? 0;
const notePendingPersistence = (state, requireDurable) => {
  persistenceIntents.set(state, Math.max(pendingPersistence(state), requireDurable ? 2 : 1));
};
const noteSuccessfulPersistence = (state, requireDurable) => {
  if (requireDurable || pendingPersistence(state) < 2) persistenceIntents.delete(state);
};

// Health and plan snapshots use bounded comparison so unexpectedly large control-plane data is
// conservatively treated as changed. Model-policy is strict, valid, and unbounded by size: use
// exact structural comparison so its complete acknowledgement histories never cause spurious I/O.
const prepareStateForPersistence = (state) => {
  let changed = false;
  if (state.version !== 5) { state.version = 5; changed = true; }
  const health = normalizeHealth(state.health);
  if (!boundedEqual(state.health, health)) { state.health = health; changed = true; }
  const modelPolicy = normalizeModelPolicy(state.modelPolicy, { modelRoles: CONFIG.modelRoles, staticTargets: TARGETS });
  if (!isDeepStrictEqual(state.modelPolicy, modelPolicy)) { state.modelPolicy = modelPolicy; changed = true; }
  const planUsage = planUsageSnapshot();
  if (Object.keys(planUsage).length && !boundedEqual(state.planUsage, planUsage)) {
    state.planUsage = planUsage;
    changed = true;
  }
  return changed;
};

const writeState = (state, { requireDurable = false } = {}) => {
  let temporary;
  let temporaryCreated = false;
  let descriptor;
  let committed = false;
  try {
    // Directory validation and normalization may mutate the in-memory image. Keep them in this
    // tracked region so their failures retain the caller's pending persistence intent too.
    ensureRoutingStateDir();
    prepareStateForPersistence(state);
    // Carry the plan readings across restarts; see seedPlanUsageCache. Written
    // from the live cache rather than held on `state`, so it cannot go stale
    // relative to what the process actually knows.
    temporary = `${STATE_PATH}.${process.pid}.${randomUUID()}.tmp`;
    // Build the replacement privately. "wx" refuses a collision rather than truncating another
    // writer's temp; fchmod enforces the exact mode despite the caller's umask.
    descriptor = openSync(temporary, "wx", 0o600);
    temporaryCreated = true;
    writeFileSync(descriptor, JSON.stringify(state) + "\n");
    fchmodSync(descriptor, 0o600);
    // Atomic rename (below) is the CONSISTENCY boundary for every write -- a reader always sees a
    // torn-free prior-or-new state. The blocking fsync-to-stable-storage is DURABILITY, and it is
    // gated on requireDurable. Broker state is EPHEMERAL routing (leases/assignments the broker
    // rebuilds as sessions re-lease on restart), so paying a per-request fsync -- on ZFS, under the
    // host's disk contention, on the single-threaded daemon every session shares -- made even
    // /status ~1.4s and backed the whole request queue up, which the router then saw as a "broker
    // timeout" (2026-10-23). Ordinary writes atomically replace the visible state but make no
    // crash-durability or bounded-loss guarantee; only the outage commit (requireDurable:true) fsyncs.
    if (requireDurable) fsyncSync(descriptor);
    closeSync(descriptor);
    descriptor = undefined;
    renameSync(temporary, STATE_PATH);
    committed = true;
  } catch (error) {
    // Before rename, the old broker.json is still authoritative. Remove only this writer's temp
    // and report the original write failure; cleanup trouble is an additional warning, never a
    // reason to hide which durability step failed.
    if (descriptor !== undefined) {
      try { closeSync(descriptor); }
      catch (closeError) {
        try {
          console.error(`[opencode-broker] unable to close failed broker state temp ${temporary}: ${closeError?.message ?? closeError}`);
        } catch {}
      }
    }
    if (temporaryCreated) {
      try { unlinkSync(temporary); }
      catch (cleanupError) {
        if (cleanupError?.code !== "ENOENT") {
          try {
            console.error(`[opencode-broker] unable to remove failed broker state temp ${temporary}: ${cleanupError?.message ?? cleanupError}`);
          } catch {}
        }
      }
    }
    notePendingPersistence(state, requireDurable);
    throw error;
  }

  // Rename is the commit boundary. A parent-directory fsync failure means the new state is visible
  // but may not survive a crash; warning is accurate, while throwing would falsely tell the caller
  // that an already committed mutation failed and invite it to repeat the operation.
  // Directory fsync makes the renamed entry itself crash-durable -- durability, not consistency, so
  // it is skipped for ordinary (non-requireDurable) writes along with the file fsync above.
  if (committed && requireDurable) {
    let directoryDescriptor;
    let durabilityError = null;
    try {
      directoryDescriptor = openSync(STATE_ROOT, "r");
      fsyncSync(directoryDescriptor);
    } catch (error) {
      durabilityError = error;
      try {
        console.error(`[opencode-broker] broker state ${STATE_PATH} was committed but its directory entry could not be made durable: ${error?.message ?? error}`);
      } catch {}
    } finally {
      if (directoryDescriptor !== undefined) {
        try { closeSync(directoryDescriptor); }
        catch (error) {
          try {
            console.error(`[opencode-broker] broker state ${STATE_PATH} was committed but its directory descriptor could not be closed: ${error?.message ?? error}`);
          } catch {}
        }
      }
    }
    // Visible but not durable. The strict caller must not treat this as committed; it also must
    // not roll the visible file back (the in-memory image it carries is the conservative one).
    if (durabilityError && requireDurable) {
      notePendingPersistence(state, requireDurable);
      throw new Error(`broker state directory fsync failed after rename (visible, not durable): ${durabilityError?.message ?? durabilityError}`);
    }
  }
  noteSuccessfulPersistence(state, requireDurable);
};

const validSessionID = (sessionID) => typeof sessionID === "string" && /^[A-Za-z0-9_-]{1,200}$/.test(sessionID);
const normalizeSessionKind = (sessionKind) => sessionKind === "primary" || sessionKind === "subagent"
  ? sessionKind
  : null;
// The prefix a per-request session id must carry. The gateway builds `gw-<time36>-<rand>`
// for every client call; nothing else may claim oneShot (acquire() refuses it).
const ONE_SHOT_SESSION_PREFIX = /^gw-/;
// Spend admission is based only on this broker-generated claim.  A lease target can
// be influenced by the caller's profile/provider selection, but its paid classification
// must match one immutable static registration exactly; never relay caller metadata.
const manualApiAttestation = (target) => {
  const registered = typeof target?.id === "string" ? CONFIG.manualApiTargets[target.id] : null;
  return target?.source === undefined && target?.kind === "cloud" &&
    registered?.providerID === target.providerID && registered.modelID === target.modelID
    ? { requiresSpendBudget: true, billingClass: "manual-api" }
    : {};
};

// `attestation` is the paid context of an ACTUAL lease (currentLeaseAttestation). Only a caller
// without a lease -- /preview -- falls back to the static legacy manual attestation, which never
// carries a grant and can never say api-continuation.
const publicTarget = (target, tier, modelVariants, attestation = manualApiAttestation(target)) => target && {
  id: target.id,
  model: modelRefForTier(target, tier, modelVariants),
  kind: target.kind,
  ...(target.embedding === true ? { embedding: true } : {}),
  ...attestation,
};

// /status is readable by any local client, so the continuation internals stay in the private
// state file only: a spend grant, the source snapshot, a quota observation or its conflict
// tombstone become presence booleans, and a grant-bearing lease loses its lease ID (the ID is
// what /lease/verify attests, so publishing it would hand out the paid route). Ordinary leases
// keep every field, including leaseID -- the gateway's startup sweep reads only the lease keys.
const CONTINUATION_LEASE_FIELDS = Object.freeze({
  spendGrant: "hasSpendGrant",
  apiContinuationSource: "hasApiContinuationSource",
  quotaObservation: "hasQuotaObservation",
  quotaObservationConflict: "hasQuotaObservationConflict",
});
const publicLease = (lease) => {
  if (!lease || typeof lease !== "object" || Array.isArray(lease)) return lease;
  const out = { ...lease };
  for (const [field, flag] of Object.entries(CONTINUATION_LEASE_FIELDS)) {
    if (!Object.hasOwn(out, field)) continue;
    const present = out[field] !== undefined && out[field] !== null;
    delete out[field];
    if (present) out[flag] = true;
  }
  if (out.hasSpendGrant === true) delete out.leaseID;
  return out;
};

// The assignment records the same lease ID, so it is dropped there too for exactly the
// grant-bearing leases -- those still held, and (by the assignment's grantLease mark) those that
// have already ended; every other assignment field (and every ordinary assignment) is kept.
const grantLeaseIDs = (leases) => new Set(Object.values(leases ?? {})
  .filter((lease) => lease?.spendGrant !== undefined && lease?.spendGrant !== null && typeof lease.leaseID === "string")
  .map((lease) => lease.leaseID));
const publicAssignments = (assignments, hidden) => Object.fromEntries(Object.entries(assignments ?? {})
  .map(([sessionID, assignment]) => {
    if (!assignment || typeof assignment !== "object" ||
      (!hidden.has(assignment.leaseID) && assignment.grantLease !== true)) return [sessionID, assignment];
    const { leaseID: _hidden, ...rest } = assignment;
    return [sessionID, rest];
  }));

const publicState = (state, resolverProcesses = null) => ({
  ...state,
  leases: Object.fromEntries(Object.entries(state.leases ?? {}).map(([sessionID, lease]) => [sessionID, publicLease(lease)])),
  assignments: publicAssignments(state.assignments, grantLeaseIDs(state.leases)),
  apiContinuations: Object.fromEntries(Object.keys(state.apiContinuations ?? {}).map((sessionID) => [sessionID, true])),
  turnEffortConfigError: TURN_EFFORT_CONFIG_ERROR,
  // A boolean only: the key-only message is on stderr at startup. true means every registered
  // manual API target is fail-closed until the apiContinuation block is fixed.
  apiContinuationConfigError: API_CONTINUATION_CONFIG_ERROR !== null,
  ...(resolverProcesses ? { resolverProcesses: resolverProcesses.status() } : {}),
  circuits: Object.fromEntries(Object.entries(state.circuits).map(([key, circuit]) => [key, {
    ...circuit,
    renewsAt: circuit?.until === null || !Number.isFinite(Number(circuit?.until))
      ? null
      : new Date(Number(circuit.until)).toISOString(),
  }])),
  health: normalizeHealth(state.health),
  budgets: (() => {
    const report = budgetReport(state.budgets);
    for (const providerID of Object.keys(PROVIDER_BUDGETS)) {
      const plan = cachedPlanUsage(providerID);
      if (!plan) continue;
      // The estimate fields (utilization, windows) keep their own source flag;
      // the plan block is self-describing. Overwriting the top-level source
      // made the object lie about the numbers next to it.
      report[providerID] = {
        ...(report[providerID] ?? { source: "provider-reported-only" }),
        plan,
      };
    }
    return report;
  })(),
  lastDecision: state.lastDecision,
  // Renamed settings still in use (old config directory, old environment names).
  // Empty on a clean install; see lib/config.js.
  ...(DEPRECATIONS.length ? { deprecations: [...DEPRECATIONS] } : {}),
});

// Remote usage reads never occupy the mutation queue. This function only applies reports that
// a preflight or background refresh has already placed in the plan-usage cache.
const fetchPlanUsageReports = () => Promise.all(Object.entries(PROVIDER_BUDGETS).map(async ([providerID, providerConfig]) => {
  if (!planUsageConfigured(providerConfig)) return;
  try { await fetchPlanUsage(providerID, providerConfig); } catch {}
}));

const refreshPlanUsage = (state) => {
  let changed = false;
  for (const [providerID, providerConfig] of Object.entries(PROVIDER_BUDGETS)) {
    if (!planUsageConfigured(providerConfig)) continue;
    const report = cachedPlanUsage(providerID);
    if (!report) continue;
    const circuitID = providerCircuitID(providerID);
    const beforeCircuit = state.circuits[circuitID];
    applyPlanUsageCircuit(state.circuits, providerCircuitID(providerID), report);
    if (beforeCircuit !== state.circuits[circuitID]) changed = true;
    if (applyCheckResult(state, providerID, planUsageResult(freshPlanUsage(providerID)), { persist: false })) changed = true;
  }
  if (prepareStateForPersistence(state)) changed = true;
  if (changed) writeState(state);
};

// One provider-check result onto the provider circuit, with the transition logged and
// pushed. Shared by the usage refresh above and the timer for providers without one.
const applyCheckResult = (state, providerID, result, { persist = true } = {}) => {
  const now = Date.now();
  const circuitID = providerCircuitID(providerID);
  const before = state.circuits[circuitID];
  const change = applyProviderCheck(state.circuits, circuitID, result, now);
  // A repeated plan-lapsed result extends its expiry without being a new user-visible
  // transition. Persist that real mutation, but only log and notify actual transitions.
  const mutated = !boundedEqual(before, state.circuits[circuitID]);
  if (!mutated) return false;
  notePendingPersistence(state);
  if (persist) writeState(state);
  if (!change) return true;
  logDecision({ at: now, sessionID: null, targetID: null, policy: `provider-check-${change}`, reasons: [providerID] });
  notifyBurn(change === "lapsed"
    ? { title: `${providerID} plan lapsed`, body: "Held out of routing; it returns on its own once the plan is renewed." }
    : { title: `${providerID} is usable again`, body: "The provider check lifted its hold; it is back in routing." });
  return true;
};

// A one-shot assignment belongs to a session id that is minted per REQUEST and never reused,
// so once its lease is gone nothing can read it back. Callers declare it on /lease, but the
// flag only exists on assignments written since that option shipped: a broker upgraded in
// place carries hundreds of flagless gateway entries (455 measured on this host 2026-09-23).
// Treating those as session pins makes the tiered eviction below a no-op on exactly the
// traffic it was written for -- they would sit PROTECTED ahead of real pins for the full
// 14-day TTL. So the prefix is read when the flag is absent: `gw-` is the gateway's own naming
// contract (`gw-<time36>-<rand>`, gateway/lib/gateway.js), and acquire() refuses a oneShot
// declaration from any other prefix, which is what keeps the two sides of this agreeing.
const isOneShotAssignment = (assignment, sessionID) => assignment?.oneShot === true ||
  (assignment?.oneShot === undefined && ONE_SHOT_SESSION_PREFIX.test(sessionID));

const modelPolicyRoleForTarget = (state, target) => Object.values(state.modelPolicy?.roles ?? {})
  .find((role) => role?.providerID === target?.providerID && (
    (role.probation?.phase === "probation" && role.probationModelID === target?.modelID) ||
    (role.probation?.phase === "active" && role.activeModelID === target?.modelID &&
      role.activeModelID !== role.rollbackModelID)
  )) ?? null;

const settlePolicyLease = (state, lease, { outcome, failureClass, source, now = Date.now() }) => {
  if (!lease?.modelPolicyRoleKey || !lease?.leaseID || !lease?.sessionID) return null;
  const result = settleCandidateOutcome(state.modelPolicy, {
    roleKey: lease.modelPolicyRoleKey,
    leaseID: lease.leaseID,
    sessionID: lease.sessionID,
    outcome,
    failureClass,
    source,
    now,
  });
  state.modelPolicy = result.policy;
  return result.event;
};

const policyLeaseBinding = (state, leaseID, sessionID) => {
  for (const role of Object.values(state.modelPolicy?.roles ?? {})) {
    const record = role?.probation?.leases?.[leaseID];
    if (!record) continue;
    if (record.sessionID !== sessionID) throw new Error("lease id does not match session id");
    return {
      leaseID,
      sessionID,
      targetID: record.targetID ?? null,
      modelPolicyRoleKey: role.roleKey,
      historical: true,
    };
  }
  return null;
};

const hasPolicyLeaseBindingForSession = (state, sessionID) => Object.values(state.modelPolicy?.roles ?? {})
  .some((role) => Object.values(role?.probation?.leases ?? {})
    .some((record) => record?.sessionID === sessionID));

// ── Session policy avoids ─────────────────────────────────────────────────────────────────
// A provider guard (refusal, content filter, cyber/usage-policy flag, a silent model reroute)
// is a verdict on ONE conversation. The session that drew it avoids the refusing model -- or,
// for OpenAI, whose flags are account-level, every OpenAI target -- for POLICY_AVOID_MS, so its
// re-engage and every later lease land on a model that will answer. It is never a circuit:
// every other session keeps the target. Whitelisted field by field on reload.
const POLICY_AVOID_ID = /^[a-z0-9][a-z0-9._:-]{0,180}$/;
const normalizePolicyAvoids = (value, now = Date.now()) => {
  const out = {};
  if (!value || typeof value !== "object" || Array.isArray(value)) return out;
  for (const [sessionID, entry] of Object.entries(value)) {
    if (!validSessionID(sessionID) || !entry || typeof entry !== "object") continue;
    const until = Number(entry.until);
    if (!Number.isFinite(until) || until <= now) continue;
    const ids = (list) => (Array.isArray(list) ? [...new Set(list.filter((id) => typeof id === "string" && POLICY_AVOID_ID.test(id)))].slice(0, 64) : []);
    const targetIDs = ids(entry.targetIDs), providerIDs = ids(entry.providerIDs);
    if (!targetIDs.length && !providerIDs.length) continue;
    out[sessionID] = { targetIDs, providerIDs, until, reason: typeof entry.reason === "string" ? entry.reason.slice(0, 200) : "policy" };
  }
  return out;
};

// scope "provider" avoids every target of the target's provider; "target" only that target.
const recordPolicyAvoid = (state, sessionID, target, { scope, reason, now = Date.now() }) => {
  if (!validSessionID(sessionID) || !target?.id) return null;
  state.policyAvoids ??= {};
  const prior = state.policyAvoids[sessionID];
  const current = prior && prior.until > now ? prior : { targetIDs: [], providerIDs: [] };
  const entry = {
    targetIDs: scope === "provider" ? current.targetIDs : [...new Set([...current.targetIDs, target.id])],
    providerIDs: scope === "provider" ? [...new Set([...current.providerIDs, target.providerID])] : current.providerIDs,
    until: now + POLICY_AVOID_MS,
    reason: String(reason ?? "policy").slice(0, 200),
  };
  state.policyAvoids[sessionID] = entry;
  return entry;
};

const policyAvoidTargetIDs = (state, sessionID, targets, now = Date.now()) => {
  const entry = state.policyAvoids?.[sessionID];
  if (!entry || !(entry.until > now)) return [];
  const providers = new Set(entry.providerIDs);
  return [...new Set([...entry.targetIDs, ...Object.values(targets)
    .filter((target) => target && providers.has(target.providerID)).map((target) => target.id)])]
    .filter((id) => POLICY_AVOID_ID.test(id));
};

const settlementBinding = (state, body, { usage = false } = {}) => {
  const sessionID = validSessionID(body.sessionID) ? body.sessionID : null;
  if (!sessionID) {
    if (usage && body.leaseID === undefined) return null;
    throw new Error("invalid session id");
  }
  const currentLease = state.leases[sessionID];
  const assignment = state.assignments[sessionID];
  const brokerMintedBinding = Boolean(currentLease?.leaseID || assignment?.leaseID ||
    hasPolicyLeaseBindingForSession(state, sessionID));
  if (body.leaseID === undefined) {
    if (brokerMintedBinding) throw new Error("lease id is required for settlement");
    return currentLease ?? assignment ?? null;
  }
  if (!validSessionID(body.leaseID)) throw new Error("invalid lease id");
  if (currentLease?.leaseID === body.leaseID) return currentLease;
  if (assignment?.leaseID === body.leaseID) return assignment;
  const historical = policyLeaseBinding(state, body.leaseID, sessionID);
  if (historical) return historical;
  throw new Error("unknown or stale lease id for session");
};

const bindingTargetID = (binding, body) => {
  if (binding?.targetID) {
    if (body.targetID !== undefined && body.targetID !== binding.targetID) {
      throw new Error("target id does not match lease id");
    }
    return binding.targetID;
  }
  return body.targetID || null;
};

// A lease ending is the session's last activity on its pin: the idle TTL starts here.
// Stamped only when a lease ends -- while one is live the pin cannot expire anyway, and
// stamping on every request would turn a read-only replay into a state change.
const stampPinActivity = (state, sessionID, at) => {
  const assignment = state.assignments[sessionID];
  if (assignment && at > (Number(assignment.activeAt) || 0)) assignment.activeAt = at;
};

const dropExactLease = (state, sessionID, leaseID) => {
  if (state.leases[sessionID]?.leaseID === leaseID ||
    (leaseID === undefined && state.leases[sessionID]?.leaseID === undefined)) {
    delete state.leases[sessionID];
    stampPinActivity(state, sessionID, Date.now());
  }
};

const removePolicyLeaseBinding = (state, lease) => {
  const leases = lease?.modelPolicyRoleKey
    ? state.modelPolicy?.roles?.[lease.modelPolicyRoleKey]?.probation?.leases
    : null;
  if (leases && lease?.leaseID) delete leases[lease.leaseID];
};

// Called wherever a lease ENDS. An ordinary assignment stays -- it is the session's pin, and
// the next turn reads it back, which is what stickiness is. A one-shot's has no next turn and
// no reader, so keeping it only spends cap space and file size until the cap overflows onto
// real pins. Dropping it here is what keeps the tiered eviction a rarely-used backstop.
const dropOneShotAssignment = (state, sessionID, leaseID) => {
  if (isOneShotAssignment(state.assignments[sessionID], sessionID) &&
    (leaseID === undefined || state.assignments[sessionID]?.leaseID === leaseID)) {
    delete state.assignments[sessionID];
  }
};

// ── Subscription-quota continuation EVIDENCE (lib/api-continuation.js) ───────────────────────
// This phase only captures and proves; nothing here routes to, grants or funds a paid target.
//   1. A NEW eligible ordinary source lease carries a closed private snapshot of its source
//      identity (apiContinuationSource). Held legacy leases are never retrofitted.
//   2. /quota-evidence stores one broker-timestamped observation on that EXACT current lease. It
//      settles nothing and creates no circuit, usage, proof or grant.
//   3. The plugin's later exact /failure on that lease consumes the observation and, only for an
//      uncontradicted quota failure with a matching (or lost) reset, persists a closed record in
//      state.apiContinuations once continuationAuthorityCurrent re-proves it.
//   4. sweep() prunes every record that is orphaned or no longer current authority.
// The snapshot is not a paid attestation and no secret or raw provider body is ever stored.
// Circuit kinds that are a real USAGE stop: mirrors lib/usage-limit.js activeUsageLimits exactly
// (its `["plan-window", "quota"].includes(circuit.kind)`); keep the two lists in step.
const USAGE_STOP_CIRCUIT_KINDS = Object.freeze(["plan-window", "quota"]);
const SOURCE_SNAPSHOT_KEYS = Object.freeze(["version", "targetID", "providerID", "modelID", "authRevision", "policyRevision", "issuedAtMs"]);
const QUOTA_OBSERVATION_KEYS = Object.freeze(["version", "observedAtMs", "policyRevision", "subscriptionQuota"]);
const QUOTA_EVIDENCE_BODY_KEYS = Object.freeze(["sessionID", "leaseID", "targetID", "subscriptionQuota"]);
const closedKeys = (value, keys) => value !== null && typeof value === "object" && !Array.isArray(value) &&
  Object.getPrototypeOf(value) === Object.prototype && Object.keys(value).length === keys.length &&
  keys.every((key) => Object.hasOwn(value, key));

// Durable native session, auto profile, generation tier, never a one-shot or embeddings call.
// Probes (gw-probe-*) and gateway one-shots fail the durable session ID check.
const continuationGenerationLease = ({ sessionID, profile, tier, oneShot, api }) =>
  continuationSessionEligible({ sessionID, profile, oneShot, api }) &&
  ROUTE_TIER_NAMES.includes(tier) && !NON_GENERATION_TIERS.includes(tier);

// A readable revision of the SOURCE provider's own auth.json entry (lib/routing.js
// providerAuthRevision), or null when the file is unreadable or the provider has no entry. This,
// not the whole-file revision, is what a source snapshot and a continuation record are fenced to:
// an unrelated provider's OAuth refresh rewrites the file but must not revoke the record.
const liveSourceAuthRevision = (providerID) => {
  const revision = typeof providerID === "string" && providerID ? providerAuthRevision(providerID) : null;
  return typeof revision === "string" && revision !== "absent" ? revision : null;
};

// The live source context for one target: the enabled policy, its published provider, ONE
// whole-file auth snapshot whose non-null revision equals the published inventory revision, and
// the source provider's own readable entry revision.
const continuationSourceContext = (state, target) => {
  const policy = CONFIG.apiContinuation;
  if (policy?.enabled !== true || !target) return null;
  const auth = authSnapshot();
  if (!auth.revision || auth.revision !== state.inventory?.authRevision) return null;
  const provider = state.inventory?.providers?.[target.providerID];
  if (!sourceTargetEligible({ target, policy, provider, liveAuthType: auth.types?.[target.providerID],
    manualApiTargets: CONFIG.manualApiTargets })) return null;
  const sourceAuthRevision = liveSourceAuthRevision(target.providerID);
  if (sourceAuthRevision === null) return null;
  return { policy, auth, provider, sourceAuthRevision };
};

const issueContinuationSource = (state, request, target, now) => {
  if (!continuationGenerationLease(request)) return null;
  const context = continuationSourceContext(state, target);
  if (!context) return null;
  return {
    version: 1,
    targetID: target.id,
    providerID: target.providerID,
    modelID: target.modelID,
    // The source provider's own entry revision, never the whole-file revision.
    authRevision: context.sourceAuthRevision,
    policyRevision: context.policy.revision,
    issuedAtMs: now,
  };
};

// Re-proves a held lease's snapshot wherever it is used: exact closed shape, an unexpired lease
// still on the snapshot's target, and the CURRENT policy, source identity and auth revision.
const currentContinuationSource = (state, lease, now) => {
  const snapshot = lease?.apiContinuationSource;
  if (!closedKeys(snapshot, SOURCE_SNAPSHOT_KEYS) || snapshot.version !== 1) return null;
  if (!Number.isSafeInteger(snapshot.issuedAtMs) || snapshot.issuedAtMs > now) return null;
  if (!Number.isFinite(lease.touchedAt) || now - lease.touchedAt > LEASE_TTL_MS) return null;
  if (snapshot.targetID !== lease.targetID) return null;
  if (!continuationGenerationLease({ sessionID: lease.sessionID, profile: lease.profile, tier: lease.tier })) return null;
  const target = targetForID(snapshot.targetID, allTargets(state));
  if (!target || target.providerID !== snapshot.providerID || target.modelID !== snapshot.modelID) return null;
  const context = continuationSourceContext(state, target);
  if (!context || context.policy.revision !== snapshot.policyRevision || context.sourceAuthRevision !== snapshot.authRevision) return null;
  return { snapshot, target, ...context };
};

// A stored observation, still valid for this source at `now`, or null.
const currentQuotaObservation = (observation, source, now) => {
  if (!closedKeys(observation, QUOTA_OBSERVATION_KEYS) || observation.version !== 1) return null;
  if (!Number.isSafeInteger(observation.observedAtMs) || observation.observedAtMs < source.snapshot.issuedAtMs ||
    observation.observedAtMs > now) return null;
  if (observation.policyRevision !== source.snapshot.policyRevision) return null;
  const subscriptionQuota = normalizeSubscriptionQuota(observation.subscriptionQuota, { now });
  return subscriptionQuota ? { observedAtMs: observation.observedAtMs, policyRevision: observation.policyRevision, subscriptionQuota } : null;
};

const sameSubscriptionQuota = (a, b) => a.version === b.version && a.kind === b.kind &&
  a.window === b.window && a.resetAtMs === b.resetAtMs;

// Whether a stored record is still authority, judged against a FRESH context every time: `auth` is
// the caller's one whole-file snapshot, and the source provider's own entry revision is read here.
const continuationRecordCurrent = (state, record, auth, now) => {
  const sourceTarget = targetForID(record?.sourceTargetID, allTargets(state));
  if (!sourceTarget) return false;
  return continuationAuthorityCurrent({
    record,
    policy: CONFIG.apiContinuation,
    sourceTarget,
    provider: state.inventory?.providers?.[sourceTarget.providerID],
    liveAuthType: auth.types?.[sourceTarget.providerID],
    circuit: state.circuits[providerCircuitID(sourceTarget)],
    liveSourceAuthRevision: providerAuthRevision(sourceTarget.providerID),
    liveAuthRevision: auth.revision,
    inventoryAuthRevision: state.inventory?.authRevision,
    manualApiTargets: CONFIG.manualApiTargets,
    now,
  });
};

// Called by /failure right after it wrote the ordinary quota circuit. The record captures that
// exact circuit and is persisted only if it is current authority as built.
const recordContinuationProof = (state, sessionID, lease, { source, observed }, target) => {
  const circuit = state.circuits[providerCircuitID(target)];
  const now = Date.now();
  // The snapshot carries the source provider's own entry revision; never record without one.
  const sourceAuthRevision = source.snapshot.authRevision;
  if (typeof sourceAuthRevision !== "string" || !sourceAuthRevision || sourceAuthRevision === "absent") return false;
  const record = normalizeApiContinuationRecord({
    sourceLeaseID: lease.leaseID,
    sourceTargetID: source.snapshot.targetID,
    sourceModelID: source.snapshot.modelID,
    sourceProviderID: source.snapshot.providerID,
    sourceAuthRevision,
    observedAtMs: observed.observedAtMs,
    circuitKind: circuit?.kind,
    circuitUpdatedAtMs: circuit?.updatedAt,
    circuitUntilMs: circuit?.until,
    policyRevision: source.snapshot.policyRevision,
    quotaEvidenceClosed: observed.subscriptionQuota,
  }, { now });
  if (!record || !continuationRecordCurrent(state, record, authSnapshot(), now)) return false;
  state.apiContinuations ??= {};
  state.apiContinuations[sessionID] = record;
  return true;
};

// Run by sweep() after the lease, assignment and circuit janitors. A record outlives ordinary
// lease settlement and fresh assignment replacement (the session's pin is retained), and goes
// with the pin's own TTL/cap eviction, or once it can NEVER be authority again
// (continuationRecordPermanentlyInvalid): source entry rewritten or removed, circuit cleared,
// re-kinded, shortened or expired, routing policy drift, source identity drift. A merely
// non-current record -- stale inventory, unreadable auth.json, a circuit that lost its known
// reset -- is kept: every reader re-proves currency, so keeping it grants nothing.
const pruneApiContinuations = (state, now) => {
  const records = state.apiContinuations && typeof state.apiContinuations === "object" && !Array.isArray(state.apiContinuations)
    ? state.apiContinuations : {};
  const sessionIDs = Object.keys(records);
  if (!sessionIDs.length) {
    if (state.apiContinuations && typeof state.apiContinuations === "object" && !Array.isArray(state.apiContinuations)) return false;
    state.apiContinuations = {};
    return true;
  }
  const targets = allTargets(state);
  // One auth.json read per distinct source provider for this sweep. The raw value (null when the
  // file is unreadable, "absent" when the entry is gone) is passed through: only a readable
  // differing revision is permanent.
  const sourceRevisions = new Map();
  const sourceRevision = (providerID) => {
    if (typeof providerID !== "string" || !providerID) return undefined;
    if (!sourceRevisions.has(providerID)) sourceRevisions.set(providerID, providerAuthRevision(providerID));
    return sourceRevisions.get(providerID);
  };
  const kept = {};
  for (const sessionID of sessionIDs) {
    if (!durableOpenCodeSessionID(sessionID) || !(state.assignments[sessionID] || state.leases[sessionID])) continue;
    const record = records[sessionID];
    const sourceTarget = targetForID(record?.sourceTargetID, targets);
    // A source target absent from the current view is UNKNOWN (inventory may republish it), not drift.
    const identityOK = sourceTarget
      ? sourceTarget.providerID === record?.sourceProviderID && sourceTarget.modelID === record?.sourceModelID
      : undefined;
    if (continuationRecordPermanentlyInvalid({
      record,
      circuit: state.circuits[providerCircuitID(record?.sourceProviderID)],
      liveSourceAuthRevision: sourceRevision(record?.sourceProviderID),
      policyRevision: CONFIG.apiContinuation?.revision,
      now,
      identityOK,
    })) continue;
    kept[sessionID] = record;
  }
  // Decoding still drops malformed records and bounds the map at the assignment cap.
  const normalized = { ...normalizeApiContinuationRecords(kept, { now, max: MAX_ASSIGNMENTS }) };
  if (boundedEqual(records, normalized)) return false;
  state.apiContinuations = normalized;
  return true;
};

// ── Paid lease AUTHORITY ─────────────────────────────────────────────────────────────────────────
// A paid lease carries a broker-minted spendGrant (lib/api-continuation.js mintSpendGrant). It is
// routing authority only: the gateway and ledger still own financial admission. Every reader --
// held-lease reuse, the /lease reply and /lease/verify -- goes through currentLeaseAttestation,
// which re-proves the grant against CURRENT config, registration, pin, admission and (for
// continuation) the current exact source proof. Nothing here reads credentials, rates, wallets
// or computes a financial hash: the pin is operator-copied config.

// Exactly the immutable static manual registration: same ID, provider, model, cloud, no source.
const registeredPaidTarget = (target) => {
  const registration = typeof target?.id === "string" && Object.hasOwn(CONFIG.manualApiTargets, target.id)
    ? CONFIG.manualApiTargets[target.id] : null;
  return Boolean(registration) && target.kind === "cloud" && target.source === undefined &&
    target.providerID === registration.providerID && target.modelID === registration.modelID;
};

// Invalid-config fail-closed rule: while a PRESENT apiContinuation block is invalid (lib/config.js API_CONTINUATION_CONFIG_ERROR)
// its pins are unknown, so legacy unpinned manual leasing would be a fail-OPEN. Every target
// registered in CONFIG.manualApiTargets is then unleasable, unverifiable and grantless. Keyed by
// ID alone (not the exact registration match) so a drifted same-ID target is refused as well.
const manualApiTargetConfigBlocked = (targetID) => API_CONTINUATION_CONFIG_ERROR !== null &&
  typeof targetID === "string" && Object.hasOwn(CONFIG.manualApiTargets, targetID);
const API_CONTINUATION_CONFIG_REFUSAL = Object.freeze({
  code: "api-continuation-config-invalid",
  reason: "manual API targets are disabled: the apiContinuation config block is invalid (see the broker log); fix it and restart the broker",
});

// The operator-configured financial pin for one paid target, or null (legacy unpartitioned).
const financialPin = (targetID) => {
  const pins = CONFIG.apiContinuation?.spendPolicyHashes;
  return typeof targetID === "string" && pins && Object.hasOwn(pins, targetID) ? pins[targetID] : null;
};

// The paid context an ACTUAL lease may publish right now:
//   {}                                  an ordinary (unpaid) lease;
//   {requiresSpendBudget, billingClass:"manual-api"}
//                                       a LEGACY unpinned manual lease, exactly as before;
//   {requiresSpendBudget, billingClass, spendGrant}
//                                       a grant that is current authority at `now`;
//   null                                a paid lease whose authority cannot be proven NOW: any
//                                       malformed/expired/rebound grant, a drifted pin, TTL,
//                                       registration, admission or tier, a continuation whose
//                                       exact source proof is gone, or a pinned paid target
//                                       leased without a grant (minted before the pin existed).
// Raw stored state is untrusted: only what normalizes and matches is ever attested. `leaseKey` is
// the state.leases key the lease is stored under; a lease whose own sessionID is missing or names
// another session (corrupted or hand-edited state) attests nothing, so a grant minted for one
// session can never be reused or verified under another session's key.
const currentLeaseAttestation = (state, leaseKey, lease, now = Date.now()) => {
  if (typeof leaseKey !== "string" || typeof lease?.sessionID !== "string" || lease.sessionID !== leaseKey) return null;
  const target = targetForID(lease?.targetID, allTargets(state));
  if (!target) return null;
  if (manualApiTargetConfigBlocked(target.id)) return null;
  if (lease.spendGrant === undefined) {
    const legacy = manualApiAttestation(target);
    if (legacy.requiresSpendBudget === true && financialPin(target.id) !== null) return null;
    return legacy;
  }
  if (!registeredPaidTarget(target) || typeof lease.leaseID !== "string" || !lease.leaseID) return null;
  if (!Number.isFinite(lease.touchedAt) || now - lease.touchedAt > LEASE_TTL_MS) return null;
  let grant;
  try {
    grant = normalizeApiSpendGrant(lease.spendGrant, {
      now, sessionID: lease.sessionID, leaseID: lease.leaseID,
      targetID: target.id, providerID: target.providerID, modelID: target.modelID,
    });
  } catch {
    return null;
  }
  const policy = CONFIG.apiContinuation;
  if (grant.profile !== lease.profile || grant.tier !== lease.tier) return null;
  const pin = financialPin(target.id);
  if (pin === null || grant.policyRevision !== pin) return null;
  if (grant.expiresAtMs - grant.issuedAtMs > policy.grantTTLms) return null;
  if (grant.purpose === "manual") {
    if (grant.source !== null || manualApiAdmission(target, lease.profile, CONFIG.manualApiTargets) !== true) return null;
    return { requiresSpendBudget: true, billingClass: "manual-api", spendGrant: grant };
  }
  // Continuation: the enabled role for this exact target and tier, a durable auto generation
  // lease, and the CURRENT exact source proof the grant was minted from -- the same record, not
  // whatever newer record the session may hold now.
  if (policy.enabled !== true || !Object.hasOwn(policy.targets, target.id) || !policy.targets[target.id].includes(lease.tier)) return null;
  if (!continuationGenerationLease({ sessionID: lease.sessionID, profile: lease.profile, tier: lease.tier })) return null;
  const record = state.apiContinuations?.[lease.sessionID];
  if (!record || !continuationRecordCurrent(state, record, authSnapshot(), now)) return null;
  const source = grant.source;
  if (source.providerID !== record.sourceProviderID || source.targetID !== record.sourceTargetID ||
    source.leaseID !== record.sourceLeaseID || source.modelID !== record.sourceModelID ||
    source.quotaObservedAtMs !== record.observedAtMs || source.quotaUntilMs !== record.circuitUntilMs) return null;
  return { requiresSpendBudget: true, billingClass: "api-continuation", spendGrant: grant };
};

// The LATE paid continuation candidate, consulted only from acquire()'s final refusal branch once
// ordinary selection, stickiness and context pressure have all produced nothing. It never widens
// ordinary admission (cloudTargetAdmitted keeps quarantining manual targets for auto): it is a
// separate strict predicate over the exact policy-listed static registrations, in the policy's
// normalized (sorted target ID) order, honouring every request narrowing and target health fence.
// Returns the first eligible target or null; it mutates nothing.
const lateContinuationTarget = (state, {
  tier, targets, excluded, providerAllowlist, resolvableModels, contextTokens, outageContext, outageEnabled, probationOnly,
}) => {
  const policy = CONFIG.apiContinuation;
  if (policy?.enabled !== true) return null;
  const now = Date.now();
  const every = allTargets(state);
  const active = activeCounts(state, every);
  const providerActive = activeProviderCounts(state, every);
  for (const targetID of Object.keys(policy.targets)) {
    if (!policy.targets[targetID].includes(tier) || financialPin(targetID) === null) continue;
    const target = Object.hasOwn(targets, targetID) ? targets[targetID] : null;
    if (!target || !registeredPaidTarget(target) || target.embedding === true) continue;
    if (policy.sourceProviders.includes(target.providerID)) continue;
    const modelKey = `${target.providerID}/${target.modelID}`;
    if (excluded.has(target.id)) continue;
    if (providerAllowlist && !providerAllowlist.has(target.providerID)) continue;
    if (resolvableModels && !resolvableModels.has(modelKey)) continue;
    // Outage and model-policy gates: a managed/reserve target or any staged/active model-policy
    // role on this identity is not provably safe to override, so it is skipped (fail closed).
    if (outageEnabled && (policyReserveIDs(CONFIG.modelOutages).has(target.id) ||
      (outageContext && !automaticAllowed(target, outageContext)))) continue;
    if (probationOnly.has(modelKey) || modelPolicyRoleForTarget(state, target)) continue;
    if ([state.circuits[target.id], state.circuits[providerCircuitID(target)]].some((circuit) =>
      circuit && (circuit.until === null || Number(circuit.until) > now))) continue;
    if (!contextFits(targetContext(target, state.inventory?.modelContexts), contextTokens,
      targetOutputReserve(target, state.inventory?.modelOutputs))) continue;
    if (targetFull(target, active)) continue;
    if (!providerEligible(state.health, target.providerID, providerActive[target.providerID] ?? 0)) continue;
    return target;
  }
  return null;
};

const sweep = (state, now = Date.now()) => {
  let changed = false;
  // Expired policy avoids go first; then the cap drops the soonest-expiring (oldest) ones.
  if (state.policyAvoids) {
    for (const [sessionID, entry] of Object.entries(state.policyAvoids)) {
      if (!(entry?.until > now)) { delete state.policyAvoids[sessionID]; changed = true; }
    }
    const avoidIDs = Object.keys(state.policyAvoids);
    if (avoidIDs.length > MAX_POLICY_AVOIDS) {
      avoidIDs.sort((a, b) => state.policyAvoids[a].until - state.policyAvoids[b].until)
        .slice(0, avoidIDs.length - MAX_POLICY_AVOIDS)
        .forEach((sessionID) => { delete state.policyAvoids[sessionID]; changed = true; });
    }
  }
  for (const [sessionID, lease] of Object.entries(state.leases)) {
    if (!lease?.touchedAt || now - lease.touchedAt > LEASE_TTL_MS || !isProfile(lease?.profile) || !ROUTE_TIER_NAMES.includes(lease?.tier)) {
      settlePolicyLease(state, lease, { outcome: "abandoned", source: "expiry", now });
      delete state.leases[sessionID];
      stampPinActivity(state, sessionID, Number(lease?.touchedAt) || 0);
      changed = true;
    }
  }
  // A LIVE LEASE IS NEVER EVICTED -- by age here, or by the cap below. `updatedAt` moves only
  // on a fresh SELECTION: held-lease revalidation (`replace: false`) refreshes the LEASE and
  // leaves the assignment's timestamp alone, so a session that revalidates for longer than the
  // TTL is mid-flight with an assignment this loop would otherwise delete out from under it,
  // costing it its pinned model on its next selection. The lease loop above has already dropped
  // the expired leases, so what remains in state.leases is alive right now.
  for (const [sessionID, assignment] of Object.entries(state.assignments)) {
    // Only a caller's explicit SDK-derived subagent identity proves this is disposable. A worker
    // tier describes the requested model lane, and generic primary workers are ordinary session
    // pins; legacy, missing, and invalid identities therefore retain the full TTL.
    const idleTTL = assignment?.tier === "worker" && assignment?.sessionKind === "subagent"
      ? WORKER_ASSIGNMENT_TTL_MS
      : ASSIGNMENT_TTL_MS;
    if (!state.leases[sessionID] && now - assignmentLastActive(assignment) > idleTTL) {
      removePolicyLeaseBinding(state, assignment);
      delete state.assignments[sessionID];
      changed = true;
    }
  }
  // Then the cap. Eviction is TIERED, because "oldest" and "safe to lose" are different
  // questions and ordering by age alone answered the wrong one.
  const assignmentIDs = Object.keys(state.assignments);
  if (assignmentIDs.length > MAX_ASSIGNMENTS) {
    const oldestFirst = (a, b) => assignmentLastActive(state.assignments[a]) - assignmentLastActive(state.assignments[b]);
    // A LIVE LEASE IS NEVER EVICTED. The lease loop above has already dropped the expired
    // ones, so anything still in state.leases is a session that is mid-flight right now, and
    // its assignment is the pin its NEXT lease reads. `updatedAt` moves only on a fresh
    // SELECTION -- /touch and held-lease revalidation refresh the LEASE and leave the
    // assignment's timestamp untouched -- so a busy session's pin looks arbitrarily old, and
    // a pure recency order evicted it while the session was still running. Measured on this
    // host 2026-09-23: one of ten live leases already had no assignment left.
    const retained = assignmentIDs.filter((sessionID) => state.leases[sessionID]);
    const evictable = assignmentIDs.filter((sessionID) => !state.leases[sessionID]);
    // SETTLED ONE-SHOTS GO FIRST, because they are the only entries that are provably
    // unreadable. A one-shot caller (the gateway) mints a new session id per CLIENT REQUEST
    // and never reuses it, so once its lease is gone nothing can ever ask about that id
    // again. A session pin is the opposite: it exists precisely to be read AFTER the lease
    // is released, on the session's next turn -- that is what stickiness is. Ranked by age
    // alone, hundreds of dead gateway ids outranked live pins (450 of 512 on this host), so
    // the cap re-rolled sessions mid-task: the exact failure the stickiness comment in
    // acquire() describes, arriving through the sweep instead of through selection.
    const spent = evictable.filter((sessionID) => isOneShotAssignment(state.assignments[sessionID], sessionID));
    const pins = evictable.filter((sessionID) => !isOneShotAssignment(state.assignments[sessionID], sessionID));
    // Oldest-first inside each tier: spend every settled one-shot before the first pin.
    const order = [...spent.sort(oldestFirst), ...pins.sort(oldestFirst)];
    // slice() clamps on its own: when live leases alone exceed the cap, every evictable
    // entry goes and the map settles at the live-lease count. That is still a bound -- it
    // tracks concurrency, which the 2h lease TTL bounds, rather than total traffic.
    const evicted = order.slice(0, assignmentIDs.length - MAX_ASSIGNMENTS);
    // Counted before the deletes, while the entries are still readable.
    const evictedPins = Math.max(0, evicted.length - spent.length);
    for (const sessionID of evicted) {
      removePolicyLeaseBinding(state, state.assignments[sessionID]);
      delete state.assignments[sessionID];
      changed = true;
    }
    if (evictedPins > 0) {
      // Never silent: losing a pin costs a live session its model mid-task. Reaching here
      // means every settled one-shot was already spent and MAX_ASSIGNMENTS is still below
      // this host's real session concurrency -- an operator decision, not something to
      // absorb quietly. Stays quiet in normal operation, where one-shots absorb the overflow.
      console.error(`[opencode-broker] assignment cap evicted ${evictedPins} session pin(s) after spending all ${spent.length} settled one-shot entr${spent.length === 1 ? "y" : "ies"}; ${retained.length} live lease(s) retained, cap ${MAX_ASSIGNMENTS}`);
    }
  }
  // A rebalance stamp older than the cooldown already fails its own check, so
  // dropping it changes no decision and keeps the map from growing per session.
  if (state.rebalances && typeof state.rebalances === "object") {
    const cooldownMs = Number(CONFIG.sessionRebalance?.cooldownMs ?? 1800000);
    for (const [sessionID, at] of Object.entries(state.rebalances)) {
      if (!Number.isFinite(Number(at)) || now - Number(at) >= cooldownMs) { delete state.rebalances[sessionID]; changed = true; }
    }
  }
  for (const [targetID, circuit] of Object.entries(state.circuits)) {
    if (circuit?.until !== null && Number(circuit?.until) <= now) { delete state.circuits[targetID]; changed = true; }
  }
  const health = normalizeHealth(state.health, now);
  if (!boundedEqual(state.health, health)) { state.health = health; changed = true; }
  if (pruneApiContinuations(state, now)) changed = true;
  if (changed) notePendingPersistence(state, false);
  return changed;
};

const activeProviderCounts = (state, targets = allTargets(state), excludeSessionID = null) => {
  const counts = {};
  for (const [sessionID, lease] of Object.entries(state.leases)) {
    if (sessionID === excludeSessionID) continue;
    const target = targetForID(lease?.targetID, targets);
    if (!target) continue;
    counts[target.providerID] = (counts[target.providerID] ?? 0) + 1;
  }
  return counts;
};

// Per target, plus one model-wide count per local model under modelSlotKey (see targetFull).
// The model-wide count is taken over EVERY target, not just `targets`: a sibling target left
// out of this subset still holds its slot on the same model server.
const activeCounts = (state, targets = allTargets(state), excludeSessionID = null) => {
  const counts = {};
  const every = allTargets(state);
  for (const [sessionID, lease] of Object.entries(state.leases)) {
    if (sessionID === excludeSessionID) continue;
    if (targetForID(lease?.targetID, targets)) counts[lease.targetID] = (counts[lease.targetID] ?? 0) + 1;
    const key = modelSlotKey(targetForID(lease?.targetID, every));
    if (key) counts[key] = (counts[key] ?? 0) + 1;
  }
  return counts;
};

// ☠️ A SCARCE LOCAL TARGET MUST NOT BE SQUATTED BY A SESSION THAT WALKED AWAY. The plugin
// releases on session.idle and heartbeats /touch every HEARTBEAT_MS while a turn is running, so
// a lease is normally short-lived -- but neither happens if the session is abandoned without
// going idle: `/new` navigates away mid-turn, or the opencode process holding the route is quit
// or killed, and no session.idle is ever emitted. The lease then survives to LEASE_TTL_MS.
// At capacity 1 that is not a degradation, it is a total outage of the profile for TWO HOURS:
// uncensored-qwen has one slot, so the next session is refused every single attempt with
// "...deployed, free, or within its context window" -- and it is the `free` clause that is true,
// which is exactly the part nobody reads.
// Reclaim is DEMAND-DRIVEN (only when someone is refused) and only touches leases that have gone
// quiet. A live turn cannot be reclaimed by accident: the plugin touches on session.status=busy
// and then every HEARTBEAT_MS, so the threshold below is more than two missed heartbeats.
const RECLAIM_IDLE_MS = 12 * 60 * 1000;
const reclaimIdleLeases = (state, targets, requestingSessionID, now = Date.now()) => {
  const counts = activeCounts(state, targets);
  const every = allTargets(state);
  const reclaimed = [];
  for (const [targetID, target] of Object.entries(targets)) {
    if (!target || target.kind !== "local" || !targetFull(target, counts)) continue;
    // A target full only MODEL-wide is held up by its siblings' leases, so a quiet
    // sibling lease is squatting this target's slot just as much as its own would be.
    const key = modelSlotKey(target);
    for (const [sessionID, lease] of Object.entries(state.leases)) {
      if (sessionID === requestingSessionID) continue;
      if (lease?.targetID !== targetID && modelSlotKey(targetForID(lease?.targetID, every)) !== key) continue;
      if (now - (lease.touchedAt ?? 0) <= RECLAIM_IDLE_MS) continue;
      delete state.leases[sessionID];
      stampPinActivity(state, sessionID, Number(lease.touchedAt) || 0);
      reclaimed.push(`${sessionID} on ${lease.targetID}`);
    }
  }
  if (reclaimed.length) {
    console.error(`[opencode-broker] reclaimed idle lease(s): ${reclaimed.join(", ")}`);
  }
  return reclaimed.length;
};

const localModels = async () => {
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), 1200);
  try {
    const response = await fetch(LOCAL_MODELS_URL, { signal: controller.signal });
    if (!response.ok) throw new Error(`local model endpoint HTTP ${response.status}`);
    const payload = await response.json();
    const rows = Array.isArray(payload?.data) ? payload.data : [];
    // ☠️ A row's PRESENCE means the id is CONFIGURED, not that the weights are on a GPU.
    // llama.cpp router mode lists every models.ini preset whether or not it is resident, so
    // mapping row.id here made a merely-declared model look routable. That is not academic:
    // two 27b variants that share one 32 GiB GPU cannot both be resident (21,973 + 27,701 MiB
    // of weights against 32,768), so exactly one of the pair is ever loaded. With
    // presence as the test, the unloaded one stayed eligible and the broker leased it -- and
    // with --no-models-autoload the request then fails outright, while WITHOUT that flag the
    // router loads it on top of its cardmate and llama.cpp silently partial-offloads the
    // remainder to a CPU with no AVX2 (measured 0.88 tok/s, HTTP 200 throughout).
    // status.value is "loaded" | "loading" | "unloaded"; only the first can serve a request.
    // "loading" is deliberately NOT eligible -- a swap takes ~20-40 s and a lease taken against
    // a half-loaded instance blocks the session for the remainder of it.
    // ☠️ A MISSING status field means "this server does not report load state", NOT "unloaded".
    // Failing open there is the difference between one degraded target and every local target
    // vanishing at once, which would silently move all local traffic to paid cloud.
    const loaded = (row) => {
      const status = row?.status;
      if (status === undefined || status === null) return true;
      const value = typeof status === "string" ? status : status?.value;
      return typeof value === "string" ? value === "loaded" : true;
    };
    return new Set(rows.filter(loaded).map((row) => row?.id).filter((id) => typeof id === "string"));
  } finally {
    clearTimeout(timeout);
  }
};

// The slot watch (lib/slot-watch.js): once per interval, ask the model server how many
// requests are waiting for a slot on each resident model a local target names. It reads the
// server's own count, so callers the broker never leases for are in it too.
const slotWatch = CONFIG.slotWatch.enabled && LOCAL_MODELS_URL ? createSlotWatch({ config: CONFIG.slotWatch }) : null;
const pollSlots = async () => {
  if (!slotWatch) return;
  let resident;
  try { resident = await localModels(); } catch { return; }
  const watched = new Set(Object.values(TARGETS)
    .filter((target) => target?.kind === "local" && resident.has(target.modelID))
    .map((target) => target.modelID));
  for (const modelID of watched) {
    try {
      const url = new URL("/metrics", LOCAL_MODELS_URL);
      url.searchParams.set("model", modelID);
      const response = await fetch(url, { signal: AbortSignal.timeout(3000) });
      if (!response.ok) continue;
      const { processing, deferred } = parseLlamaMetrics(await response.text());
      for (const alert of slotWatch.record({ modelID, processing, deferred })) notifyBurn(alert);
    } catch { /* a missed poll is a missed sample, never a broker fault */ }
  }
};

// A local target can be non-resident for reasons routing cannot fix -- displaced by a cardmate,
// reclaimed by an idle timer, lost to a restart. Before this, the lease was refused and every
// session on a local-only profile stayed stuck until someone ran the swap by hand. `prepareCommand`
// on the target says how to make it resident; this runs it.
// ☠️ DETACHED AND NOT AWAITED, deliberately. A 27b swap measures 2m40s and /lease is called from
// inside chat.params -- blocking it would hang the turn with no feedback for minutes. The lease is
// still refused, but with a reason that says what is happening and to resend, which is the idiom
// the router already uses for a mid-turn reroute ("route unavailable; resend the prompt").
// ☠️ In-flight is tracked so a session retrying every few seconds spawns ONE swap, not a queue of
// them. The TTL is the release valve: a prepare that dies, or one whose model never becomes
// resident, must not wedge the target permanently -- after it, the next refusal tries again.
const PREPARE_TTL_MS = 900_000;
const preparing = new Map(); // targetID -> startedAt
// ☠️ `yields` decides whether this swap may take the GPUs from a live conversation. A forward
// swap used to evict unconditionally -- a swap-BACK should decline on an in-use model, but
// coming the other way nothing asked -- so an opencode session pressing
// F11 could yank the GPU out from under a gateway client's chat mid-sentence. See
// swapRequesterYields: the gateway's consumers have someone waiting and never yield; an
// opencode session can wait, and does. Passed to the command rather than decided inside it
// because WHO is asking is a fact only the broker holds.
const prepareTarget = (target, { sessionID } = {}) => {
  const started = preparing.get(target.id);
  if (started !== undefined && Date.now() - started < PREPARE_TTL_MS) return "in-flight";
  try {
    const [command, ...args] = target.prepareCommand;
    // ☠️ AN ENVIRONMENT VARIABLE, NOT A FLAG, and the difference is a deploy hazard. This argv
    // comes from the router's own config, so an unrecognised `--yield-to-active` reaching a
    // swap script that predates the flag would exit 2 out of argparse -- and this spawn is
    // detached with stdio ignored, so the swap would simply never happen and the session would
    // sit on "preparing it now" until PREPARE_TTL_MS, with nothing logged anywhere. An unknown
    // env var is ignored by an old build and read by a new one, so the two repos land in
    // either order.
    const env = swapRequesterYields({ sessionID })
      ? { ...process.env, MODEL_SWAP_YIELD_TO_ACTIVE: "1" }
      : process.env;
    spawn(command, args, { detached: true, stdio: "ignore", env }).unref();
    preparing.set(target.id, Date.now());
    console.error(`[opencode-broker] ${target.id}: ${target.modelID} not resident -- running prepareCommand`);
    return "started";
  } catch (error) {
    // Never let a bad prepareCommand take the refusal path down with it: the caller still
    // needs the ordinary "no eligible target" answer, which is true either way.
    console.error(`[opencode-broker] ${target.id}: prepareCommand failed to spawn -- ${error.message}`);
    return null;
  }
};

// The CLOSED set of machine-readable /lease refusal codes. A client has to tell "the
// model is being swapped in, keep waiting" from "there is no target for you, give up",
// and the only thing carrying that distinction was English prose -- so every consumer
// was regexing the message, which makes the wording an unversioned API nobody may fix.
// ☠️ The human `error` string is BYTE-IDENTICAL to what it has always been and must
// stay that way: logs, the HUD's current match and lastDecision.reasons[0] all read it,
// and this addition exists to let them migrate, not to break them first.
// ☆ Closed and small on purpose. A refusal that fits none of these carries NO code
// rather than a fourth one invented at the call site -- an unclassified refusal is
// honest, an over-specific taxonomy is a contract nobody can rely on. The auth-store
// refusal above is the one such path today.
// `usage-limit` is `no-eligible-target` with the cause known: every cloud provider in the lane is
// held out by a plan window or quota stop, and the message names each one and when it returns.
// `api-continuation-config-invalid`: the lane names a registered manual API target that an invalid
// apiContinuation block fails closed; terminal until the operator fixes the config.
// `content-filter-disabled` / `content-filter-exhausted`: a contentFilterCascade /lease with the
// feature off (or its config rejected), or with every cascade candidate spent or unavailable.
// `content-filter-cascade-requires-replace`: a contentFilterCascade /lease without replace:true,
// which held-lease reuse would otherwise answer with the very model that was just blocked.
const REFUSAL_CODES = new Set(["target-preparing", "target-busy", "no-eligible-local-target", "no-eligible-target", "no-resolvable-target", "usage-limit",
  "api-continuation-config-invalid", "content-filter-disabled", "content-filter-exhausted", "content-filter-cascade-requires-replace"]);
// ☠️ `refusalCode`, NOT `code`. This handler's catch sees EVERY error, and node puts
// its own `code` on system errors (ENOENT from a state write, EPIPE from a socket) --
// forwarding that field would publish "ENOENT" as a routing refusal code, outside the
// closed set and meaningless to the client. A field only this file sets cannot collide.
const refusal = (message, code, subject = null) => {
  const error = new Error(message);
  error.refusalCode = code;
  // The target the code REFERS TO, when exactly one does: the model being prepared, or
  // the single target the lane wanted. Omitted otherwise -- a client must not require
  // it, and naming one of several would misattribute the reason.
  if (subject) {
    error.refusalTargetID = subject.id;
    error.refusalModelID = subject.modelID;
  }
  return error;
};

// The outage context a staged probation candidate is judged in: the same snapshot inputs with
// the candidate standing as its scope's head for this offer only (lib/outage-policy.js
// stagedCandidateHeads). Returns the ordinary context unchanged when there is nothing to stage.
const stagedOutageContext = (outageContext, candidate) => {
  if (!outageContext || !candidate) return outageContext;
  const heads = stagedCandidateHeads(outageContext.heads, candidate, outageContext.policy);
  return heads === outageContext.heads ? outageContext : snapshotOutageContext({ ...outageContext, heads });
};

const targetEligibleFor = (target, request, state, availableModels, targets = allTargets(state), excludeSessionID = null, outageContext = null, allowAnyTier = false) => {
  if (!target) return false;
  // ☆ allowAnyTier is for the content-filter cascade ONLY: it descends tiers and may use an
  // outage reserve (both barred by tier membership here), so it skips the membership gate while
  // keeping every real-world check below (admission, context fit, circuit, capacity, health).
  if (!allowAnyTier && !targetEligibleIDsFor(request.profile, request.tier, targets, outageContext).includes(target.id)) return false;
  if (!cloudTargetAdmitted(target, state.inventory?.providers, request.profile)) return false;
  if (target.kind === "local") {
    // The output reserve too, exactly as chooseTarget applies it. Without it this check sized
    // a reserve-declaring target by the headroom FRACTION instead -- 117,964 of a 196,608
    // window where selection admits 147,456 -- so a session between the two was leased the
    // model, then judged ineligible for it on the next turn and moved off it mid-task.
    if (!localContextEligible(targetContext(target, state.inventory?.modelContexts), request.contextTokens,
      targetContextHeadroom(target), targetOutputReserve(target, state.inventory?.modelOutputs))) return false;
  } else if (!contextFits(targetContext(target, state.inventory?.modelContexts), request.contextTokens,
    targetOutputReserve(target, state.inventory?.modelOutputs))) {
    return false;
  }
  const now = Date.now();
  const circuit = state.circuits[target.id];
  const providerCircuit = state.circuits[providerCircuitID(target)];
  if ([circuit, providerCircuit].some((value) =>
    value && (value.until === null || Number(value.until) > now))) return false;
  const active = activeCounts(state, targets, excludeSessionID);
  if (targetFull(target, active)) return false;
  const providerActive = activeProviderCounts(state, targets, excludeSessionID);
  if (!providerEligible(state.health, target.providerID, providerActive[target.providerID] ?? 0)) return false;
  if (target.kind === "local") {
    return availableModels instanceof Set && availableModels.has(target.modelID) &&
      !targetFull(target, active);
  }
  return true;
};

// ☠️ CONTENT-FILTER CASCADE GRANTS — brief, in-memory, per session. A cascade lease is deliberately
// NON-STICKY (it answers one blocked query, then the session bumps back to its routed model), so it
// is stored in the SINGLE-SLOT `state.leases[sessionID]` like any lease. But the session keeps taking
// normal turns on its (blocked) home model between cascade steps, and each such normal /lease
// re-decides and OVERWRITES that slot back to the home model. The cascade candidate's in-flight
// request then reaches /lease/verify after its slot was stomped, so the gateway 400s it "no live
// lease for <candidate>" even though the broker DID just grant it -- the candidate never runs, the
// turn fails, the session falls back to the home model, re-blocks, and the cascade loops without
// advancing (petsafe, 2026-10-22). These grants let /lease/verify honor a request whose WIRE MODEL
// matches a candidate this session was granted within the TTL, independent of the stomped slot. It
// can only ever confirm a model the broker itself just handed this session, so a session id still
// cannot reach a model it was not granted; the grant self-expires, so normal leasing resumes once
// the cascade stops (no fresh grants -> window ages out).
const CASCADE_GRANT_TTL_MS = 30_000;
const CASCADE_GRANT_MAX_PER_SESSION = 16;
const cascadeGrants = new Map(); // sessionID -> [{ providerID, modelID, targetID, kind, leaseID, at }]
const recordCascadeGrant = (sessionID, grant) => {
  if (!sessionID || !grant?.modelID) return;
  const now = grant.at ?? Date.now();
  const kept = (cascadeGrants.get(sessionID) ?? []).filter((g) => now - g.at < CASCADE_GRANT_TTL_MS);
  kept.push(grant);
  cascadeGrants.set(sessionID, kept.slice(-CASCADE_GRANT_MAX_PER_SESSION));
  // Opportunistic sweep so a cascade that ran once and stopped does not pin a session's row forever.
  if (cascadeGrants.size > 256) {
    for (const [sid, list] of cascadeGrants) {
      const live = list.filter((g) => now - g.at < CASCADE_GRANT_TTL_MS);
      if (live.length) cascadeGrants.set(sid, live); else cascadeGrants.delete(sid);
    }
  }
};
const matchCascadeGrant = (sessionID, wireModel) => {
  if (!sessionID || !wireModel) return null;
  const list = cascadeGrants.get(sessionID);
  if (!list) return null;
  const now = Date.now();
  // Newest matching, still within TTL.
  for (let i = list.length - 1; i >= 0; i -= 1) {
    const g = list[i];
    if (now - g.at < CASCADE_GRANT_TTL_MS && g.modelID === wireModel) return g;
  }
  return null;
};

// ☠️ CONTENT-FILTER FLOOR HOLD — per session, in-memory. When a content-filter cascade had to
// descend all the way to a LOCAL floor to get an answer, every cloud tier refused this context,
// and a content filter's verdict clusters: the next turns in the same context refuse too. Re-walking
// the cloud descent each time wastes turns and the provider's weekly quota, and swapping the local
// floor on and off the card (a 27b swap is ~2m40s each way) thrashes the GPU. So reaching a local
// floor arms a HOLD: while it is live the session's ORDINARY turns fast-path straight to that floor
// (acquire short-circuits to it below), which both skips the doomed cloud descent AND keeps the
// floor continuously leased -- hence warm-resident, since the swap-back logic will not evict an
// in-use model. The hold self-expires after FLOOR_HOLD_MS, and the next block then re-runs the full
// descent to re-test whether the context still refuses (a cloud answer simply never re-arms it).
const FLOOR_HOLD_MS = 30 * 60 * 1000;
const floorHold = new Map(); // sessionID -> { targetID, until }
const setFloorHold = (sessionID, targetID) => {
  if (!sessionID || !targetID) return;
  floorHold.set(sessionID, { targetID, until: Date.now() + FLOOR_HOLD_MS });
  if (floorHold.size > 256) {
    const now = Date.now();
    for (const [sid, h] of floorHold) if (h.until <= now) floorHold.delete(sid);
  }
};
const getFloorHold = (sessionID) => {
  const h = sessionID ? floorHold.get(sessionID) : null;
  if (!h) return null;
  if (h.until <= Date.now()) { floorHold.delete(sessionID); return null; }
  return h;
};

const acquire = async (state, request, {
  isAbandoned = () => false,
  caller = null,
  registration = null,
  probeAssignment = null,
} = {}) => {
  const ensureActive = () => {
    if (!isAbandoned()) return;
    const error = new Error("request abandoned");
    error.code = "request-abandoned";
    throw error;
  };
  // Lease attribution stays request-local because an expired handler can resume after its successor.
  const recordLeaseDecision = (decision) => recordDecision(state, {
    ...decision,
    ...(caller && !decision.caller ? { caller } : {}),
    ...(!decision.registration ? { registration } : {}),
  });
  ensureActive();
  const { sessionID, profile, tier = "worker", replace = false } = request;
  if (!validSessionID(sessionID)) throw new Error("invalid session id");
  if (!isProfile(profile)) throw new Error("invalid routing profile");
  if (!ROUTE_TIER_NAMES.includes(tier)) throw new Error("invalid routing tier");
  // A content-filter cascade lease replaces the blocked turn's lease by definition. Without
  // replace:true the held-lease reuse below would revalidate and hand back the held lease -- the
  // very model whose filter just refused -- so it is refused here, before any state is touched.
  if (request.contentFilterCascade === true && replace !== true) {
    throw refusal("contentFilterCascade requires replace:true", "content-filter-cascade-requires-replace");
  }
  // Session identity comes from the router's SDK session.parentID. Never infer subagent status
  // from tier: primary callers legitimately use worker. Once recorded, retain the known identity
  // across gateway verification requests that omit it (or send conflicting traffic).
  const knownSessionKind = normalizeSessionKind(state.leases[sessionID]?.sessionKind) ??
    normalizeSessionKind(state.assignments[sessionID]?.sessionKind);
  const sessionKind = knownSessionKind ?? normalizeSessionKind(request.sessionKind);
  const rawContext = Number(request.contextTokens);
  const contextTokens = Number.isFinite(rawContext) && rawContext >= 0 &&
    (typeof request.contextTokens === "number" || typeof request.contextTokens === "string")
    ? Math.floor(rawContext)
    : null;
  // How long this caller has ALREADY waited for its primary in the current lease loop. A rung
  // carrying a configured delay only becomes selectable once this reaches it.
  // ☠️ Refused, not coerced. A bad value silently read as 0 would hold a delayed rung shut
  // forever, and one silently read as huge would hand over a scarce shared slot immediately --
  // the two failures this whole mechanism exists to prevent, both of them invisible in a log.
  const hasWaitedMs = request.waitedMs !== undefined;
  const waitedMs = hasWaitedMs ? request.waitedMs : 0;
  if (hasWaitedMs && (typeof waitedMs !== "number" || !Number.isFinite(waitedMs) || waitedMs < 0)) {
    throw new Error("waitedMs must be a non-negative finite number");
  }
  const preferredModel = typeof request.preferredModel?.providerID === "string" && request.preferredModel.providerID &&
    typeof request.preferredModel?.id === "string" && request.preferredModel.id
    ? {
      providerID: request.preferredModel.providerID,
      id: request.preferredModel.id,
      ...(typeof request.preferredModel.variant === "string" && /^[A-Za-z0-9._:-]{1,100}$/.test(request.preferredModel.variant)
        ? { variant: request.preferredModel.variant }
        : {}),
    }
    : null;
  const fallbackTargetID = typeof request.fallbackTargetID === "string" && request.fallbackTargetID
    ? request.fallbackTargetID
    : null;
  // A caller that deliberately wants the session re-decided (the plugin's restore-home after
  // a provider displacement) says so; every other lease keeps the session's sticky assignment.
  const releasePin = request.releasePin === true;
  // A caller whose session id is minted per REQUEST and never reused -- the gateway, which
  // builds `gw-<time36>-<rand>` for each client call -- declares it here. It changes nothing
  // about selection or stickiness; it only tells the cap that this assignment is safe to
  // evict first, because after the request settles no one can ever read it back.
  const oneShot = request.oneShot === true;
  // REFUSED, not ignored, when the id does not carry the prefix. Declaring oneShot is asking
  // the cap to spend this entry first, so a caller that sets it on a REAL session id hands the
  // cap a live pin to discard ahead of dead gateway traffic -- the failure the tier order
  // exists to stop. The prefix is also what the sweep reads when the flag is absent (see
  // isOneShotAssignment), so the declaration and the id have to agree or the same entry reads
  // two ways. Failing loudly here puts the error on the buggy caller instead of on whichever
  // session's pin it would have cost.
  if (oneShot && !ONE_SHOT_SESSION_PREFIX.test(sessionID)) {
    throw new Error("oneShot requires a per-request session id (gw- prefix)");
  }
  const hasResolvableModels = request.resolvableModels !== undefined;
  if (hasResolvableModels && (!Array.isArray(request.resolvableModels) || request.resolvableModels.length > 2048 ||
    request.resolvableModels.some((model) => typeof model !== "string" || !/^\S+\/\S+$/.test(model)))) {
    throw new Error("resolvableModels must be an array of at most 2048 non-empty provider/model strings");
  }
  const resolvableModels = hasResolvableModels ? new Set(request.resolvableModels) : null;
  // Per-request exclusions (a caller retrying after a failure on a named target). They are one
  // more upper fence on THIS selection only: refused when malformed rather than ignored, applied
  // to the held, sticky and fresh paths alike, and stored nowhere, so no later lease inherits them.
  const hasExcludeTargetIDs = request.excludeTargetIDs !== undefined;
  if (hasExcludeTargetIDs && (!Array.isArray(request.excludeTargetIDs) || request.excludeTargetIDs.length > 64 ||
    request.excludeTargetIDs.some((id) => typeof id !== "string" || !/^[a-z0-9][a-z0-9._:-]{0,180}$/.test(id)))) {
    throw new Error("excludeTargetIDs must be an array of at most 64 target ids");
  }
  const requestExcludedTargetIDs = hasExcludeTargetIDs ? [...new Set(request.excludeTargetIDs)] : [];
  // A session a provider guard refused or rerouted avoids that model (or provider) for a while
  // (see recordPolicyAvoid). Merged into the same upper fence as a caller's exclusions, so the
  // held, sticky and fresh paths all honour it; relaxed below when it would leave NOTHING to
  // lease, because trying a model that may refuse beats refusing the turn outright.
  const policyAvoidIDs = policyAvoidTargetIDs(state, sessionID, allTargets(state))
    .filter((id) => !requestExcludedTargetIDs.includes(id));
  let excludedTargetIDs = [...requestExcludedTargetIDs, ...policyAvoidIDs];
  let excluded = new Set(excludedTargetIDs);
  const api = request.api === "embeddings" ? "embeddings" : null;
  const requestedTargets = targetEligibleIDsFor(profile, tier, allTargets(state))
    .map((targetID) => targetForID(targetID, allTargets(state))).filter(Boolean);
  if (requestedTargets.some((target) => target.embedding === true) && api !== "embeddings") {
    throw new Error("embedding targets require api: embeddings");
  }
  if (api === "embeddings" && !requestedTargets.some((target) => target.embedding === true)) {
    throw new Error("api: embeddings requires an embedding target");
  }
  request = { ...request, api, contextTokens, preferredModel, fallbackTargetID, releasePin, oneShot, sessionKind };
  sweep(state);
  // The outage gate's working view: every target the reviewed role classification puts in a
  // managed role carries its mark, so a catalog sibling with missing or mismatched family/speed
  // fails closed at every automatic gate below. Nonsecret metadata, a no-op while the policy is off.
  const outageEnabled = outageRoutingEnabled(CONFIG.modelOutages);
  const gateView = (view) => (outageEnabled ? markManagedOutageScope(view, { policy: CONFIG.modelOutages, modelRoles: CONFIG.modelRoles }) : view);
  let targets = gateView(allTargets(state));
  const requestedCloud = targetIDsFor(profile, tier, targets)
    .map((targetID) => targetForID(targetID, targets))
    .some((target) => target?.kind === "cloud");
  // A dedicated reserve profile has no subscription identity to refresh: its
  // credential remains gateway-owned. Any fallback rung makes the profile
  // mixed, even if that rung is local, so it retains the auth.json revision gate.
  const profilePrimaries = CONFIG.profiles[profile] ?? [];
  const profileFallbacks = CONFIG.profileFallbacks[profile] ?? [];
  const dedicatedManualApiProfile = profile !== "auto" && profile !== "manual" && profilePrimaries.length > 0 &&
    profileFallbacks.length === 0 &&
    profilePrimaries.every((targetID) => Object.hasOwn(CONFIG.manualApiTargets, targetID) && CONFIG.manualApiTargets[targetID]?.profiles.includes(profile));
  if (requestedCloud &&
    !dedicatedManualApiProfile &&
    (!state.inventory.authRevision || state.inventory.authRevision !== authRevision())) {
    // Auth rotated (OAuth token refreshes rewrite auth.json routinely). Refusing
    // here starved every caller that lacks the router plugin's republish-retry
    // -- the classifier most painfully. Self-heal instead: recompute admission
    // from the fresh auth types; a revoked provider's discovered targets drop,
    // so a dead credential still cannot ride stale admission.
    const revision = authRevision();
    if (!revision) {
      recordLeaseDecision({
        at: Date.now(), sessionID, profile, tier, targetID: null,
        policy: "refused", reasons: ["no readable auth.json; cloud routing needs credentials"],
        eligibleTargetIDs: [], balancedTargetIDs: [], providerUtilization: {},
      });
      throw new Error("no readable auth.json; cloud routing needs credentials");
    }
    state.inventory = { ...revalidateAdmission(state.inventory, authTypes()), authRevision: revision, updatedAt: Date.now() };
    logDecision({ at: Date.now(), sessionID, policy: "auth-revalidated", reasons: ["auth revision rotated; admission recomputed from fresh auth types"] });
    targets = gateView(allTargets(state));
  }
  // `chooseTarget` is a pure policy helper and cannot see broker inventory. Filter
  // first so fresh leases cannot bypass the provider-auth admission gate.
  // An optional providers allowlist NARROWS admission further (it can never
  // widen it): callers that can only speak to certain providers -- the
  // OpenAI-compatible gateway cannot forward to an OAuth-only provider --
  // lease within their capability instead of receiving unusable targets.
  const providerAllowlist = Array.isArray(request.providers) && request.providers.length
    ? new Set(request.providers.filter((id) => typeof id === "string" && id))
    : null;
  // ☠️ LOCAL-ONLY: the caller states that this request's CONTENT may not leave the LAN,
  // and asks for ordinary selection within that boundary. It narrows exactly like the
  // providers allowlist and can never widen: `auto` still picks the tier normally, it
  // simply cannot pick a target that is not on the LAN, and if nothing local can serve
  // the request the lease is REFUSED. That is the point -- a failed compaction is
  // recoverable, a transcript on a paid API is not.
  // ☆ Kept as a request flag rather than a profile, because the profile is not what is
  // asking. A caller that dispatches work on behalf of a session -- the guard classifying
  // one of its shell commands, say -- routes that work on its own ordinary tier and
  // inherits only this one property from the session it belongs to.
  // ☠️ "keep only local", never "drop cloud" -- same reason as everywhere else.
  const localOnlyRequest = request.localOnly === true;
  // This is the complete cloud-admitted/resolver-visible view. It is deliberately
  // constructed before request-local provider, locality, and API narrowing: those
  // constraints choose from a lane, but must not redefine that lane's canonical head.
  const cloudAdmittedTargets = Object.fromEntries(Object.entries(targets)
    .filter(([, target]) => cloudTargetAdmitted(target, state.inventory?.providers, profile)));
  const completeAdmittedTargets = Object.fromEntries(Object.entries(cloudAdmittedTargets)
    .filter(([, target]) => !resolvableModels || resolvableModels.has(`${target.providerID}/${target.modelID}`)));
  const admittedBeforeResolvableModels = Object.fromEntries(Object.entries(cloudAdmittedTargets)
    .filter(([, target]) => !localOnlyRequest || target.kind === "local")
    .filter(([, target]) => !providerAllowlist || providerAllowlist.has(target.providerID))
    .filter(([, target]) => (target.embedding === true) === (api === "embeddings")));
  // The host snapshot proves what is installed now, not what this OpenCode process loaded at
  // spawn. A caller catalog may only narrow that admission, never add a target the host denied.
  let admittedTargets = Object.fromEntries(Object.entries(admittedBeforeResolvableModels)
    .filter(([, target]) => !resolvableModels || resolvableModels.has(`${target.providerID}/${target.modelID}`))
    // An invalid apiContinuation block takes every registered manual target out of selection
    // (fresh, held and sticky alike); the refusal below then names the static cause.
    .filter(([targetID]) => !manualApiTargetConfigBlocked(targetID)));
  // Build heads before circuit, capacity, context, or policy filtering. An unavailable
  // head must never cause its older sibling to become the ordinary route.
  // ☆ Staged-policy admission is part of "admitted": a probation candidate the model policy
  // has not promoted yet (lib/policy-targets.js probationOnlyModelKeys) is not a head
  // candidate, so a probation-only newer release never displaces the reviewed pin as the
  // scope's ordinary head. An introduced ACTIVE model is admitted and may become head by date.
  const probationOnly = probationOnlyModelKeys(state.modelPolicy);
  const admittedModelKeys = Object.values(completeAdmittedTargets)
    .map((target) => `${target.providerID}/${target.modelID}`)
    .filter((key) => !probationOnly.has(key));
  const resolvableModelKeys = resolvableModels ? [...resolvableModels] : admittedModelKeys;
  const canonicalHeads = outageEnabled ? buildCanonicalHeads({
    policy: CONFIG.modelOutages,
    targets: completeAdmittedTargets,
    admittedModelKeys,
    resolvableModelKeys,
  }) : {};
  // ONE grants snapshot for every reusable gate of this request (expanded lane, held lease,
  // sticky pin, opportunity check). Its lane scope is the complete reviewed lane: substitution
  // is assembled only for primaries this lane actually carries. chooseTarget snapshots again at
  // its own `now` from the same policy/heads/outages inputs.
  const outageContext = outageEnabled ? snapshotOutageContext({
    policy: CONFIG.modelOutages,
    heads: canonicalHeads,
    outages: state.outages ?? null,
    primaryIDs: targetIDsFor(profile, tier, completeAdmittedTargets),
    now: Date.now(),
    circuits: state.circuits,
  }) : null;
  const droppedResolvableLaneModelIDs = resolvableModels
    ? targetEligibleIDsFor(profile, tier, admittedBeforeResolvableModels)
      .map((targetID) => admittedBeforeResolvableModels[targetID])
      .filter((target) => target && !resolvableModels.has(`${target.providerID}/${target.modelID}`))
      .map((target) => `${target.providerID}/${target.modelID}`)
    : [];
  const resolvableModelsReason = droppedResolvableLaneModelIDs.length
    ? `resolvable-models-filter-dropped: ${[...new Set(droppedResolvableLaneModelIDs)].slice(0, 5).join(", ")}`
    : null;
  if (probeAssignment) {
    const exact = Object.fromEntries(Object.entries(admittedTargets).filter(([, target]) =>
      target.providerID === probeAssignment.preferredModel.providerID
      && target.modelID === probeAssignment.preferredModel.modelID));
    if (Object.keys(exact).length !== 1) throw new Error("probe exact target is unavailable or ambiguous");
    admittedTargets = exact;
  }
  // Model policy must see raw lane members before the ordinary outage gate: a probation
  // candidate is not an ordinary head yet, but policy may offer it for a candidate-only trial.
  // Include authorized reserve substitutions too, so role governance cannot be bypassed via
  // the "not in the lane" exemption. Actual selection/reuse still applies the outage gate.
  const laneReserveIDs = outageContext ? authorizedReserveIDs(outageContext).map((grant) => grant.targetID) : [];
  const expandedPolicyIDs = [...new Set([...targetEligibleIDsFor(profile, tier, admittedTargets), ...laneReserveIDs])];
  const policyLaneArgs = {
    targetIDs: expandedPolicyIDs,
    targets: admittedTargets,
    reserveTargetIDs: laneReserveIDs,
    registration,
    activeLeases: Object.entries(state.leases)
      .filter(([activeSessionID]) => activeSessionID !== sessionID)
      .map(([activeSessionID, lease]) => ({ sessionID: activeSessionID, ...lease })),
    tier,
    enabled: CONFIG.reconcile.apply.enabled,
  };
  let policyLane = probeAssignment ? {
    targetIDs: Object.keys(admittedTargets),
    targets: admittedTargets,
    policyTargetID: Object.keys(admittedTargets)[0],
    reason: "probe-exact-target",
    blockedGeneration: false,
  } : resolvePolicyLane({
    modelPolicy: state.modelPolicy,
    ...policyLaneArgs,
  });
  const opportunityRole = !probeAssignment ? Object.values(state.modelPolicy?.roles ?? {}).find((role) =>
    role?.probation?.phase === "probation" && role.routingIntent?.tiers?.includes(tier) &&
    expandedPolicyIDs.some((targetID) => {
      const target = admittedTargets[targetID];
      return target?.providerID === role.providerID && target?.modelID === role.probationModelID;
    })) : null;
  const hadProductionCandidateLease = opportunityRole
    ? Object.values(opportunityRole.probation.leases ?? {}).some((lease) => lease?.synthetic === false)
    : false;
  if (opportunityRole && hadProductionCandidateLease) {
    const candidateKey = `${opportunityRole.providerID}/${opportunityRole.probationModelID}`;
    const opportunityTargetID = policyLane.candidateOpportunityTargetID;
    const opportunityTarget = opportunityTargetID ? policyLane.targets[opportunityTargetID] : null;
    // The staged candidate is judged in its own OFFER context (stagedCandidateHeads): the
    // ordinary heads are untouched, but the staged policy's trial is not vetoed by the gate.
    const opportunityContext = stagedOutageContext(outageContext, opportunityTarget);
    const candidateCapableProductionOpportunity = Boolean(opportunityTarget &&
      opportunityTarget.providerID === opportunityRole.providerID &&
      opportunityTarget.modelID === opportunityRole.probationModelID &&
       targetEligibleFor(opportunityTarget, request, state, undefined, policyLane.targets, sessionID, opportunityContext));
    const eligibleCandidateRequest = candidateCapableProductionOpportunity &&
      policyLane.policyTargetID === opportunityTargetID && policyLane.targetIDs.includes(opportunityTargetID);
    const opportunity = accrueOpportunityTime(state.modelPolicy, {
      roleKey: opportunityRole.roleKey,
      now: Date.now(),
      compatibleActiveRegistration: registration?.compatible === true &&
        Array.isArray(registration.modelKeys) && registration.modelKeys.includes(candidateKey),
      eligibleCandidateRequest,
      candidateCapableProductionOpportunity,
    });
    state.modelPolicy = opportunity.policy;
    if (opportunity.timedOut) {
      policyLane = resolvePolicyLane({ modelPolicy: state.modelPolicy, ...policyLaneArgs });
    }
  }
  if (policyLane.reason) {
    const allowed = new Set(policyLane.targetIDs);
    const expanded = new Set(expandedPolicyIDs);
    admittedTargets = Object.fromEntries(Object.entries(policyLane.targets)
      .filter(([id]) => !expanded.has(id) || allowed.has(id)));
  } else {
    admittedTargets = policyLane.targets;
  }

  const existing = state.leases[sessionID];
  if (existing && !replace) {
    const target = targetForID(existing.targetID, admittedTargets);
    if (isProfile(existing.profile) && ROUTE_TIER_NAMES.includes(existing.tier) &&
      existing.profile === profile && existing.tier === tier) {
      let availableModels;
      if (target?.kind === "local") {
        try { availableModels = await localModels(); } catch { availableModels = null; }
        ensureActive();
      }
      // A held lease on an outgrown window falls through to fresh selection so
      // context pressure can move the session up before the host compacts it.
      const heldDeclared = Number(targetContext(target, state.inventory?.modelContexts ?? {}));
      const heldOutgrown = target?.kind !== "local" && Number(contextTokens) > 0 &&
        Number.isFinite(heldDeclared) && heldDeclared > 0 &&
        Number(contextTokens) > heldDeclared * CONTEXT_PRESSURE;
      // Revalidated against the same policy-vetted, gate-marked view selection uses, never the
      // raw target map: a held reserve is kept exactly while its grant is authorized here and
      // abandoned the moment it is not, and a per-request exclusion beats the held target too.
      // A held RESERVE additionally needs the exact grant it was issued under (generation and
      // credential instance) to still be current: an expired or rotated grant is reselected,
      // never carried forward and never blindly re-activated here.
      const heldReserve = outageEnabled && target && policyReserveIDs(CONFIG.modelOutages).has(target.id);
      const heldAssertionCurrent = !heldReserve || Boolean(currentReserveGrant({
        policy: CONFIG.modelOutages, outages: state.outages, targetID: target.id, assertion: existing.outage, now: Date.now(),
      }));
      // A held PAID lease: a continuation lease is never reused -- every reacquisition goes back
      // through full ordinary selection, so an ordinary route that reopened always wins and a new
      // grant is minted only after exhaustion is re-proven. A held manual or legacy lease is kept
      // only while its own paid context is still current (grant, pin, TTL, admission).
      const heldPaidCurrent = existing.spendGrant !== undefined && existing.spendGrant?.purpose !== "manual"
        ? false
        : currentLeaseAttestation(state, sessionID, existing) !== null;
      if (target && !heldOutgrown && !excluded.has(target.id) && heldAssertionCurrent && heldPaidCurrent &&
        targetEligibleFor(target, { profile: existing.profile, tier: existing.tier, contextTokens }, state, availableModels, admittedTargets, sessionID, outageContext)) {
        ensureActive();
        state.leases[sessionID].touchedAt = Date.now();
        if (sessionKind) {
          state.leases[sessionID].sessionKind = sessionKind;
          if (state.assignments[sessionID]) state.assignments[sessionID].sessionKind = sessionKind;
        }
        recordLeaseDecision({
          at: Date.now(),
          sessionID,
          targetID: target.id,
          profile,
          tier,
          policy: "held-lease-revalidation",
          reasons: ["revalidated-held-lease", ...(policyLane.reason ? [policyLane.reason] : []),
            ...(policyLane.blockedGeneration ? ["blocked-generation"] : []),
            ...(resolvableModelsReason ? [resolvableModelsReason] : [])],
          ...(policyLane.blockedGeneration ? { blockedGeneration: true } : {}),
          eligibleTargetIDs: [target.id],
          balancedTargetIDs: [target.id],
          providerUtilization: { [target.providerID]: effectiveUtilization(state.budgets, target.providerID) },
        });
        return { target, existing: true, leaseID: existing.leaseID, outage: heldReserve ? existing.outage : null };
      }
    }
    ensureActive();
    settlePolicyLease(state, existing, { outcome: "abandoned", source: "lease" });
    delete state.leases[sessionID];
    notePendingPersistence(state, false);
  }
  if (existing && replace) {
    ensureActive();
    settlePolicyLease(state, existing, { outcome: "abandoned", source: "lease" });
    delete state.leases[sessionID];
    notePendingPersistence(state, false);
  }
  const selection = {
    profile,
    tier,
    circuits: state.circuits,
    health: state.health,
    cursors: state.cursors,
    targets: admittedTargets,
    contextTokens,
    modelContexts: state.inventory?.modelContexts ?? {},
    modelOutputs: state.inventory?.modelOutputs ?? {},
    budgets: state.budgets ?? {},
    outagePolicy: CONFIG.modelOutages,
    outages: state.outages ?? null,
    canonicalHeads,
    excludedTargetIDs,
    // Carried on `selection` so the context-pressure retry below inherits it through `...selection`.
    // Passing it only to the ordinary call would make a delayed rung unreachable for exactly the
    // oversized sessions that most need the roomier target.
    waitedMs,
  };
  // ☠️ A local-only request needs the resident-model set NO MATTER what the primary lane
  // holds. Residency is only fetched when the lane itself names a local target, and an
  // `auto` tier whose local target sits in a FALLBACK rung (build's last rung is exactly
  // that) would otherwise be judged with localModels undefined -- where every local
  // target is ineligible by definition, so a local-only lease could never succeed there.
  // ☠️ Rungs count, which is why this reads targetEligibleIDsFor and not targetIDsFor. A profile
  // whose only local target sits in a FALLBACK rung -- a cloud primary with a local rung behind
  // it, the shape a per-rung delay invites -- would otherwise be judged with localModels
  // undefined, where every local target is ineligible by definition. The rung would then be
  // unreachable no matter how long the caller waited, and the refusal would read as
  // "no eligible target" rather than naming the rung.
  const includesLocal = localOnlyRequest || targetEligibleIDsFor(profile, tier, admittedTargets, outageContext)
    .map((targetID) => targetForID(targetID, admittedTargets))
    .some((target) => target?.kind === "local");
  let availableModels;
  // Set only when the residency probe itself failed or timed out. Ordinary selection still reads
  // that as "nothing resident" (the empty set below), but the late paid branch must not: an
  // UNKNOWN residency is not proof the local route is gone, while a probe that answered [] is.
  let localResidencyUnknown = false;
  if (includesLocal) {
    try { availableModels = await localModels(); } catch { availableModels = new Set(); localResidencyUnknown = true; }
    ensureActive();
    // A prepare is finished the moment its model reports resident, and the in-flight mark has to
    // go THEN, not when its TTL expires. Otherwise a model that lands and is evicted again inside
    // the TTL -- a cardmate swapping back, another session leaving the profile -- reads as "still
    // preparing" with nothing actually running, and stays stuck for the remainder of it.
    for (const targetID of [...preparing.keys()]) {
      const prepared = targetForID(targetID, targets);
      if (prepared && availableModels.has(prepared.modelID)) preparing.delete(targetID);
    }
  }
  // Free any slot whose holder has gone quiet BEFORE deciding, so a full scarce target is
  // reconsidered in the same call rather than refusing and hoping the next attempt is luckier.
  ensureActive();
  reclaimIdleLeases(state, admittedTargets, sessionID);
  // ── Content-filter floor hold (fast-path) ──────────────────────────────────────────────────
  // A session whose context a provider content filter is refusing was just served from a local
  // floor (the cascade arms the hold below). While it is held, send ORDINARY turns straight to that
  // floor instead of re-deciding to the cloud home model that will only refuse again -- skipping the
  // whole cloud descent (saving the weekly quota) and keeping the floor leased, hence warm-resident
  // (no re-swap thrash). A content-filter cascade request falls through to the branch below; a
  // one-shot gateway session is never held. The hold self-expires; the next block then re-descends.
  if (request.contentFilterCascade !== true && !oneShot) {
    const hold = getFloorHold(sessionID);
    if (hold) {
      const floor = admittedTargets[hold.targetID] ?? targetForID(hold.targetID, allTargets(state));
      if (floor && floor.kind === "local") {
        if (availableModels === undefined) {
          try { availableModels = await localModels(); } catch { availableModels = new Set(); }
          ensureActive();
        }
        if (!availableModels.has(floor.modelID)) {
          // The held floor was swapped off the card; bring it back and wait, same idiom as the cascade.
          const prep = floor.prepareCommand ? prepareTarget(floor, { sessionID }) : null;
          if (prep) throw refusal(`${floor.modelID} is not resident; ${prep === "in-flight" ? "still preparing it" : "preparing it now"} -- resend the prompt in a moment`, "target-preparing", floor);
          // No prepareCommand / spawn failed: fall through to normal routing rather than wedge.
        } else if (targetEligibleFor(floor, { profile, tier, contextTokens }, state, availableModels, admittedTargets, sessionID, null, true)) {
          const leaseID = randomUUID();
          const leasedAt = Date.now();
          ensureActive();
          state.leases[sessionID] = { targetID: floor.id, leaseID, sessionID, touchedAt: leasedAt, profile, tier };
          // fallback:true -- degraded route, never pinned; the hold (not a pin) is what keeps it.
          state.assignments[sessionID] = { targetID: floor.id, leaseID, sessionID, profile, tier, updatedAt: leasedAt, fallback: true };
          setFloorHold(sessionID, floor.id); // continued use refreshes the hold window
          recordLeaseDecision({
            at: leasedAt, sessionID, targetID: floor.id, profile, tier, contextTokens,
            policy: "content-filter-floor-hold", reasons: [`content-filter-floor-hold:${floor.id}`],
            eligibleTargetIDs: [floor.id], balancedTargetIDs: [floor.id],
            providerUtilization: { [floor.providerID]: effectiveUtilization(state.budgets, floor.providerID) },
          });
          recordCascadeGrant(sessionID, { providerID: floor.providerID, modelID: floor.modelID, targetID: floor.id, kind: "local", leaseID, at: leasedAt });
          return { target: floor, existing: false, leaseID, outage: null };
        }
        // Held floor resident but not eligible right now (context too big, circuit, full): fall
        // through to normal routing -- the hold stays armed and a later turn can use it again.
      }
    }
  }
  // ── Content-filter cascade lease ─────────────────────────────────────────────────────────
  // A per-request, NON-STICKY failover a provider content filter triggers (lib/content-filter-
  // cascade.js computes the order: older generations of the blocked model, then the other
  // provider at this tier, then down the tiers, then an uncensored local floor). Unlike every
  // other lease it deliberately descends tiers and may use an outage reserve WITHOUT a grant --
  // a content filter is a healthy model refusing one query, not an outage, and the same account
  // serves the older model on its ordinary credential. So it bypasses only the tier-membership
  // gate (allowAnyTier) while keeping admission, context, circuit, capacity and health checks;
  // it opens no circuit, records no stickiness and never pins. The routed model returns on the
  // very next request. The gateway settles a blocked attempt with /release (never /failure), so
  // nothing here leaves a mark once the request ends.
  if (request.contentFilterCascade === true) {
    if (!isCascadeEnabled(CONFIG)) throw refusal("content-filter cascade is disabled", "content-filter-disabled");
    const blockedModel = request.blockedModel
      && typeof request.blockedModel.providerID === "string" && request.blockedModel.providerID
      && typeof request.blockedModel.id === "string" && request.blockedModel.id
      ? { providerID: request.blockedModel.providerID, modelID: request.blockedModel.id }
      : null;
    const order = contentFilterCascadeOrder({
      config: CONFIG,
      tier,
      blockedModel,
      apiEligibleProviders: providerAllowlist ? [...providerAllowlist] : null,
      excludeTargetIDs: excludedTargetIDs,
    });
    // Cascade candidates may be local even when the request's own tier is cloud, so the resident
    // set has to be known here regardless of includesLocal above.
    if (availableModels === undefined && order.some((candidate) => candidate.kind === "local")) {
      try { availableModels = await localModels(); } catch { availableModels = new Set(); }
      ensureActive();
    }
    const cascadeRequest = { profile, tier, contextTokens };
    let picked = null;
    for (const candidate of order) {
      const target = admittedTargets[candidate.targetID];
      if (!target || excluded.has(target.id)) continue;
      // NEVER PAID. A cascade lease is minted with no spendGrant and no financial pin, so a
      // manual API target reached here -- through a reserve mapping, the floor, or a manual
      // profile's own admission -- would be paid capacity leased outside every spend boundary.
      if (Object.hasOwn(CONFIG.manualApiTargets, target.id) || registeredPaidTarget(target)) continue;
      if (targetEligibleFor(target, cascadeRequest, state, availableModels ?? new Set(), admittedTargets, sessionID, null, true)) {
        picked = target;
        break;
      }
    }
    if (!picked) {
      // The last resort may just not be RESIDENT yet: a local cascade candidate (the uncensored
      // floor, or a local tier above it) needs a GPU swap. Trigger it and ask the caller to wait --
      // do NOT give up as "exhausted", which would strand a universally-refused query with nowhere
      // to go. Reuses the normal-path prepare + target-preparing idiom; the router's lease wait-loop
      // holds until it lands, and the retry then leases it.
      const absentLocal = order
        .map((candidate) => admittedTargets[candidate.targetID])
        .find((target) => target && !excluded.has(target.id) && target.kind === "local"
          && target.prepareCommand && !(availableModels ?? new Set()).has(target.modelID));
      if (absentLocal) {
        const prep = prepareTarget(absentLocal, { sessionID });
        if (prep) throw refusal(`${absentLocal.modelID} is not resident; ${prep === "in-flight" ? "still preparing it" : "preparing it now"} -- resend the prompt in a moment`, "target-preparing", absentLocal);
      }
      throw refusal("every content-filter cascade candidate is unavailable", "content-filter-exhausted");
    }
    const leaseID = randomUUID();
    const leasedAt = Date.now();
    ensureActive();
    // sessionKind exactly as the ordinary path writes it, so a cascading subagent keeps its TTL.
    state.leases[sessionID] = {
      targetID: picked.id, leaseID, sessionID, touchedAt: leasedAt, profile, tier,
      ...(sessionKind ? { sessionKind } : {}),
    };
    state.assignments[sessionID] = {
      targetID: picked.id, leaseID, sessionID, profile, tier,
      ...(sessionKind ? { sessionKind } : {}),
      updatedAt: leasedAt,
      // ☠️ NEVER A STICKY PIN. A cascade lease answers one blocked query; the session must return
      // to its routed model on the very next turn ("bump back ASAP"). A gw- one-shot (the gateway
      // path) is reclaimed by prefix; a real session (the opencode router's failover path) would
      // otherwise PIN this fallback and keep answering on it. `fallback: true` makes it a degraded
      // route that yields to the lane's primary the moment one is eligible -- recorded, never pinned.
      fallback: true,
      ...(oneShot ? { oneShot: true } : {}),
    };
    recordLeaseDecision({
      at: leasedAt, sessionID, targetID: picked.id, profile, tier, contextTokens,
      policy: "content-filter-cascade",
      reasons: [`content-filter-cascade:${picked.id}`,
        ...(blockedModel ? [`blocked:${blockedModel.providerID}/${blockedModel.modelID}`] : [])],
      eligibleTargetIDs: order.map((candidate) => candidate.targetID),
      balancedTargetIDs: [picked.id],
      providerUtilization: { [picked.providerID]: effectiveUtilization(state.budgets, picked.providerID) },
    });
    // Remember this grant so /lease/verify can confirm the candidate's in-flight request even if a
    // normal re-lease stomps the session's single lease slot back to the home model (see the
    // cascadeGrants note). Keyed by the WIRE model id the candidate request will carry.
    recordCascadeGrant(sessionID, {
      providerID: picked.providerID, modelID: picked.modelID, targetID: picked.id,
      kind: picked.kind ?? "cloud", leaseID, at: leasedAt,
    });
    // Reaching a LOCAL floor means every cloud tier refused this context. Arm the floor hold so the
    // session's ordinary turns fast-path to this warm floor (above) instead of re-descending the
    // cloud tiers that will only refuse again -- until the hold expires and the next block re-tests.
    if (picked.kind === "local") setFloorHold(sessionID, picked.id);
    return { target: picked, existing: false, leaseID, outage: null };
  }
  let selectedCandidateChoice = null;
  let candidateSelection = null;
  if (policyLane.policyTargetID) {
    const candidateTargets = Object.fromEntries(Object.entries(admittedTargets)
      .filter(([id]) => !expandedPolicyIDs.includes(id) || id === policyLane.policyTargetID));
    // The candidate-only offer is the existing staged-policy path: for THIS call the staged
    // candidate stands as its scope's head (stagedCandidateHeads), so the outage gate does not
    // veto a reviewed trial. `selection.canonicalHeads` -- the ordinary call below -- is unchanged.
    const offeredSelection = {
      ...selection,
      canonicalHeads: outageEnabled
        ? stagedCandidateHeads(canonicalHeads, candidateTargets[policyLane.policyTargetID], CONFIG.modelOutages)
        : canonicalHeads,
      targets: candidateTargets,
    };
    const candidateChoice = chooseTarget({
      ...offeredSelection,
      active: activeCounts(state, candidateTargets),
      localModels: availableModels,
    });
    if (candidateChoice?.target?.id === policyLane.policyTargetID) {
      admittedTargets = candidateTargets;
      selectedCandidateChoice = candidateChoice;
      candidateSelection = offeredSelection;
    } else {
      admittedTargets = Object.fromEntries(Object.entries(admittedTargets)
        .filter(([id]) => id !== policyLane.policyTargetID));
    }
    selection.targets = admittedTargets;
  }
  // Do not discard a successful staged choice and reselect it under the incumbent's head.
  // Only this selection (and its pressure retry) uses the offered heads; reuse/stickiness do not.
  let ordinaryChoice = selectedCandidateChoice ?? chooseTarget({
    ...selection,
    active: activeCounts(state, admittedTargets),
    localModels: availableModels,
  });
  if (!ordinaryChoice?.target && policyAvoidIDs.length) {
    excludedTargetIDs = requestExcludedTargetIDs;
    excluded = new Set(excludedTargetIDs);
    selection.excludedTargetIDs = excludedTargetIDs;
    ordinaryChoice = chooseTarget({
      ...selection,
      active: activeCounts(state, admittedTargets),
      localModels: availableModels,
    });
    if (ordinaryChoice?.decision) {
      ordinaryChoice.decision.reasons = [...(ordinaryChoice.decision.reasons ?? []), "policy-avoid-relaxed"];
    }
  }
  let choice = ordinaryChoice;
  // Context pressure: the host compacts a session once it approaches the
  // current model's usable window (context minus the output reserve, ~60-70%).
  // A session that big belongs on a roomier model BEFORE compression eats its
  // history -- a 133k session compacting on a 200k model while 1M models sit
  // in the same tier is a routing failure, not a context problem. Try a
  // selection restricted to models the host would not imminently compact on;
  // if none exists (session bigger than everything), normal selection stands.
  const modelContextsMap = state.inventory?.modelContexts ?? {};
  const pressureFloor = Number(contextTokens) > 0 ? Number(contextTokens) / CONTEXT_PRESSURE : 0;
  let pressureApplied = false;
  if (pressureFloor > 0) {
    const roomy = Object.fromEntries(Object.entries(admittedTargets).filter(([, target]) => {
      if (target.kind === "local") return true;
      const declared = Number(targetContext(target, modelContextsMap));
      return !Number.isFinite(declared) || declared <= 0 || declared >= pressureFloor;
    }));
    if (Object.keys(roomy).length < Object.keys(admittedTargets).length && Object.keys(roomy).length > 0) {
      const roomyChoice = chooseTarget({
        ...(candidateSelection ?? selection),
        targets: roomy,
        active: activeCounts(state, roomy),
        localModels: availableModels,
      });
      if (roomyChoice?.target) {
        roomyChoice.decision.reasons = [...(roomyChoice.decision.reasons ?? []), "context-pressure-prefers-roomier-window"];
        choice = roomyChoice;
        pressureApplied = true;
      }
    }
  }
  // ☠️ A SESSION KEEPS ITS MODEL. The pin is the session's last assignment, which /forget
  // no longer deletes, so it survives the lease being released at every idle. Without it,
  // stickiness depended on the plugin naming a preferred model, which it never does for a
  // subagent's turns. The local share was then re-rolled on EVERY lease, and a scout's
  // session flipped between qwen-flash and the 9B turn by turn: 146 mid-session model
  // changes in three days, each one a different model continuing a transcript it did not
  // write, and re-reading all of it. A session moves only when its model cannot serve it:
  // circuit open, quota, not resident, outgrown, or explicitly released (restore-home).
  // A new TIER is a new decision (a bump or an escalation), so the pin only binds within
  // the tier and profile it was made in.
  // A session idle past PIN_COLD_REBALANCE_MS has lost its provider prompt cache, so the next
  // turn re-reads the whole history at full price on ANY model: moving it now costs nothing a
  // stay would not. That is the second free balancing moment after a session's first model.
  // Without it a session pinned while one subscription's 5-hour window ran hot stayed there for
  // the rest of its life (2026-10-20: three panes held on gpt-6.1-sol at ~half Opus speed after
  // the Anthropic window that sent them there had reset). Activity is the pin's own (as each
  // lease ends) or the replaced lease's last touch, whichever is later.
  const assignment = state.assignments?.[sessionID];
  const lastActive = Math.max(assignmentLastActive(assignment), Number(existing?.touchedAt) || 0);
  const coldPin = Boolean(assignment) && Date.now() - lastActive > PIN_COLD_REBALANCE_MS;
  const pin = !request.releasePin && !coldPin && assignment?.fallback !== true
    ? assignment
    : null;
  const pinnedTarget = pin && pin.profile === profile && pin.tier === tier
    ? admittedTargets[pin.targetID] ?? null
    : null;
  // A cold session's preferred model only binds when it is NOT just its pin repeated: the plugin
  // names the session's current model on every seasoned turn, so that is stickiness too. A model
  // the user switched to differs from the pin and is still honoured.
  const coldRepeat = coldPin && preferredModel && admittedTargets[assignment?.targetID] &&
    admittedTargets[assignment.targetID].providerID === preferredModel.providerID &&
    admittedTargets[assignment.targetID].modelID === preferredModel.id;
  // A per-request exclusion outranks stickiness: the caller said this target failed it.
  const preferredTarget = [(preferredModel && !coldRepeat
    ? Object.values(admittedTargets).find((target) =>
      target.providerID === preferredModel.providerID && target.modelID === preferredModel.id)
    : null) ?? pinnedTarget].find((target) => target && !excluded.has(target.id)) ?? null;
  if (coldPin && choice?.decision) {
    choice.decision.reasons = [...(choice.decision.reasons ?? []), "cold-cache-releases-stickiness"];
  }
  // Stickiness never holds a session on a model it has outgrown: when pressure
  // moved the selection to a roomier window, the sticky model only wins if it
  // is itself roomy enough.
  // ...and only when the move actually buys a bigger window. Opus 5 and Opus 4.8 both have
  // 1M, so a 600k+ session was being shuffled between two models with the SAME window: a
  // model change and a full re-read, for nothing (35 such moves in three days).
  const preferredOutgrown = pressureApplied && preferredTarget && (() => {
    const declared = Number(targetContext(preferredTarget, modelContextsMap));
    const offered = Number(targetContext(choice?.target, modelContextsMap));
    return Number.isFinite(declared) && declared > 0 && declared < pressureFloor &&
      (!Number.isFinite(offered) || offered <= 0 || offered > declared);
  })();
  // A transient circuit strands sessions on an older family member: opus-5
  // down for five minutes -> the session leases opus-4.8 -> stickiness then
  // holds 4.8 for days after opus-5 returns. Stickiness never outranks a
  // NEWER sibling of the same family that is eligible again.
  const newerFamilySibling = preferredTarget?.family && preferredTarget?.releaseDate &&
    Object.values(admittedTargets).some((candidate) =>
      candidate.id !== preferredTarget.id &&
      candidate.providerID === preferredTarget.providerID &&
      candidate.family === preferredTarget.family &&
      (candidate.speed ?? "standard") === (preferredTarget.speed ?? "standard") &&
      String(candidate.releaseDate ?? "") > String(preferredTarget.releaseDate) &&
       targetEligibleFor(candidate, request, state, availableModels, admittedTargets, sessionID, outageContext));
  if (newerFamilySibling && choice?.decision) {
    choice.decision.reasons = [...(choice.decision.reasons ?? []), "family-upgrade-releases-stickiness"];
  }
  // ☠️ NO LIVE REBALANCING. A cross-provider "correction" used to move a live session when
  // one subscription ran 15% hotter than another. That hands a long session to a different
  // model mid-task: a model that did not write the history and re-reads all of it at full
  // price. Balancing happens where it costs nothing -- when a session gets its FIRST model.
  if (preferredTarget && !preferredOutgrown && !newerFamilySibling && targetEligibleFor(
    preferredTarget,
    request,
    state,
    availableModels,
    admittedTargets,
    sessionID,
    outageContext,
  )) {
    choice = {
      target: preferredTarget,
      cursorKey: null,
      nextCursor: null,
      decision: {
        policy: "session-stickiness",
        reasons: ["preferred-session-model-remains-eligible"],
        eligibleTargetIDs: [preferredTarget.id],
        balancedTargetIDs: [preferredTarget.id],
        providerUtilization: {
          [preferredTarget.providerID]: effectiveUtilization(state.budgets, preferredTarget.providerID),
        },
      },
    };
  } else if (preferredTarget && !preferredOutgrown && outageContext && Object.hasOwn(CONFIG.modelOutages.mappings ?? {}, preferredTarget.id)) {
    // A session pinned to a head that is down by its OWN circuit stays in the family: the head's
    // newest eligible stand-in (claude-opus-5-5 -> claude-opus-5 -> claude-opus-4-8), not whichever
    // head the pool balances to, because a provider switch hands the history to a different model
    // that re-reads all of it. The newer-sibling rule above brings it home when the circuit closes.
    const standIn = circuitStandIns(snapshotOutageContext({ ...outageContext, primaryIDs: [preferredTarget.id], now: Date.now(), circuits: state.circuits }))
      .map((entry) => admittedTargets[entry.targetID])
      .find((target) => target && !excluded.has(target.id) &&
        targetEligibleFor(target, request, state, availableModels, admittedTargets, sessionID, outageContext));
    if (standIn && choice?.target?.id !== standIn.id) {
      choice = {
        target: standIn,
        cursorKey: null,
        nextCursor: null,
        decision: {
          policy: "circuit-reserve",
          reasons: [`circuit-reserve-for-${preferredTarget.id}`, "pinned-session-stays-in-family"],
          eligibleTargetIDs: [standIn.id],
          balancedTargetIDs: [standIn.id],
          providerUtilization: { [standIn.providerID]: effectiveUtilization(state.budgets, standIn.providerID) },
          source: "circuit-reserve",
        },
      };
    }
  }
  const fallbackTarget = fallbackTargetID && !excluded.has(fallbackTargetID) && ordinaryChoice?.decision?.policy === "strict-fallback" &&
    ordinaryChoice.decision.eligibleTargetIDs?.includes(fallbackTargetID)
    ? admittedTargets[fallbackTargetID]
    : null;
  const fallbackOutgrown = pressureApplied && fallbackTarget && (() => {
    const declared = Number(targetContext(fallbackTarget, modelContextsMap));
    return Number.isFinite(declared) && declared > 0 && declared < pressureFloor;
  })();
  if (fallbackTarget && !fallbackOutgrown) {
    choice = {
      target: fallbackTarget,
      cursorKey: null,
      nextCursor: null,
      decision: {
        ...ordinaryChoice.decision,
        reasons: [...(ordinaryChoice.decision.reasons ?? []), "fallback-stickiness"],
      },
    };
  }
  if (choice && policyLane.reason) {
    choice.decision = {
      ...choice.decision,
      reasons: [...(choice.decision?.reasons ?? []), policyLane.reason,
        ...(policyLane.blockedGeneration ? ["blocked-generation"] : [])],
      ...(policyLane.blockedGeneration ? { blockedGeneration: true } : {}),
    };
  }
  if (!choice) {
    const wanted = targetIDsFor(profile, tier, admittedTargets)
      .map((id) => targetForID(id, admittedTargets)).filter(Boolean);
    // A local-only REQUEST is refused for the local reason even when the lane it rode is
    // mixed: "no eligible local model ..." is the true sentence there, and it is one of
    // the two wordings that already exist rather than a third.
    const localOnly = localOnlyRequest || (wanted.length && wanted.every((target) => target.kind === "local"));
    // ☠️ Only a target that is genuinely NOT RESIDENT is preparable. A target that is loaded but
    // busy, or that the request does not fit, is refused for a reason no swap can change -- and
    // running one there would evict a working model to "fix" a capacity or context problem.
    const absent = wanted.filter((target) =>
      target.kind === "local" && target.prepareCommand && !availableModels.has(target.modelID));
    const prepared = absent.length ? prepareTarget(absent[0], { sessionID }) : null;
    // ☠️ FULL IS NOT GONE. A local model that is resident, fits the request and has no open
    // circuit, and is refused ONLY because every slot is taken, frees a slot within one job.
    // Refusing there dropped the work: 992 requests in three days, most of them background
    // ingestion from a gateway client arriving while the cloud lane was rate-limited and the
    // local model's slots were busy.
    // So it WAITS -- the same transient answer as a model being swapped in, which every
    // client already retries. Fallback rungs count (the lane's local step lives there). A
    // local model that is not loaded at all is not a wait: that is the refusal below.
    const nowMs = Date.now();
    const activeNow = activeCounts(state, admittedTargets, sessionID);
    const busy = prepared || !(availableModels instanceof Set) ? [] : targetEligibleIDsFor(profile, tier, admittedTargets)
      .map((targetID) => admittedTargets[targetID])
      .filter((target) => target?.kind === "local" && availableModels.has(target.modelID) &&
        localContextEligible(targetContext(target, state.inventory?.modelContexts), contextTokens,
          targetContextHeadroom(target), targetOutputReserve(target, state.inventory?.modelOutputs)) &&
        ![state.circuits[target.id], state.circuits[providerCircuitID(target)]].some((value) =>
          value && (value.until === null || Number(value.until) > nowMs)) &&
        targetFull(target, activeNow));
    const formatBusyTargets = (targets) => {
      const countsByModelID = new Map();
      for (const target of targets) {
        countsByModelID.set(target.modelID, (countsByModelID.get(target.modelID) ?? 0) + 1);
      }
      const parts = [...countsByModelID].map(([modelID, count]) =>
        count === 1 ? modelID : `${count} ${modelID} lanes`);
      const models = parts.length === 1 ? parts[0]
        : parts.length === 2 ? parts.join(" and ")
          : `${parts.slice(0, -1).join(", ")} and ${parts.at(-1)}`;
      return `${models} ${targets.length === 1 ? "is" : "are"} busy (every slot in use); waiting for a free slot -- resend the prompt in a moment`;
    };
    const noResolvableTarget = droppedResolvableLaneModelIDs.length > 0 &&
      !targetEligibleIDsFor(profile, tier, admittedTargets)
        .some((targetID) => targetForID(targetID, admittedTargets));
    // ☠️ SAY "USAGE LIMIT" WHEN THAT IS WHY. With every cloud provider in the lane held out by a
    // plan window or quota stop, the refusal used to read "all lightweight routing targets are
    // busy or unavailable" -- 44 times in one log -- and the user had to go and find out that
    // their plans were spent and until when. Named per provider, with the day each returns.
    const laneCloudProviders = [...new Set(targetEligibleIDsFor(profile, tier, allTargets(state))
      .map((targetID) => targetForID(targetID, allTargets(state)))
      .filter((target) => target && target.kind !== "local")
      .map((target) => target.providerID))];
    // ☆ ONLY WHEN USAGE IS THE WHOLE STORY. If any cloud provider in the lane is out for another
    // reason (busy at its concurrency cap, quarantined), waiting for the plan dates is the wrong
    // advice -- that one may be back in seconds -- so the refusal keeps its generic wording.
    const laneUsageLimits = localOnly ? [] : activeUsageLimits(state.circuits, laneCloudProviders, cachedPlanUsage, nowMs);
    const usageLimits = laneCloudProviders.length > 0 && laneUsageLimits.length === laneCloudProviders.length
      ? laneUsageLimits : [];
    const usageLimitReason = () => `${usageLimitMessage(usageLimits, nowMs)}. ` +
      `No other provider in ${tier} can take it` +
      (Number(contextTokens) > 0
        ? `, and no local model fits this session (${Math.round(Number(contextTokens) / 1000)}k tokens).`
        : ", and no local model can serve it.");
    // Invalid-config fail-closed: this lane names a registered manual API target that the invalid apiContinuation block
    // took out of selection above. Static code and reason; nothing from the config is echoed.
    const manualConfigBlocked = API_CONTINUATION_CONFIG_ERROR !== null &&
      targetEligibleIDsFor(profile, tier, targets).some((targetID) => manualApiTargetConfigBlocked(targetID));
    const reason = prepared
      ? `${absent[0].modelID} is not resident; ${prepared === "in-flight" ? "still preparing it" : "preparing it now"} -- resend the prompt in a moment`
      : busy.length
        ? formatBusyTargets(busy)
        : manualConfigBlocked
          ? API_CONTINUATION_CONFIG_REFUSAL.reason
        : noResolvableTarget
          ? `the calling OpenCode process cannot resolve any eligible model and must be restarted to load current provider config; dropped models: ${[...new Set(droppedResolvableLaneModelIDs)].slice(0, 5).join(", ")}`
        : localOnly
          ? "no eligible local model is currently deployed, free, or within its context window"
          : usageLimits.length
            ? usageLimitReason()
            : "all lightweight routing targets are busy or unavailable";
    // ☆ Both prepare wordings share ONE code. "preparing it now" and "still preparing
    // it" differ only in what a human reading a log wants to know (did this call start
    // the swap, or was it already running); to a client both mean the same thing --
    // retry shortly, this WILL clear -- and splitting them would push the caller back
    // into matching prose to recombine them.
    const code = prepared
      ? "target-preparing"
      : busy.length ? "target-busy"
        : manualConfigBlocked ? API_CONTINUATION_CONFIG_REFUSAL.code
        : noResolvableTarget ? "no-resolvable-target"
        : localOnly ? "no-eligible-local-target"
        : usageLimits.length ? "usage-limit" : "no-eligible-target";
    const subject = prepared ? absent[0] : busy.length === 1 ? busy[0] : wanted.length === 1 ? wanted[0] : null;
    // LATE PAID CONTINUATION: the ONLY place a paid continuation target can be
    // chosen, and only after everything above produced nothing. Every gate fails closed:
    //   - only a terminal usage-limit / no-eligible-target code: preparing, busy, unresolvable
    //     and local-only answers are never overridden;
    //   - only an enabled policy, a durable native auto generation lease (no one-shot, probe,
    //     embeddings, classifier, private/manual/named profile) and NO staged model-policy
    //     candidate or blocked generation, which this branch cannot prove exhausted;
    //   - only with the session's CURRENT exact source-quota proof -- generic unavailability,
    //     caller flags, purpose fields or a paid target's own failures never qualify;
    //   - only if no ordinary route could still open: the same selection re-run purely with
    //     every delayed rung opened (waitedMs) and, separately, with every slot free, so a delayed
    //     rung or a capacity wait always beats paid. These projections change nothing: no clock,
    //     circuit, cursor, prepare or probe.
    // A grant that cannot be minted leaves the original refusal standing.
    let continuation = null;
    const continuationRecord = state.apiContinuations?.[sessionID];
    // The request-side gates are the pure lib predicate (table-tested there); residency the probe
    // could not establish is never proof of exhaustion (a successful probe answering [] is, and is
    // judged by the projection below like any other non-residency). Record CURRENCY needs live
    // broker state and is judged here, only after every request gate passed.
    if (lateContinuationRequestEligible({
      refusalCode: code,
      policy: CONFIG.apiContinuation,
      probe: Boolean(probeAssignment),
      localOnly: localOnlyRequest,
      api,
      sessionID,
      profile,
      tier,
      oneShot,
      policyTargetID: policyLane.policyTargetID,
      blockedGeneration: policyLane.blockedGeneration,
      includesLocal,
      localResidencyUnknown,
      tierNames: ROUTE_TIER_NAMES,
    }) &&
      continuationRecord && continuationRecordCurrent(state, continuationRecord, authSnapshot(), Date.now())) {
      // The projection asks "could an ordinary route open WITHOUT a real usage stop?", so it is
      // relaxed toward ordinary, never toward paid: only usage-stop circuits block in it (an auth
      // fence, a rate/overload/connect fence or any other short circuit clears on its own); provider
      // health quarantine is ignored for the same reason; and neither the caller's excludeTargetIDs
      // nor policy avoids apply -- a route the CALLER fenced off is not exhaustion. Those exclusions
      // still bind the paid target itself in lateContinuationTarget below.
      // A provider held by a real usage stop is exhausted for ordinary routing: the kinds are
      // exactly those lib/usage-limit.js activeUsageLimits treats as usage stops (plan-window and
      // quota), so a plan-window stop on another ordinary provider is exhaustion here too.
      const usageStopCircuits = Object.fromEntries(Object.entries(state.circuits ?? {})
        .filter(([, circuit]) => USAGE_STOP_CIRCUIT_KINDS.includes(circuit?.kind)));
      const ordinaryCouldOpen = [activeCounts(state, admittedTargets), {}].some((active) => Boolean(chooseTarget({
        ...selection,
        targets: admittedTargets,
        circuits: usageStopCircuits,
        health: {},
        excludedTargetIDs: [],
        active,
        localModels: availableModels,
        waitedMs: Number.MAX_SAFE_INTEGER,
      })?.target));
      const paidTarget = ordinaryCouldOpen ? null : lateContinuationTarget(state, {
        tier,
        targets,
        excluded: new Set([...requestExcludedTargetIDs, ...policyAvoidIDs]),
        providerAllowlist,
        resolvableModels,
        contextTokens,
        outageContext,
        outageEnabled,
        probationOnly,
      });
      if (paidTarget) {
        const paidLeaseID = randomUUID();
        let spendGrant = null;
        try {
          spendGrant = mintSpendGrant({
            purpose: "continuation",
            sessionID,
            leaseID: paidLeaseID,
            target: paidTarget,
            profile,
            tier,
            policy: CONFIG.apiContinuation,
            manualApiTargets: CONFIG.manualApiTargets,
            ttlMs: CONFIG.apiContinuation.grantTTLms,
            now: Date.now(),
            record: continuationRecord,
          });
        } catch {
          spendGrant = null;
        }
        if (spendGrant) {
          continuation = {
            target: paidTarget,
            cursorKey: null,
            nextCursor: null,
            paidLeaseID,
            spendGrant,
            continuation: true,
            decision: {
              policy: "api-continuation",
              reasons: [`api-continuation-after-${code}`, reason],
              eligibleTargetIDs: [paidTarget.id],
              balancedTargetIDs: [paidTarget.id],
              providerUtilization: {},
            },
          };
        }
      }
    }
    if (!continuation) {
      // ☠️ A preparing target is NOT a refusal, and filing it as one makes the decision log
      // lie about the router. A refusal is terminal -- nothing is eligible, and the caller
      // must change something. `target-preparing` is transient and self-healing: a local
      // model is loading and the same prompt will route on the retry. Sharing one policy
      // meant `uncensored` read as a 43% failure rate (650 of 1500 decisions) when the
      // router was doing its job and waiting out a GPU swap. The HTTP reply and the code
      // are unchanged -- a client still has to resend -- only the classification differs.
      const policy = prepared || busy.length ? "waiting" : "refused";
      recordLeaseDecision({
        at: Date.now(), sessionID, profile, tier, targetID: null,
        // ☆ The same code on the DECISION, so /selection and decisions.jsonl are
        // machine-readable too -- that log is where refusals get read after the fact, and
        // until now that reading was done by eye. `targetID` stays null: on a decision it
        // means the target that was LEASED, and neither a refusal nor a wait leased anything.
        policy, code, reasons: [reason, ...(resolvableModelsReason ? [resolvableModelsReason] : [])],
        contextTokens,
        eligibleTargetIDs: [], balancedTargetIDs: [], providerUtilization: {},
      });
      throw refusal(reason, code, subject);
    }
    choice = continuation;
  }

  // Everything that can still THROW for this selection -- the abandonment check, the reserve grant
  // re-check and the manual grant mint below -- runs before the first state write (the round-robin
  // cursor), so a refused selection leaves cursors, leases and assignments exactly as they were.
  ensureActive();
  // Invalid-config backstop: selection already excludes these; a blocked manual target is never leased.
  if (manualApiTargetConfigBlocked(choice.target?.id)) {
    throw refusal(API_CONTINUATION_CONFIG_REFUSAL.reason, API_CONTINUATION_CONFIG_REFUSAL.code, choice.target);
  }
  // An ACTUAL reserve grant: the chosen target is a policy reserve, so it must match one of this
  // request's authorized grants. That grant's credential instance and generation ride on the
  // lease (the proxy enforces them), and only here -- never on a preview, inventory, selection
  // snapshot or probe -- does the reserve's proof become active. A reserve with no matching
  // grant (the grant lapsed between snapshot and choice) is refused rather than leased unbound.
  let outageGrant = null;
  let leasedAt = null;
  // A circuit stand-in (a reserve covering a head fenced by its own circuit) is an ORDINARY lease:
  // no grant, no outage assertion. It must still be a current stand-in at lease time.
  const standInLease = outageEnabled && policyReserveIDs(CONFIG.modelOutages).has(choice.target.id) && outageContext
    && circuitStandIns(snapshotOutageContext({ ...outageContext, now: Date.now(), circuits: state.circuits }))
      .some((standIn) => standIn.targetID === choice.target.id)
    && !(outageContext ? authorizedReserveIDs(outageContext) : []).some((grant) => grant.targetID === choice.target.id);
  if (outageEnabled && !standInLease && policyReserveIDs(CONFIG.modelOutages).has(choice.target.id)) {
    const selectedGrant = (outageContext ? authorizedReserveIDs(outageContext) : [])
      .find((grant) => grant.targetID === choice.target.id) ?? null;
    leasedAt = Date.now();
    const currentContext = snapshotOutageContext({
      policy: CONFIG.modelOutages,
      heads: canonicalHeads,
      outages: state.outages ?? null,
      primaryIDs: targetIDsFor(profile, tier, completeAdmittedTargets),
      now: leasedAt,
    });
    outageGrant = authorizedReserveIDs(currentContext).find((grant) => grant.targetID === choice.target.id
      && ['logicalID', 'primaryID', 'credentialInstance', 'generation', 'episodeID']
        .every((key) => grant[key] === selectedGrant?.[key])) ?? null;
    if (!outageGrant) throw new Error("outage reserve selected without a current grant");
  }
  const outageAssertion = outageGrant ? outageLeaseAssertion(outageGrant) : null;
  leasedAt ??= Date.now();
  // A late continuation choice already minted its grant against the lease ID it will carry.
  const leaseID = choice.paidLeaseID ?? randomUUID();
  // An explicitly selected manual paid target with a configured financial pin carries a manual
  // grant, minted only here from the actual manual admission (never from caller fields). It needs
  // no enabled continuation. If it cannot be minted the request fails here, BEFORE the cursor
  // write below and before any lease, assignment or model-policy change for this selection;
  // a missing pin keeps the legacy unpartitioned manual lease exactly as before (no grant).
  let spendGrant = choice.continuation === true ? choice.spendGrant : null;
  if (!spendGrant && registeredPaidTarget(choice.target) && financialPin(choice.target.id) !== null) {
    spendGrant = mintSpendGrant({
      purpose: "manual",
      sessionID,
      leaseID,
      target: choice.target,
      profile,
      tier,
      policy: CONFIG.apiContinuation,
      manualApiTargets: CONFIG.manualApiTargets,
      ttlMs: CONFIG.apiContinuation.grantTTLms,
      now: leasedAt,
    });
  }
  // First state write for this selection: nothing above it can leave a half-applied lease.
  ensureActive();
  if (choice.cursorKey) state.cursors[choice.cursorKey] = choice.nextCursor;
  if (resolvableModelsReason && choice.decision) {
    choice.decision.reasons = [...(choice.decision.reasons ?? []), resolvableModelsReason];
  }
  const candidateRole = modelPolicyRoleForTarget(state, choice.target);
  let policyLease = {};
  if (candidateRole) {
    const recorded = recordCandidateLease(state.modelPolicy, {
      roleKey: candidateRole.roleKey,
      leaseID,
      sessionID,
      targetID: choice.target.id,
      now: leasedAt,
      synthetic: Boolean(probeAssignment) || sessionID.startsWith("gw-probe-"),
    });
    state.modelPolicy = recorded.policy;
    policyLease = { modelPolicyRoleKey: candidateRole.roleKey };
    if (opportunityRole?.roleKey === candidateRole.roleKey && !hadProductionCandidateLease && !recorded.event.synthetic) {
      const opportunity = accrueOpportunityTime(state.modelPolicy, {
        roleKey: candidateRole.roleKey,
        now: leasedAt,
        compatibleActiveRegistration: true,
        eligibleCandidateRequest: true,
        candidateCapableProductionOpportunity: true,
      });
      state.modelPolicy = opportunity.policy;
    }
  }
  // Only a NEW lease can become a continuation source, judged on the actual choice and one auth
  // snapshot taken now. Private to the lease: never on the assignment, never in the reply.
  const continuationSource = issueContinuationSource(state, { sessionID, profile, tier, oneShot, api }, choice.target, leasedAt);
  state.leases[sessionID] = {
    targetID: choice.target.id,
    leaseID,
    sessionID,
    touchedAt: leasedAt,
    profile,
    tier,
    ...(sessionKind ? { sessionKind } : {}),
    ...policyLease,
    ...(outageAssertion ? { outage: outageAssertion } : {}),
    ...(continuationSource ? { apiContinuationSource: continuationSource } : {}),
    // Routing authority only, re-proven by currentLeaseAttestation wherever it is read.
    ...(spendGrant ? { spendGrant } : {}),
  };
  // An ordinary grant tolerates an in-flight request after a re-decision stomps the single lease
  // slot. Financial and outage-bound leases instead require their specialized verification: their
  // cached identity alone omits spend attestation or reserve credential/generation authority.
  if (!spendGrant && !outageAssertion && !registeredPaidTarget(choice.target)) {
    recordCascadeGrant(sessionID, {
      providerID: choice.target.providerID, modelID: choice.target.modelID, targetID: choice.target.id,
      kind: choice.target.kind ?? "cloud", leaseID, at: leasedAt,
    });
  }
  ensureActive();
  state.assignments[sessionID] = {
    targetID: choice.target.id,
    leaseID,
    sessionID,
    profile,
    tier,
    ...(sessionKind ? { sessionKind } : {}),
    updatedAt: leasedAt,
    ...policyLease,
    ...(outageAssertion ? { outage: outageAssertion } : {}),
    // A fallback rung is a degraded route, never a home: it must yield to the lane's
    // primary the moment one is eligible (fallback-stickiness above owns that), so it
    // is recorded but never pinned.
    // A paid continuation is never a home either: it must never become a normal pin.
    ...(choice.decision?.policy === "strict-fallback" || choice.continuation === true ? { fallback: true } : {}),
    // Recorded, never acted on during selection -- see the sweep's tiered eviction.
    ...(oneShot ? { oneShot: true } : {}),
    // The assignment keeps the lease ID (it binds later /failure and /usage replays), but a
    // grant-bearing lease's ID is never published: publicAssignments drops it by this mark, so
    // it stays hidden after the lease itself has ended. A later lease rebuilds the assignment.
    ...(spendGrant ? { grantLease: true } : {}),
  };
  recordLeaseDecision({
    at: Date.now(),
    sessionID,
    targetID: choice.target.id,
    profile,
    tier,
    contextTokens,
    ...choice.decision,
  });
  // Activated only now, once the lease and assignment exist: persisted with them by the /lease
  // handler's write. The reducer re-validates the grant at the grant's own time.
  if (outageGrant) {
    state.outages = reduceOutages(state.outages, {
      type: "activate",
      logicalID: outageGrant.logicalID,
      targetID: outageGrant.targetID,
      credentialInstance: outageGrant.credentialInstance,
    }, { policy: CONFIG.modelOutages, now: leasedAt });
  }
  return { target: choice.target, existing: false, leaseID, outage: outageAssertion };
};

// ☠️ `close` IS NOT OPTIONAL. A request whose client hung up before this ran never emits `end`
// or `error` -- its socket is destroyed, the body is unreadable, and a promise listening for
// only those two sits pending forever (measured on node 24: still pending after 5 s). The
// serial chain's deadline then charges that dead request the full 30 s. See `abandoned` below.
const parseBody = (request) => new Promise((resolve, reject) => {
  let text = "";
  let ended = false;
  if (request.destroyed) return reject(new Error("client disconnected"));
  request.setEncoding("utf8");
  request.on("data", (chunk) => {
    text += chunk;
    if (text.length > 64 * 1024) request.destroy(new Error("request too large"));
  });
  request.on("end", () => {
    ended = true;
    try { resolve(text ? JSON.parse(text) : {}); } catch { reject(new Error("invalid JSON")); }
  });
  request.on("error", reject);
  request.on("close", () => { if (!ended) reject(new Error("client disconnected")); });
});

const reply = (response, code, value) => {
  response.writeHead(code, { "content-type": "application/json" });
  response.end(JSON.stringify(value) + "\n");
};

const socketResponds = (socketPath) => new Promise((resolve) => {
  const request = httpRequest({ socketPath, path: "/status", method: "POST", timeout: 300 }, (response) => {
    response.resume();
    response.once("end", () => resolve(true));
  });
  request.once("timeout", () => request.destroy());
  request.once("error", () => resolve(false));
  request.end("{}");
});

const serve = async () => {
  ensureRoutingStateDir();
  // Enabled outage reserves need every runtime dependency BEFORE the socket exists: a missing
  // or unsafe key, credential or gateway URL is a loud startup failure, never a silent
  // fallback. Disabled reads none of them and starts no outage timer, worker or fetch.
  const outageRuntime = CONFIG.modelOutages?.enabled === true
    ? loadOutageRuntime({ stateDir: STATE_ROOT })
    : null;
  const socketPath = brokerSocketPath();
  try {
    const stat = lstatSync(socketPath);
    if (!stat.isSocket()) throw new Error(`refusing to remove non-socket broker path: ${socketPath}`);
    if (await socketResponds(socketPath)) throw new Error(`broker is already listening on ${socketPath}`);
    unlinkSync(socketPath);
  } catch (error) {
    if (error?.code !== "ENOENT") throw error;
  }

  let state = readState();
  sweep(state);
  writeState(state);
  const resolverProcesses = createResolverProcessRegistry({
    loadRegistry: () => {
      const manager = createResolverGenerationManager({
        root: CONFIG.reconcile.apply.generationsRoot,
        currentLinkPath: CONFIG.reconcile.apply.currentLinkPath,
      });
      const registry = manager.readRegistry();
      return {
        version: registry.version,
        highWater: registry.highWater,
        generations: Object.fromEntries(Object.keys(registry.generations).map((generation) => {
          const bundle = manager.generation(Number(generation));
          return [generation, {
            manifestHash: bundle.manifestHash,
            modelKeys: bundle.manifest.modelKeys,
          }];
        })),
      };
    },
    loadBaseModelKeys: () => [...new Set(Object.values(TARGETS)
      .map((target) => `${target.providerID}/${target.modelID}`))].sort(),
  });
  const probeState = createProbeBrokerState();
  setInterval(() => probeState.reap(), 1_000).unref();
  const probeReply = (response, error) => reply(response, error?.status ?? 409, {
    error: String(error?.message ?? error),
    code: typeof error?.code === "string" ? error.code : "invalid-probe-request",
  });
  const requireProbeFields = (body, expected, code, label) => {
    const fields = body && typeof body === "object" && !Array.isArray(body)
      ? Object.keys(body).sort()
      : [];
    if (fields.join("\0") === [...expected].sort().join("\0")) return;
    const error = new Error(`${label} must contain exactly ${expected.join(", ")}`);
    error.code = code;
    throw error;
  };
  // `preparsed` is set only for /probe/consume and /probe/release when an outage service exists:
  // their body is read OUTSIDE the queue to see whether it is an outage-health assignment, and a
  // consumed request stream cannot be parsed twice.
  const handle = async (request, response, preparsed = undefined, run = { expired: false }) => {
    try {
      if (request.url === "/model-policy/status") {
        if (!isLoopbackControlAddress(request.socket?.remoteAddress)) {
          return reply(response, 403, { error: "loopback control endpoint required", code: "loopback-control-required" });
        }
        if (request.method !== "GET") return reply(response, 405, { error: "GET required" });
        return reply(response, 200, { modelPolicy: state.modelPolicy, apply: CONFIG.reconcile.apply });
      }
      if (request.url === "/model-policy/cas") {
        if (!isLoopbackControlAddress(request.socket?.remoteAddress)) {
          return reply(response, 403, { error: "loopback control endpoint required", code: "loopback-control-required" });
        }
        if (request.method !== "POST") return reply(response, 405, { error: "POST required" });
        if (!CONFIG.reconcile.apply.enabled) {
          return reply(response, 409, { error: "reconciliation apply is disabled", code: "reconcile-apply-disabled" });
        }
        const body = await parseBody(request);
        if (run.expired) return;
        const result = compareAndSwapModelPolicy(state.modelPolicy, body);
        if (result.changed) {
          state.modelPolicy = normalizeModelPolicy(result.policy, {
            modelRoles: CONFIG.modelRoles,
            staticTargets: TARGETS,
          });
          writeState(state);
        }
        return reply(response, 200, { ok: true, ack: result.ack, changed: result.changed });
      }
      if (request.url === "/model-policy/probe-launch") {
        if (!isLoopbackControlAddress(request.socket?.remoteAddress)) {
          return reply(response, 403, { error: "loopback control endpoint required", code: "loopback-control-required" });
        }
        if (request.method !== "POST") return reply(response, 405, { error: "POST required" });
        if (!CONFIG.reconcile.apply.enabled) {
          return reply(response, 409, { error: "reconciliation apply is disabled", code: "reconcile-apply-disabled" });
        }
        if ((lstatSync(socketPath).mode & 0o777) !== 0o600) {
          return reply(response, 409, { error: "probe control socket must have exact mode 0600", code: "probe-control-socket-insecure" });
        }
        const body = await parseBody(request);
        if (run.expired) return;
        try {
          return reply(response, 200, probeState.issueLaunch(body, { modelPolicy: state.modelPolicy }));
        } catch (error) {
          return probeReply(response, error);
        }
      }
      if (request.url === "/resolver-process/register") {
        if (!isLoopbackControlAddress(request.socket?.remoteAddress)) {
          return reply(response, 403, { error: "loopback control endpoint required", code: "loopback-control-required" });
        }
        if (request.method !== "POST") return reply(response, 405, { error: "POST required" });
        if (!CONFIG.reconcile.apply.enabled) {
          return reply(response, 409, { error: "reconciliation apply is disabled", code: "reconcile-apply-disabled" });
        }
        const body = await parseBody(request);
        if (run.expired) return;
        if (Object.hasOwn(body, "probeLaunchNonce")) {
          try {
            const fields = Object.keys(body).sort();
            if (fields.join("\0") !== ["generation", "manifestHash", "probeLaunchNonce"].sort().join("\0")) {
              const error = new Error("fresh probe registration must contain exactly generation, manifestHash, and probeLaunchNonce");
              error.code = "invalid-probe-registration";
              throw error;
            }
            if (!Number.isInteger(body.generation) || typeof body.manifestHash !== "string") {
              const error = new Error("probe generation identity is invalid");
              error.code = "invalid-probe-generation";
              throw error;
            }
            const manager = createResolverGenerationManager({
              root: CONFIG.reconcile.apply.generationsRoot,
              currentLinkPath: CONFIG.reconcile.apply.currentLinkPath,
            });
            const bundle = manager.generation(body.generation);
            return reply(response, 200, probeState.redeemLaunch({
              generation: body.generation,
              manifestHash: body.manifestHash,
              modelKeys: bundle.manifest.modelKeys,
              probeLaunchNonce: body.probeLaunchNonce,
            }));
          } catch (error) {
            return probeReply(response, error);
          }
        }
        return reply(response, 200, resolverProcesses.register(body));
      }
      if (request.url === "/model-policy/probe") {
        if (!isLoopbackControlAddress(request.socket?.remoteAddress)) {
          return reply(response, 403, { error: "loopback control endpoint required", code: "loopback-control-required" });
        }
        if (request.method !== "POST") return reply(response, 405, { error: "POST required" });
        if (!CONFIG.reconcile.apply.enabled) {
          return reply(response, 409, { error: "reconciliation apply is disabled", code: "reconcile-apply-disabled" });
        }
        const body = await parseBody(request);
        if (run.expired) return;
        const header = request.headers["x-opencode-resolver-token"];
        const resolverToken = Array.isArray(header) ? header[0] : header;
        try {
          return reply(response, 200, probeState.issueAssignment({
            resolverToken,
            request: body,
            modelPolicy: state.modelPolicy,
          }));
        } catch (error) {
          return probeReply(response, error);
        }
      }
      if (request.url === "/probe/consume") {
        if (!isLoopbackControlAddress(request.socket?.remoteAddress)) {
          return reply(response, 403, { error: "loopback control endpoint required", code: "loopback-control-required" });
        }
        if (request.method !== "POST") return reply(response, 405, { error: "POST required" });
        if (!CONFIG.reconcile.apply.enabled) {
          return reply(response, 409, { error: "reconciliation apply is disabled", code: "reconcile-apply-disabled" });
        }
        const body = preparsed ?? await parseBody(request);
        if (run.expired) return;
        try {
          requireProbeFields(body, ["sessionID", "probeNonce"], "invalid-probe-consume", "probe consume request");
          return reply(response, 200, probeState.consumeAssignment(body));
        } catch (error) {
          return probeReply(response, error);
        }
      }
      if (request.url === "/probe/release") {
        if (!isLoopbackControlAddress(request.socket?.remoteAddress)) {
          return reply(response, 403, { error: "loopback control endpoint required", code: "loopback-control-required" });
        }
        if (request.method !== "POST") return reply(response, 405, { error: "POST required" });
        if (!CONFIG.reconcile.apply.enabled) {
          return reply(response, 409, { error: "reconciliation apply is disabled", code: "reconcile-apply-disabled" });
        }
        const body = preparsed ?? await parseBody(request);
        if (run.expired) return;
        const header = request.headers["x-opencode-resolver-token"];
        const resolverToken = Array.isArray(header) ? header[0] : header;
        try {
          requireProbeFields(body, ["sessionID", "probeNonce"], "invalid-probe-release", "probe release request");
          return reply(response, 200, probeState.releaseAssignment({
            sessionID: body.sessionID,
            probeNonce: body.probeNonce,
            resolverToken,
            owner: resolverToken ? "helper" : "gateway",
          }));
        } catch (error) {
          return probeReply(response, error);
        }
      }
      if (request.method !== "POST") return reply(response, 405, { error: "POST required" });
      const body = preparsed ?? await parseBody(request);
      if (run.expired) return;
      const probeAssignment = request.url === "/lease" && typeof body.sessionID === "string"
        ? probeState.assignmentForLease(body.sessionID)
        : null;
      const registration = probeAssignment ? {
        generation: probeAssignment.generation,
        manifestHash: probeAssignment.manifestHash,
        modelKeys: probeAssignment.modelKeys,
        compatible: true,
        reason: null,
      } : resolverProcesses.authorize({ resolverToken: body.resolverToken });
      sweep(state);
      // A cloud lease waited for its report before it joined the queue. Applying it is
      // synchronous, so local admissions and releases never wait behind remote I/O.
      if (request.url !== "/quota-evidence" && !run.expired) refreshPlanUsage(state);
      // The burn watch's all-sessions plan-rise signal was removed (see lib/burn-watch.js
      // for the fourteen-day numbers that retired it). The plan refresh still runs for the
      // budgets, HUD, and admission gate below -- only the burn-watch feed is gone.
      if (request.url === "/lease") {
        const caller = sanitizeCaller(body.caller);
        const lease = await acquire(state, body, {
          isAbandoned: () => run.expired || abandoned(request, response),
          caller,
          registration,
          probeAssignment,
        });
        if (run.expired) return;
        // The reply's paid context comes ONLY from the actual lease just granted or revalidated.
        // A paid lease that cannot attest itself is never handed out.
        const grantedLease = state.leases[body.sessionID];
        const attestation = grantedLease?.leaseID === lease.leaseID ? currentLeaseAttestation(state, body.sessionID, grantedLease) : null;
        if (attestation === null) {
          if (grantedLease?.leaseID === lease.leaseID) delete state.leases[body.sessionID];
          writeState(state);
          throw new Error("lease authority could not be attested");
        }
        writeState(state);
        // The decision rides along so clients can SURFACE a degraded route --
        // policy "strict-fallback" means every primary was unavailable.
        const {
          policy = null,
          reasons = [],
          blockedGeneration = false,
          registration: decisionRegistration = registration,
        } = state.lastDecision ?? {};
        const target = publicTarget(lease.target, body.tier, state.inventory?.modelVariants, attestation);
        const modelKey = `${lease.target?.providerID}/${lease.target?.modelID}`;
        const effort = resolveTurnEffort({
          baseVariant: target?.model?.variant,
          advertised: state.inventory?.modelVariants?.[modelKey] ?? [],
          ceiling: lease.target?.effortCeiling,
          turnClass: body.turnClass,
          engineEffortUpdates: body.engineEffortUpdates === true,
          modelKey,
          sessionID: body.sessionID,
          config: TURN_EFFORT_CONFIG,
        });
        const appliedTarget = effort.applied !== effort.base && target
          ? { ...target, model: { ...target.model, variant: effort.applied } }
          : target;
        if (TURN_EFFORT_CONFIG.mode !== "off") {
          logTurnEffort({
            at: Date.now(),
            sessionID: typeof body.sessionID === "string" ? body.sessionID : null,
            // A grant-bearing lease's ID is a spend credential binding: never written to a log.
            ...(grantedLease?.spendGrant ? {} : { leaseID: lease.leaseID }),
            tier: body.tier ?? null,
            targetID: lease.target?.id ?? null,
            providerID: lease.target?.providerID ?? null,
            modelID: lease.target?.modelID ?? null,
            mode: TURN_EFFORT_CONFIG.mode,
            class: logTurnClass(body.turnClass?.class),
            reason: logTurnReason(body.turnClass?.reason),
            resolvedFrom: logResolvedFrom(body.turnClass?.resolvedFrom),
            engineEffortUpdates: body.engineEffortUpdates === true,
            eligible: effort.eligible,
            base: effort.base,
            policies: effort.policies,
            applied: effort.applied,
            clamped: effort.clamped,
          });
        }
        return reply(response, 200, {
          leaseID: lease.leaseID,
          target: appliedTarget,
          existing: lease.existing,
          // The exact scope the proxy must enforce: null for a primary (its actual attested
          // identity becomes the baseline), the grant's canonical instance for a reserve.
          expectedCredentialInstance: lease.outage?.expectedCredentialInstance ?? null,
          generation: lease.outage?.generation ?? null,
          decision: {
            policy,
            reasons,
            ...(blockedGeneration ? { blockedGeneration: true } : {}),
            registration: decisionRegistration,
          },
        });
      }
      if (request.url === "/release") {
        const binding = settlementBinding(state, body);
        settlePolicyLease(state, binding, {
          outcome: "abandoned",
          source: "lease",
        });
        dropExactLease(state, body.sessionID, binding?.leaseID);
        dropOneShotAssignment(state, body.sessionID, binding?.leaseID);
        writeState(state);
        return reply(response, 200, { ok: true });
      }
      if (request.url === "/touch") {
        if (!validSessionID(body.sessionID)) throw new Error("invalid session id");
        const present = Boolean(state.leases[body.sessionID]);
        if (present) state.leases[body.sessionID].touchedAt = Date.now();
        writeState(state);
        return reply(response, 200, { ok: true, present });
      }
      // Read-only: does this session hold a live lease, and on what? The gateway asks before
      // forwarding an opencode session's request on that session's own lease, so a session id
      // alone can never reach a model the broker did not grant it.
      if (request.url === "/lease/verify") {
        if (!validSessionID(body.sessionID)) throw new Error("invalid session id");
        // A content-filter cascade candidate's request is honored by a FRESH grant for the same wire
        // model even if the session's single lease slot was since stomped back to the home model by a
        // normal re-lease. Only a model this session was actually granted (within the TTL) matches,
        // so this never reaches an ungranted model; absent a match it falls through to the slot check.
        const wireModel = typeof body.wireModel === "string" && body.wireModel ? body.wireModel : null;
        if (wireModel) {
          const grant = matchCascadeGrant(body.sessionID, wireModel);
          if (grant) {
            return reply(response, 200, {
              held: true,
              leaseID: grant.leaseID,
              target: { id: grant.targetID, kind: grant.kind, model: { providerID: grant.providerID, id: grant.modelID } },
              expectedCredentialInstance: null,
              generation: null,
            });
          }
        }
        const lease = state.leases[body.sessionID];
        const leaseMatches = lease && (body.leaseID === undefined || body.leaseID === lease.leaseID);
        const target = leaseMatches ? targetForID(lease.targetID, allTargets(state)) : null;
        // A held reserve verifies only while its exact grant is current; a lapsed or rotated
        // grant must not let the gateway keep forwarding on it.
        const reserve = Boolean(target) && outageRoutingEnabled(CONFIG.modelOutages) &&
          policyReserveIDs(CONFIG.modelOutages).has(target.id);
        if (!target || (reserve && !currentReserveGrant({
          policy: CONFIG.modelOutages, outages: state.outages, targetID: target.id, assertion: lease.outage, now: Date.now(),
        }))) return reply(response, 200, { held: false });
        // A grant-bearing paid lease verifies ONLY by its exact nonempty lease ID -- an omitted,
        // default or older ID never falls back to it -- and only while its paid context is
        // current. Legacy unpinned manual and ordinary leases keep their prior behavior.
        if (lease.spendGrant !== undefined && (lease.sessionID !== body.sessionID ||
          typeof body.leaseID !== "string" || body.leaseID === "" || body.leaseID !== lease.leaseID)) {
          return reply(response, 200, { held: false });
        }
        const attestation = currentLeaseAttestation(state, body.sessionID, lease);
        if (attestation === null) return reply(response, 200, { held: false });
        return reply(response, 200, {
          held: true,
          leaseID: lease.leaseID,
          // Verification is about an EXISTING grant: the plain identity, never a fresh
          // variant resolution, which throws once a catalog refresh drops an
          // effortCeiling variant. Only the broker's own paid attestation is added.
          target: {
            id: target.id,
            kind: target.kind,
            model: { providerID: target.providerID, id: target.modelID },
            ...attestation,
          },
          expectedCredentialInstance: reserve ? lease.outage.expectedCredentialInstance : null,
          generation: reserve ? lease.outage.generation : null,
        });
      }
      if (request.url === "/quota-evidence") {
        // NON-SETTLING: the gateway's report that an actual bound 429 carried a closed positive
        // subscription-quota signal. It only stores a broker-timestamped observation on the exact
        // current source lease; the plugin's later /failure remains the sole settler. Refusals are
        // static codes that never echo the body.
        const refuse = (status, code) => reply(response, status, { error: "quota evidence refused", code });
        if (!closedKeys(body, QUOTA_EVIDENCE_BODY_KEYS) || !validSessionID(body.sessionID) || !validSessionID(body.leaseID) ||
          typeof body.targetID !== "string" || !body.targetID || body.targetID.length > 200) {
          return refuse(400, "invalid-quota-evidence");
        }
        const now = Date.now();
        const subscriptionQuota = normalizeSubscriptionQuota(body.subscriptionQuota, { now });
        if (!subscriptionQuota) return refuse(400, "invalid-subscription-quota");
        // Everything below the exact current binding is refused WITHOUT touching state, so a
        // stale, forged or misbound report can never poison the legitimate current lease.
        const lease = state.leases[body.sessionID];
        if (!lease || lease.sessionID !== body.sessionID || lease.leaseID !== body.leaseID || lease.targetID !== body.targetID) {
          return refuse(409, "unknown-or-stale-lease");
        }
        const source = currentContinuationSource(state, lease, now);
        if (!source) return refuse(409, "not-a-continuation-source");
        if (lease.quotaObservationConflict !== undefined) return refuse(409, "quota-evidence-conflict");
        if (lease.quotaObservation !== undefined) {
          const prior = currentQuotaObservation(lease.quotaObservation, source, now);
          // Identical normalized repeat: idempotent, the original timestamp stands.
          if (prior && sameSubscriptionQuota(prior.subscriptionQuota, subscriptionQuota)) {
            return reply(response, 200, { ok: true, accepted: true });
          }
          // Two different answers for one exact binding: neither is trusted. The usable
          // observation is erased and a closed tombstone stays until the lease is replaced, so a
          // later replay of either value cannot restore authority.
          delete lease.quotaObservation;
          lease.quotaObservationConflict = { version: 1, conflictedAtMs: now };
          writeState(state);
          return refuse(409, "quota-evidence-conflict");
        }
        lease.quotaObservation = {
          version: 1,
          observedAtMs: now,
          policyRevision: source.snapshot.policyRevision,
          subscriptionQuota: { ...subscriptionQuota },
        };
        writeState(state);
        return reply(response, 200, { ok: true, accepted: true });
      }
      if (request.url === "/failure") {
        const binding = settlementBinding(state, body);
        const lease = state.leases[body.sessionID];
        const assignment = state.assignments[body.sessionID];
        // The router sees provider events while the guard sees the failed prompt result,
        // so a routed classifier can report the same failed turn twice. The first report
        // consumes the lease; preserve its reply on the sticky assignment so every later
        // report for that settled turn is a no-op. A fresh lease replaces the assignment
        // wholesale, which re-arms failure handling for the next turn.
        if (!lease && binding === assignment && assignment?.settledFailure &&
          (!body.targetID || body.targetID === assignment.settledFailure.targetID)) {
          settlePolicyLease(state, assignment, {
            outcome: "failure",
            failureClass: body.failureClass,
            source: "failure",
          });
          return reply(response, 200, assignment.settledFailure.reply);
        }
        const targetID = bindingTargetID(binding, body);
        // Only a failure on the exact CURRENT lease, named by its nonempty lease ID, can consume a
        // quota observation, and it consumes it whatever kind the failure turns out to be. An
        // assignment, historical or replayed binding, or a body flag, is never proof.
        const sourceLease = lease && binding === lease && typeof body.leaseID === "string" &&
          body.leaseID !== "" && body.leaseID === lease.leaseID ? lease : null;
        const quotaObservation = sourceLease?.quotaObservation;
        if (sourceLease) {
          delete sourceLease.quotaObservation;
          delete sourceLease.quotaObservationConflict;
        }
        const error = normalizeProviderError(body.error);
        const target = targetForID(targetID, allTargets(state));
        // A legacy targetless binding must not borrow caller-supplied attribution.
        const kind = classifyRoutingFailure(body.error, binding?.leaseID && binding.targetID && target?.id === binding.targetID
          ? { targetProviderID: target.providerID }
          : undefined);
        const policyEvent = settlePolicyLease(state, binding, {
          outcome: "failure",
          failureClass: body.failureClass,
          source: "failure",
        });
        if (policyEvent?.replayed && binding?.historical) {
          writeState(state);
          return reply(response, 200, { ok: true, kind: "replayed" });
        }
        const settleFailure = (replyBody) => {
          const exactAssignment = binding === assignment || (binding === lease &&
            binding?.leaseID === assignment?.leaseID);
          if (exactAssignment && assignment && targetID && assignment.targetID === targetID) {
            assignment.settledFailure = { targetID, reply: replyBody };
          }
          dropExactLease(state, body.sessionID, binding?.leaseID);
          writeState(state);
          return reply(response, 200, replyBody);
        };
        // A rate/quota complaint is the only capacity truth providers give us:
        // calibrate the window ceiling to the spend that triggered it.
        if (target && (kind === "quota" || kind === "rate")) {
          state.budgets = learnCapacityFromFailure(state.budgets, target.providerID, kind);
        }
        let circuitUntil = null;
        // Set only for a quota stop: whether circuitUntil is the real reset (see below).
        let resetKnown = null;
        // Extra reasons the per-kind branches may add to the failure-reported
        // trail (e.g. the fast-mode fence names each circuited sibling). An
        // ordinary failure's reasons stay exactly [kind, error.message].
        let extraReasons = [];
        if (kind === "noop") {
          // A caller-side non-fault (empty/unparsed classifier output, caller
          // timeout). Release the lease, record NOTHING -- no circuit, no
          // health evidence. This is the broker refusing to let a buggy or old
          // client bench a healthy lane; it protects live sessions that cannot
          // be patched in place.
          logDecision({
            at: Date.now(), sessionID: body.sessionID, targetID: targetID ?? null,
            policy: "failure-ignored", reasons: ["noop", error.message].filter(Boolean),
          });
          return settleFailure({ ok: true, kind: "noop" });
        }
        if (kind === "payload") {
          // The REQUEST was malformed and the provider answered correctly by refusing
          // it. Record no circuit and no health evidence: the fault belongs to this
          // session's transcript, so every model on every provider rejects the same
          // bytes, and the only thing fencing lanes for it achieves is emptying the
          // pool one sibling at a time (anthropic, 2026-09-17). Release the lease so a
          // resend is free to pick any target -- including the one that just refused.
          logDecision({
            at: Date.now(), sessionID: body.sessionID, targetID: targetID ?? null,
            policy: "failure-payload", reasons: ["payload", error.message].filter(Boolean),
          });
          return settleFailure({ ok: true, kind: "payload" });
        }
        if (kind === "policy") {
          // A provider GUARD answered for this conversation (lib/routing.js `policy`). No circuit
          // and no health evidence -- every other session on the target is fine -- but THIS
          // session avoids what refused it, so the plugin's re-engage and its later leases land on
          // a model that will answer. OpenAI's flags are account-level, so all of OpenAI; an
          // Anthropic refusal is per model, so only that target.
          const scope = target?.providerID === "openai" ? "provider" : "target";
          const avoid = target ? recordPolicyAvoid(state, body.sessionID, target, { scope, reason: error.message }) : null;
          logDecision({
            at: Date.now(), sessionID: body.sessionID, targetID: targetID ?? null,
            policy: "failure-policy",
            reasons: ["policy", ...(avoid ? [`avoid-${scope}:${scope === "provider" ? target.providerID : target.id}`] : []), error.message].filter(Boolean),
          });
          return settleFailure({ ok: true, kind: "policy", ...(avoid ? { avoidUntil: avoid.until } : {}) });
        }
        if (kind === "context") {
          // The request did not FIT the target's window. The provider is
          // healthy and answered correctly, so record no circuit and no health
          // evidence -- fencing llama.cpp here would take out every local
          // target over one oversized session. Release the lease so the next
          // one is chosen fresh: the session's context has grown, and
          // localContextEligible will now steer it to a roomier window.
          logDecision({
            at: Date.now(), sessionID: body.sessionID, targetID: targetID ?? null,
            policy: "failure-context", reasons: ["context", error.message].filter(Boolean),
          });
          return settleFailure({ ok: true, kind: "context" });
        }
        if (target && kind === "quota") {
          // Subscription quota is shared across a provider's models. Leaving this
          // target-scoped would immediately route the next job to another capped SKU.
          // Expiry prefers, in order: a reset named in the error, the provider's
          // own usage report, then a bounded re-probe -- an unknown reset must
          // cost one probing request per window, never a provider held out of
          // the pool until state surgery.
          const explicitReset = quotaRenewalAt(error);
          // A lapsed plan has no reset coming: hold it until the background provider
          // check sees the renewal (lib/provider-check.js), not for a fixed re-probe.
          const lapsed = isPlanLapsed(error);
          // Continuation proof candidate: the consumed observation, still valid for the current
          // source, on an uncontradicted (not billing/credit/lapse/auth/burst/other-status)
          // failure whose explicit reset, if any, is exactly the observed one.
          const proofNow = Date.now();
          const proofSource = sourceLease && quotaObservation !== undefined && !lapsed
            ? currentContinuationSource(state, sourceLease, proofNow) : null;
          const observed = proofSource && proofSource.target.id === target.id
            ? currentQuotaObservation(quotaObservation, proofSource, proofNow) : null;
          const proofCandidate = observed &&
            !subscriptionQuotaFailureContradicted({ text: providerErrorText(body.error), statusCode: error.statusCode }) &&
            (explicitReset === null || explicitReset === observed.subscriptionQuota.resetAtMs)
            ? { source: proofSource, observed } : null;
          // SDK normalization can lose the reset; a valid observed reset supplies it BEFORE any
          // optional provider-usage fetch. An explicit different reset is kept as is (no proof).
          circuitUntil = explicitReset ?? proofCandidate?.observed.subscriptionQuota.resetAtMs ?? null;
          if (!circuitUntil && planUsageConfigured(PROVIDER_BUDGETS[target.providerID])) {
            circuitUntil = planUsageResetAt(freshPlanUsage(target.providerID));
          }
          // Whether `until` is when the limit actually lifts or only when the broker next
          // probes: a usage-limit message must never present a re-probe time as the return day.
          resetKnown = Boolean(circuitUntil);
          if (!circuitUntil) circuitUntil = Date.now() + (lapsed ? LAPSED_HOLD_MS : QUOTA_REPROBE_MS);
          state.circuits[providerCircuitID(target)] = {
            kind,
            ...(lapsed ? { reason: PLAN_LAPSED_REASON } : {}),
            until: circuitUntil,
            resetKnown,
            updatedAt: Date.now(),
          };
          // Re-proven from a fresh context after the circuit write (and after any await above).
          if (proofCandidate) recordContinuationProof(state, body.sessionID, sourceLease, proofCandidate, target);
        } else if (target && kind === "auth") {
          // Local credential staleness: fence the target for one minute so the
          // retry lands elsewhere, record NOTHING against provider health --
          // the token refresh fixes this, benching the provider does not.
          state.circuits[targetID] = { kind, until: Date.now() + 60_000, updatedAt: Date.now() };
        } else if (target && kind === "model") {
          if (isFastModeCreditsRequired(error)) {
            // TRAP: FAST-MODE-CREDITS IS ACCOUNT-LEVEL AND SPEED-SCOPED. Every fast
            // sibling on the hit provider will fail identically on the next
            // attempt; fencing only the hit one would make the retry ladder
            // walk each sibling, one failed turn each, every hold window.
            // ☆ Enumerate the siblings BEFORE writing any circuit so a
            // zero-fence case (hit target is a standard model, or the provider
            // has no speed variants) is distinguishable here. The siblings are
            // only enumerated when the HIT target is itself a speed variant --
            // a signal on a standard hit is caller-side, not a target fault.
            // See the empty-fence noop below.
            const until = Date.now() + FAST_MODE_CREDITS_HOLD_MS;
            const fencedIDs = [];
            if (isSpeedVariant(target.modelID)) {
              for (const candidate of Object.values(allTargets(state))) {
                if (candidate.providerID === target.providerID && isSpeedVariant(candidate.modelID)) {
                  fencedIDs.push(candidate.id);
                }
              }
            }
            if (fencedIDs.length === 0) {
              // TRAP: A FAST-MODE SIGNAL ON A NON-SPEED LEASE IS CALLER-SIDE. The
              // hit target is a standard model (every speed variant is
              // isSpeedVariant()) or the provider carries no speed variants at
              // all; either way the client asked for fast mode on a target
              // that cannot deliver it, so a target fault classification would
              // close a circuit on the healthy standard target for 6h. Treat
              // it as caller-side: no circuit, no health evidence, release the
              // lease, and reply kind "noop" (the
              // same reply as the noop branch above) so the plugin's auto
              // re-engage does not loop the same failing request.
              logDecision({
                at: Date.now(), sessionID: body.sessionID, targetID: targetID ?? null,
                policy: "failure-ignored",
                reasons: ["noop", "fast-mode-credits on a non-speed target", error.message].filter(Boolean),
              });
              return settleFailure({ ok: true, kind: "noop" });
            }
            // ☆ No circuit on a NON-SPEED target: a standard target serves
            // standard speed fine; fencing it would take Opus out of build/smart
            // for 6h because one client asked for fast. The loop above collects
            // only speed variants, the hit target among them.
            // ☆ Never a provider circuit, never health evidence: standard
            // targets stay routable, and the retry ladder reaches gpt-terra
            // (fast-build fallback) without any provider-wide quarantine.
            circuitUntil = until;
            for (const candidateID of fencedIDs) {
              state.circuits[candidateID] = {
                kind,
                reason: FAST_MODE_CREDITS_REASON,
                until,
                updatedAt: Date.now(),
              };
            }
            // Decision trail names the circuited ids so an operator reading
            // decisions.jsonl can see which siblings this /failure closed on.
            extraReasons = [FAST_MODE_CREDITS_REASON, `fenced:${fencedIDs.join(",")}`];
          } else {
            // A catalog can lead provider rollout. Reject only this immutable model
            // version so the next lease can select the previous family member.
            state.circuits[targetID] = { kind, until: null, updatedAt: Date.now() };
          }
        } else if (target && kind === "overload") {
          // Transient provider capacity (529/overloaded): fence the target for a
          // few seconds so a quick recovery returns to the SAME provider, and
          // record NO health evidence -- a brief overload must not quarantine a
          // provider or force a lasting switch. (opencode's own retry already
          // rides out sub-30s backoffs without any switch at all.)
          circuitUntil = Date.now() + OVERLOAD_MS;
          state.circuits[targetID] = { kind, until: circuitUntil, updatedAt: Date.now() };
        } else if (target && kind === "rate") {
          // ☠️ A 429 IS THE PROVIDER ASKING FOR PATIENCE, NOT A COMPATIBILITY FAULT, and it was
          // the only kind still falling through to the catch-all -- the one branch that records
          // health evidence. `quota`, the harder version of the same signal, has never recorded
          // any. So a provider that throttled two models inside the fifteen-minute window
          // quarantined itself for being busy. alibaba-token-plan throttled `tester` and `scout`
          // subagents every couple of minutes on 2026-09-17 and only escaped because every burst
          // happened to land on the same model; a fan-out that spread over two would have taken
          // the provider out. Fence the TARGET briefly so the retry moves, and record nothing.
          circuitUntil = Date.now() + RATE_LIMIT_MS;
          state.circuits[targetID] = { kind, until: circuitUntil, updatedAt: Date.now() };
        } else if (target && kind === "connect") {
          // ☠️ NOTHING ANSWERED, so this is not about the one target that was asked for --
          // every target on that provider is behind the same dead socket. Fencing the target
          // alone sends the next lease to its sibling on the SAME endpoint, which fails
          // identically: on 2026-09-14 llama.cpp went down and local-coder, local-27b and
          // local-classifier were all gone together. So the circuit is PROVIDER-scoped, which
          // is what makes the next lease reach a different provider instead of a dead sibling.
          // ☆ Short, and no health evidence: a container restart must not quarantine the lane
          // for the rest of the day. Same reasoning as `overload` directly above -- the
          // difference is only that nothing answered, so there is no status code to read.
          circuitUntil = Date.now() + CONNECT_MS;
          state.circuits[providerCircuitID(target)] = { kind, until: circuitUntil, updatedAt: Date.now() };
        } else if (target) {
          circuitUntil = Date.now() + RATE_LIMIT_MS;
          state.circuits[targetID] = { kind, until: circuitUntil, updatedAt: Date.now() };
          // Evidence only for a failure the PROVIDER produced (see isProviderOriginated): an
          // unrecognised local error fences this target and goes no further.
          if (isProviderOriginated(body.error)) {
            // Evidence plus the existing quarantine-transition notice (lib/provider-health.js).
            state.health = recordFailureEvidenceAndNotify(state.health, target.providerID, {
              targetID: target.id,
              modelID: target.modelID,
              sessionID: body.sessionID,
              reasonCode: kind,
              error,
              at: Date.now(),
            }, notifyBurn);
          } else {
            extraReasons.push("not-provider-originated");
          }
        }
        logDecision({
          at: Date.now(), sessionID: body.sessionID, targetID: targetID ?? null,
          policy: "failure-reported",
          reasons: [kind, ...extraReasons, error.message].filter(Boolean),
        });
        // A genuine provider failure may be an outage: ask for both official feeds without
        // waiting. requestPoll only schedules (single-flight, 60 s spacing); its transaction
        // queues behind this handler, so nothing here awaits the worker. It records no outage
        // evidence: only the verified /model-health path does.
        if (outageService && outageRoutingEnabled(CONFIG.modelOutages) && target) {
          outageService.worker.requestPoll("anthropic");
          outageService.worker.requestPoll("openai");
        }
        return settleFailure({ ok: true, kind, ...(circuitUntil ? { circuitUntil } : {}), ...(resetKnown !== null ? { resetKnown } : {}) });
      }
      if (request.url === "/served-model") {
        // The gateway's report of the model the provider SAYS served the request (OpenAI's
        // `openai-model` header). OpenAI reroutes a flagged account to an older model and says so
        // only there (Codex reads the same header and warns "this request was routed to ..."). It
        // settles nothing -- the lease stays held -- it only steers this session off the provider
        // that downgraded it, from its next lease on. A dated snapshot of the requested model
        // (requested id + suffix) or the base of a speed alias (base + suffix = requested) is the
        // same model, not a reroute.
        const binding = settlementBinding(state, body);
        const targetID = bindingTargetID(binding, body);
        const target = targetForID(targetID, allTargets(state));
        const served = typeof body.servedModelID === "string" && /^[A-Za-z0-9][A-Za-z0-9._:\/-]{0,199}$/.test(body.servedModelID)
          ? body.servedModelID : null;
        if (!target || !served) return reply(response, 200, { ok: true, rerouted: false });
        const requested = String(target.modelID).toLowerCase(), actual = served.toLowerCase();
        const rerouted = actual !== requested && !actual.startsWith(`${requested}-`) && !requested.startsWith(`${actual}-`);
        if (rerouted) {
          // OpenAI reroutes a flagged ACCOUNT, so all of OpenAI; Anthropic's server-side fallback is
          // per model, so only that target (the same scopes as the `policy` failure kind).
          const scope = target.providerID === "openai" ? "provider" : "target";
          const avoid = recordPolicyAvoid(state, body.sessionID, target, { scope, reason: `rerouted ${target.modelID} -> ${served}` });
          logDecision({
            at: Date.now(), sessionID: body.sessionID, targetID: target.id,
            policy: "provider-reroute",
            reasons: ["policy", `served ${served}`, `requested ${target.modelID}`, `avoid-${scope}:${scope === "provider" ? target.providerID : target.id}`],
          });
          writeState(state);
          return reply(response, 200, { ok: true, rerouted: true, avoidUntil: avoid.until });
        }
        return reply(response, 200, { ok: true, rerouted: false });
      }
      if (request.url === "/complete") {
        const binding = settlementBinding(state, body);
        const targetID = bindingTargetID(binding, body);
        const target = targetForID(targetID, allTargets(state));
        if (target) state.health = markProbationSuccessHealthy(state.health, target.providerID);
        settlePolicyLease(state, binding, { outcome: "success", source: "complete" });
        dropExactLease(state, body.sessionID, binding?.leaseID);
        dropOneShotAssignment(state, body.sessionID, binding?.leaseID);
        writeState(state);
        return reply(response, 200, { ok: true });
      }
      if (request.url === "/quarantine") {
        const scope = body.scope;
        const kind = body.kind;
        const providerMatch = typeof body.providerID === "string" ? body.providerID : null;
        const targetScope = typeof body.targetID === "string" ? body.targetID : null;
        const scopeProvider = scope === "provider" ? providerMatch : null;
        if (scope !== "provider" || kind !== "compatibility") throw new Error("invalid quarantine request");
        if (!scopeProvider || !REASON_CODE.test(scopeProvider)) throw new Error("invalid provider id");
        if (body.reasonCode !== undefined && body.reasonCode !== null && !REASON_CODE.test(body.reasonCode)) {
          throw new Error("invalid reason code");
        }
        const providerID = scopeProvider || targetScope;
        state.health = operatorQuarantineProvider(state.health, providerID, { reasonCode: body.reasonCode ?? "operator" });
        writeState(state);
        return reply(response, 200, { ok: true });
      }
      if (request.url === "/forget") {
        let binding = settlementBinding(state, body);
        let policyEvent = null;
        const currentLease = state.leases[body.sessionID];
        // A supplied id that is not the session's exact live lease can only settle an archived
        // policy candidate. Ordinary retained assignment pins are not a second settlement
        // authority. Settle the historical record first so its replay cannot reach health or
        // release a replacement live lease.
        if (body.leaseID !== undefined && currentLease?.leaseID !== body.leaseID) {
          const historical = policyLeaseBinding(state, body.leaseID, body.sessionID);
          if (!historical) throw new Error("unknown or stale lease id for session");
          policyEvent = settlePolicyLease(state, historical, {
            outcome: body.completed === true ? "success" : "abandoned",
            source: "forget",
          });
          if (policyEvent?.replayed) return reply(response, 200, { ok: true });
          binding = historical;
        }
        const completed = body.completed === true;
        if (completed) {
          const targetID = bindingTargetID(binding, body);
          const target = targetForID(targetID, allTargets(state));
          if (target) state.health = markProbationSuccessHealthy(state.health, target.providerID);
        }
        if (!policyEvent) settlePolicyLease(state, binding, {
          outcome: completed ? "success" : "abandoned",
          source: "forget",
        });
        // The lease goes (its slot is free again); the assignment stays. It is the session's
        // pin, so the next turn after an idle returns to the same model instead of being
        // re-rolled. Its idle TTL (ASSIGNMENT_TTL_MS) starts now, as the turn ends.
        // ONE-SHOT SESSIONS ARE THE EXCEPTION: their id is minted per request and never
        // recurs, so there is no next turn to return and nothing that can read the pin back.
        // The assignment goes with the lease rather than waiting out the TTL in the cap.
        dropExactLease(state, body.sessionID, binding?.leaseID);
        dropOneShotAssignment(state, body.sessionID, binding?.leaseID);
        writeState(state);
        return reply(response, 200, { ok: true });
      }
      if (request.url === "/usage") {
        // Ledger for the depletion balancer: one report per provider request (a
        // step-finish part in opencode), token counts included for token-metered plans.
        // Manual/local-profile sessions report too — their spend burns the same windows.
        const rawObservedAt = Number(body.observedAt);
        const providerID = typeof body.providerID === "string" ? body.providerID : "";
        if (!/^[a-z0-9][a-z0-9._:-]{0,180}$/.test(providerID)) throw new Error("invalid provider id");
        const requests = Math.min(Math.max(0, Number(body.requests) || 0), 100);
        const raw = body.tokens && typeof body.tokens === "object" ? body.tokens : {};
        const clampTokens = (value) => Math.min(Math.max(0, Number(value) || 0), 50_000_000);
        // A leased usage report is accepted only for its exact broker-minted binding.
        // Validate before mutating the ledger so a stale report has no side effects.
        const sessionID = validSessionID(body.sessionID) ? body.sessionID : null;
        // rootSessionID identifies the parent session for a subagent, so the burn watch
        // can roll a fan-out of children back into their root. Validated with the same
        // rule as sessionID; anything else drops to null (the session then counts as its
        // own root, which is the safe fallback -- see lib/burn-watch.js).
        const rootSessionID = validSessionID(body.rootSessionID) ? body.rootSessionID : null;
        const modelID = typeof body.modelID === "string" ? body.modelID : null;
        const assignment = settlementBinding(state, body, { usage: true });
        state.budgets = recordBudgetUsage(state.budgets, providerID, {
          requests,
          modelID: modelID ?? undefined,
          tokens: {
            input: clampTokens(raw.input),
            output: clampTokens(raw.output),
            cacheRead: clampTokens(raw.cacheRead),
            cacheWrite: clampTokens(raw.cacheWrite),
          },
        });
        // A step-finish usage report is stronger success evidence than waiting for
        // session.idle, but only when it matches the exact retained binding. Keep the
        // observation time so a delayed report cannot clear newer probation.
        // Burn watch: after the ledger, before the reply, so a stop rides back to the
        // client that reported the step -- the one process that can abort that session.
        let burn = null;
        if (burnWatch && !localProviderIDs(allTargets(state)).has(providerID)) {
          const watched = burnWatch.recordUsage({
            sessionID, rootSessionID, providerID, modelID,
            tokens: { input: clampTokens(raw.input), output: clampTokens(raw.output), cacheRead: clampTokens(raw.cacheRead), cacheWrite: clampTokens(raw.cacheWrite) },
            at: Date.now(),
          });
          for (const alert of watched.alerts) notifyBurn(alert);
          if (watched.stop) {
            burn = { stop: true, reason: watched.stop.reason };
            recordDecision(state, {
              at: Date.now(), sessionID, providerID, policy: "burn-stop", code: "burn-stop",
              targetID: null, reasons: [watched.stop.reason],
              eligibleTargetIDs: [], balancedTargetIDs: [], providerUtilization: {},
            });
          }
        }
        logUsage(usageRecord({
          at: Date.now(), sessionID, leaseID: typeof body.leaseID === "string" ? body.leaseID : undefined, providerID,
          modelID,
          // rootSessionID is passed as-is; usageRecord drops it from the written line when
          // it equals the session itself (the root carries no new signal when it is its own
          // root). One self-root filter, in the one place that writes the file.
          rootSessionID,
          lease: assignment,
          tokens: { input: clampTokens(raw.input), output: clampTokens(raw.output), cacheRead: clampTokens(raw.cacheRead), cacheWrite: clampTokens(raw.cacheWrite) },
          local: localProviderIDs(allTargets(state)).has(providerID),
          caller: sanitizeCaller(body.caller),
        }));
        const target = targetForID(assignment?.targetID, allTargets(state));
        if (Number.isFinite(rawObservedAt) && rawObservedAt <= Date.now() &&
          target && target.providerID === providerID && target.modelID === body.modelID) {
          state.health = markProbationSuccessHealthy(state.health, providerID, { at: rawObservedAt });
          settlePolicyLease(state, assignment, { outcome: "success", source: "usage" });
        }
        writeState(state);
        return reply(response, 200, { ok: true, utilization: effectiveUtilization(state.budgets, providerID), ...(burn ? { burn } : {}) });
      }
      if (request.url === "/status") {
        const persistence = pendingPersistence(state);
        if (persistence || prepareStateForPersistence(state)) {
          writeState(state, { requireDurable: persistence === 2 });
        }
        return reply(response, 200, { ...publicState(state, resolverProcesses), queue: { ...queueStats } });
      }
      if (request.url === "/preview") {
        // Side-effect-free selection: what WOULD each tier get right now. No
        // lease, no cursor advance, no assignment -- the UI shows this so a
        // user tabbing agents on a new-session page can see the real routing
        // destination instead of the agent's static pin.
        const profile = isProfile(body.profile) ? body.profile : "auto";
        const tiers = (Array.isArray(body.tiers) ? body.tiers : ["smart"])
          .filter((tier) => ROUTE_TIER_NAMES.includes(tier));
        // ☠️ Without a size the preview cannot answer for a LOCAL target at all:
        // localContextEligible refuses a null estimate by design, so every local
        // candidate drops out and the preview silently reports the cloud fallback
        // instead of the real destination. That is wrong for any lane holding a
        // local target and outright misleading for a local-FIRST one such as
        // `classifier`. Normalized exactly as /lease does, so preview and lease
        // answer the same question. Absent, it stays null and cloud-only lanes are
        // unaffected.
        const rawPreviewContext = Number(body.contextTokens);
        const previewContextTokens = Number.isFinite(rawPreviewContext) && rawPreviewContext >= 0 &&
          (typeof body.contextTokens === "number" || typeof body.contextTokens === "string")
          ? Math.floor(rawPreviewContext)
          : null;
        const previewOutagesEnabled = outageRoutingEnabled(CONFIG.modelOutages);
        const targets = previewOutagesEnabled
          ? markManagedOutageScope(allTargets(state), { policy: CONFIG.modelOutages, modelRoles: CONFIG.modelRoles })
          : allTargets(state);
        // A manual target fail-closed by an invalid apiContinuation block is never previewed,
        // exactly as /lease never selects it.
        const admitted = Object.fromEntries(Object.entries(targets)
          .filter(([targetID, target]) => !manualApiTargetConfigBlocked(targetID) &&
            cloudTargetAdmitted(target, state.inventory?.providers, profile)));
        // Match /lease's default resolver snapshot: preview has no caller-local
        // narrowing, so calculate heads from the complete admitted view once and
        // reuse that exact outage snapshot for every requested tier. Staged probation-only
        // candidates are not head candidates here either.
        const previewProbationOnly = probationOnlyModelKeys(state.modelPolicy);
        const previewModelKeys = Object.values(admitted)
          .map((target) => `${target.providerID}/${target.modelID}`)
          .filter((key) => !previewProbationOnly.has(key));
        const previewHeads = previewOutagesEnabled ? buildCanonicalHeads({
          policy: CONFIG.modelOutages,
          targets: admitted,
          admittedModelKeys: previewModelKeys,
          resolvableModelKeys: previewModelKeys,
        }) : {};
        let availableModels;
        try { availableModels = await localModels(); } catch { availableModels = new Set(); }
        if (run.expired) return;
        const preview = {};
        for (const tier of tiers) {
          const choice = chooseTarget({
            profile,
            tier,
            circuits: state.circuits,
            health: state.health,
            cursors: { ...state.cursors },
            targets: admitted,
            active: activeCounts(state, admitted),
            localModels: availableModels,
            contextTokens: previewContextTokens,
            modelContexts: state.inventory?.modelContexts ?? {},
            modelOutputs: state.inventory?.modelOutputs ?? {},
            budgets: state.budgets ?? {},
            outagePolicy: CONFIG.modelOutages,
            outages: previewOutagesEnabled ? state.outages ?? null : null,
            canonicalHeads: previewHeads,
            // A preview is a snapshot of NOW, and nobody has waited yet.
            waitedMs: 0,
          });
          // `fallback` marks an answer that is itself a fallback rung, so a session restoring
          // home from a fallback can tell "a primary is back" from "another fallback".
          preview[tier] = choice
            ? {
              ...publicTarget(choice.target, tier, state.inventory?.modelVariants),
              ...(choice.decision?.policy === "strict-fallback" ? { fallback: true } : {}),
            }
            : null;
        }
        // ☆ Additive, and load-bearing for honesty: at waitedMs 0 a delayed rung is invisible to
        // the selection above, so a lane whose only fallback is delayed previews as a bare null --
        // indistinguishable from "this profile has no fallback at all". Publishing the rungs and
        // their thresholds lets a reader tell "nothing behind this" from "not yet".
        const delayedProfileFallbacks = (CONFIG.profileFallbacks?.[profile] ?? [])
          .map((targetIDs, index) => ({ targetIDs: [...targetIDs], afterMs: CONFIG.profileFallbackAfterMs?.[profile]?.[index] ?? 0 }))
          .filter((rung) => rung.afterMs > 0);
        return reply(response, 200, { preview, delayedProfileFallbacks });
      }
      if (request.url === "/headroom") {
        // Side-effect-free, like /preview: is this lane about to run out of usage with nothing to
        // take over? The router asks for each working session, and when it is, tells the session
        // to wrap up and write a handoff before it is cut off (lib/usage-limit.js laneHeadroom).
        const profile = isProfile(body.profile) ? body.profile : "auto";
        const tier = ROUTE_TIER_NAMES.includes(body.tier) ? body.tier : "smart";
        const rawContext = Number(body.contextTokens);
        const contextTokens = Number.isFinite(rawContext) && rawContext >= 0 ? Math.floor(rawContext) : null;
        const targets = allTargets(state);
        const lane = targetEligibleIDsFor(profile, tier, targets).map((targetID) => targetForID(targetID, targets)).filter(Boolean);
        const nowMs = Date.now();
        // A local model in the lane that fits the session can carry on when the cloud runs out.
        const localFits = lane.some((target) => target.kind === "local" &&
          localContextEligible(targetContext(target, state.inventory?.modelContexts), contextTokens,
            targetContextHeadroom(target), targetOutputReserve(target, state.inventory?.modelOutputs)) &&
          ![state.circuits[target.id], state.circuits[providerCircuitID(target)]].some((value) =>
            value && (value.until === null || Number(value.until) > nowMs)));
        const providerIDs = [...new Set(lane.filter((target) => target.kind !== "local").map((target) => target.providerID))];
        return reply(response, 200, laneHeadroom({ providerIDs, circuits: state.circuits, planFor: cachedPlanUsage, localFits, now: nowMs }));
      }
      if (request.url === "/decisions") {
        let lines = [];
        try {
          lines = readFileSync(DECISION_LOG, "utf8").trim().split("\n").slice(-Math.min(Math.max(1, Number(body.limit) || 50), 500));
        } catch {}
        const decisions = [];
        for (const line of lines) { try { decisions.push(JSON.parse(line)); } catch {} }
        return reply(response, 200, { decisions });
      }
      if (request.url === "/selection") {
        const persistence = pendingPersistence(state);
        if (persistence || prepareStateForPersistence(state)) {
          writeState(state, { requireDurable: persistence === 2 });
        }
        return reply(response, 200, { lastDecision: publicState(state, resolverProcesses).lastDecision });
      }
      if (request.url === "/inventory") {
        if (body.configFingerprint !== CONFIG_FINGERPRINT) {
          return reply(response, 200, { accepted: false, reason: "config-fingerprint-mismatch" });
        }
        // The router checked this before discovery; repeat it at the mutation boundary so
        // an OAuth-to-API-key change cannot publish stale automatic admission.
        if (typeof body.authRevision !== "string" || !body.authRevision || body.authRevision !== authRevision()) {
          throw new Error("auth revision changed before inventory publication");
        }
        // CRITICAL: shape first, then ADMISSION -- see admitResolvableInventory. The publisher
        // filters too, but the publisher is plugin code loaded into every opencode process
        // at spawn, so a pane older than the last fix keeps publishing models this host
        // cannot resolve. The resolver view is re-read per ingest rather than cached: the
        // watch job rewrites it, this request already pays a full state write, and a cached
        // copy would keep admitting or refusing models after a refresh. It is a file read,
        // never `opencode models` -- no blocking subprocess belongs on this path.
        const admitted = admitResolvableInventory(normalizeDiscoveredInventory(body), readResolvableModels());
        reportInventoryDrops(admitted);
        const inventory = admitted.inventory;
        const previous = JSON.stringify(state.inventory?.targets ?? {}) + JSON.stringify(state.inventory?.providers ?? {}) +
          JSON.stringify(state.inventory?.modelContexts ?? {}) + JSON.stringify(state.inventory?.modelOutputs ?? {}) +
          JSON.stringify(state.inventory?.modelVariants ?? {});
        const previousDynamicTargetIDs = new Set(Object.keys(state.inventory?.targets ?? {}));
        state.inventory = body.authOnly === true
          ? { ...state.inventory, providers: inventory.providers, authRevision: body.authRevision, updatedAt: Date.now() }
          : { ...inventory, authRevision: body.authRevision, updatedAt: Date.now() };
        if (body.authOnly !== true) {
          for (const targetID of previousDynamicTargetIDs) {
            if (!state.inventory.targets[targetID]) delete state.circuits[targetID];
          }
        }
        const next = JSON.stringify(state.inventory.targets) + JSON.stringify(state.inventory.providers) +
          JSON.stringify(state.inventory.modelContexts) + JSON.stringify(state.inventory.modelOutputs) +
          JSON.stringify(state.inventory.modelVariants);
        writeState(state);
        return reply(response, 200, { accepted: true, ok: true, changed: previous !== next, inventory: state.inventory });
      }
      if (request.url === "/rearm") {
        const targets = allTargets(state);
        const target = targetForID(body.targetID, targets);
        const providerMatch = typeof body.targetID === "string" ? body.targetID.match(PROVIDER_SCOPE) : null;
        const providerID = providerMatch?.[1] ?? null;
        const providerKey = providerID ? `provider:${providerID}` : (typeof body.targetID === "string" ? providerCircuitID(body.targetID) : null);
        const knownProvider = providerKey && (Object.values(targets)
          .some((candidate) => providerCircuitID(candidate) === providerKey) || state.health.providers?.[providerID] || state.circuits[providerKey]);
        if (body.targetID && !target && !knownProvider) throw new Error("unknown target or provider");
        if (body.reasonCode !== undefined && body.reasonCode !== null && !REASON_CODE.test(body.reasonCode)) {
          throw new Error("invalid reason code");
        }
        if (providerID) {
          state.health = rearmQuarantinedProvider(state.health, providerID, { reasonCode: body.reasonCode });
          delete state.circuits[providerKey];
        } else if (body.targetID) {
          delete state.circuits[target ? target.id : providerKey];
        } else {
          state.circuits = {};
        }
        writeState(state);
        return reply(response, 200, { ok: true });
      }
      return reply(response, 404, { error: "unknown broker endpoint" });
    } catch (error) {
      if (run.expired) return;
      if (error?.code === "request-abandoned" || abandoned(request, response)) {
        response.destroy();
        return;
      }
      // Additive: `error` is unchanged, and a code is published only when it is one of
      // the closed set this file assigned.
      const code = REFUSAL_CODES.has(error?.refusalCode) ? error.refusalCode : null;
      return reply(response, 400, {
        error: String(error?.message ?? error),
        ...(code ? { code } : {}),
        ...(code && error.refusalTargetID ? { targetID: error.refusalTargetID } : {}),
        ...(code && error.refusalModelID ? { modelID: error.refusalModelID } : {}),
      });
    }
  };
  // Local profile leases may await the model inventory. Serialize mutations so two
  // simultaneous requests cannot both reserve the single local slot while awaiting it.
  let serial = Promise.resolve();
  // Built once, after the serializer below exists; null whenever outage reserves are disabled.
  let outageService = null;
  // ☠️ THE SERIAL CHAIN IS A SINGLE POINT OF PERMANENT FAILURE. Every request is queued
  // onto one promise, so a handler that never settles does not fail that ONE request --
  // it stops the broker answering anything, for good, while the process stays perfectly
  // healthy: alive in do_epoll_wait, accepting connections, replying to none. That is not
  // a hypothetical. On 2026-09-17 a quota lookup whose child had died but whose stdio
  // pipes stayed open left `handle` pending, and the broker sat mute for an hour and
  // three quarters while every prompt in every session timed out. Reproduced in isolation
  // by SIGSTOPping a broker and resuming it: five consecutive requests still timed out
  // afterwards, because the chain never advanced past the one that died mid-flight.
  // ☆ So the chain now advances no matter what a handler does. The deadline is longer
  // than any legitimate handler (the slowest, a plan-usage refresh, is capped at 20s) and
  // the caller gets an honest 503 rather than a socket that never answers. A wedged
  // handler costs one slow request now, not the whole fleet's ability to route.
  // ☠️ THE DEADLINE ALONE STILL WEDGED IT, for four and a half days from 2026-09-24 01:46.
  // Clients give up after 2.5 s (lib/client.js) and retry; the request they abandoned stays
  // queued. When it reached the head, parseBody waited on a dead socket until this deadline
  // fired, so each abandoned request cost 30 s -- and once the queue was 2.5 s deep, every
  // request behind it was abandoned too, and every retry added another. The chain drained
  // one request per 30 s while callers filled it far faster: alive, idle in epoll, mute.
  // ☆ So a request whose client is already gone is dropped at the head of the queue for
  // free, and every deadline hit is logged and notified instead of answered in silence.
  // Test-only override lets daemon regression tests exercise the 30 s fence without waiting.
  const HANDLER_DEADLINE_MS = Number(process.env.OPENCODE_BROKER_TEST_HANDLER_DEADLINE_MS) > 0
    ? Number(process.env.OPENCODE_BROKER_TEST_HANDLER_DEADLINE_MS)
    : 30_000;
  // IncomingMessage.destroyed becomes true after a normally completed request body on
  // Unix sockets, while its response and socket are still live. Treat it as abandonment
  // only when the body itself was cut short; completed requests are fenced by the actual
  // response/socket state.
  const abandoned = (request, response) => (request.destroyed && !request.complete) ||
    response.destroyed || Boolean(request.socket?.destroyed);
  const alertStall = (title, body) => {
    const now = Date.now();
    console.error(`[opencode-broker] ${title}: ${body}`);
    if (now - queueStats.lastAlertAt < STALL_ALERT_INTERVAL_MS) return;
    queueStats.lastAlertAt = now;
    notifyBurn({ title, body, kind: "broker-stall" });
  };
  const guarded = (request, response, enqueuedAt, preparsed = undefined, run = { expired: false, deadlineAt: null }, releaseArrivalDeadline = () => {}) => {
    queueStats.depth -= 1;
    const waitedMs = Date.now() - enqueuedAt;
    if (run.expired || abandoned(request, response)) {
      queueStats.abandoned += 1;
      releaseArrivalDeadline();
      return Promise.resolve();
    }
    if (waitedMs >= QUEUE_WAIT_ALERT_MS) {
      queueStats.slowWaits += 1;
      alertStall("opencode-broker queue backed up",
        `${request.url} waited ${Math.round(waitedMs / 1000)} s in the request queue (${queueStats.depth} still queued)`);
    }
    const remainingMs = Number.isFinite(run.deadlineAt)
      ? Math.max(0, run.deadlineAt - Date.now())
      : HANDLER_DEADLINE_MS;
    if (remainingMs <= 0) {
      if (typeof run.expire === "function") run.expire();
      else run.expired = true;
      releaseArrivalDeadline();
      return Promise.resolve();
    }
    let timer = null;
    const finished = new Promise((resolve) => {
      timer = setTimeout(() => {
        if (typeof run.expire === "function") run.expire();
        else {
          run.expired = true;
          queueStats.deadlineHits += 1;
          queueStats.lastDeadlineAt = Date.now();
          alertStall("opencode-broker handler deadline exceeded",
            `${request.url} did not finish within ${HANDLER_DEADLINE_MS / 1000} s; answered 503 (${queueStats.depth} queued behind it)`);
          try { if (!response.writableEnded) reply(response, 503, { error: "broker handler deadline exceeded" }); } catch {}
          try { request.destroy(); } catch {}
        }
        resolve();
      }, remainingMs);
      if (typeof timer?.unref === "function") timer.unref();
    });
    let running;
    try { running = Promise.resolve(handle(request, response, preparsed, run)); }
    catch (error) { running = Promise.reject(error); }
    // The serial queue is released at the deadline, but a preflight slot remains held until
    // the real handler settles. This prevents an expired body/parser from escaping the cap.
    running.then(releaseArrivalDeadline, releaseArrivalDeadline).finally(() => clearTimeout(timer));
    return Promise.race([running.catch(() => {}), finished]);
  };
  const enqueueRequest = (request, response, preparsed = undefined, run = undefined, releaseArrivalDeadline = undefined) => {
    const enqueuedAt = Date.now();
    queueStats.depth += 1;
    const queued = () => guarded(request, response, enqueuedAt, preparsed, run, releaseArrivalDeadline);
    serial = serial.then(queued, queued);
  };

  // ONE queue for every broker state mutation. The outage worker's transactions ride the same
  // `serial` chain as the request handlers (its injected serialize), never a second queue: the
  // returned promise propagates the transaction's own result or rejection to its caller, while
  // the chain's tail swallows it so the next transaction still runs.
  const enqueueTransaction = (transaction) => {
    const result = serial.then(transaction);
    serial = result.catch(() => {});
    return result;
  };
  if (outageRuntime) {
    const policy = CONFIG.modelOutages;
    const { gatewayURL, gatewayKey, gatewayCredential, healthKey } = outageRuntime;
    outageService = createOutageService({
      policy,
      // Static, config-validated targets only: discovered inventory can never invent a reserve.
      targets: TARGETS,
      key: healthKey,
      gatewayCredential,
      read: () => state.outages,
      // Conservative on failure: the in-memory image keeps the ADVANCED state (counts, cooldown,
      // occupancy) even when the strict write throws, so no later ordinary write can restore an
      // older image and refund a probe. The worker sees the throw and dispatches nothing.
      commit: async (next) => {
        state.outages = next;
        writeState(state, { requireDurable: true });
      },
      serialize: enqueueTransaction,
      // Official feeds are fetched outside the queue by the worker, bounded by the fetcher.
      fetchStatus: (providerID, { signal }) => fetchStatusSnapshot(providerID, { policy, signal }),
      sendProbe: (assignment, { signal, waitForOutcome }) => runOutageProbe({
        assignment, scope: assignment.expectedScopePolicy, gatewayURL, gatewayKey, signal, waitForOutcome,
      }),
      canProbe: (candidate) => probeAdmissible(candidate, {
        policy,
        targets: TARGETS,
        circuits: state.circuits,
        health: state.health,
        providers: state.inventory?.providers ?? {},
        active: activeCounts(state),
        providerActive: activeProviderCounts(state),
        probationOnly: probationOnlyModelKeys(state.modelPolicy),
        // Same discovered windows and output caps ordinary routing fits leases against.
        modelContexts: state.inventory?.modelContexts ?? {},
        modelOutputs: state.inventory?.modelOutputs ?? {},
        now: Date.now(),
      }),
      timers: globalThis,
      lookupOrdinaryLease: (input) => ordinaryHealthLease({
        input,
        lease: typeof input?.sessionID === "string" && Object.hasOwn(state.leases, input.sessionID) ? state.leases[input.sessionID] : null,
        targets: TARGETS,
        policy,
        outages: state.outages,
        now: Date.now(),
      }),
      // The daemon routes every ordinary path itself, inside its queue; the service only ever
      // sees the private health and outage-probe paths. Reaching this is a routing bug.
      ordinaryRequest: async (path) => {
        throw new Error(`ordinary path ${path} reached the outage service`);
      },
      verifyAttestation: (input, ticket) => verifyHealthReport(healthKey, input, ticket),
    });
  }
  const OUTAGE_PRIVATE_PATHS = new Set(["/model-health/begin", "/model-health/outcome"]);
  const OUTAGE_PROBE_PATHS = new Set(["/probe/consume", "/probe/release"]);
  // ☠️ The private paths (and the pre-read of /probe/consume|release) run outside `guarded`, so
  // they had no deadline at all: a client that announced a body and never sent it left parseBody
  // pending for good, and server.close() then waited on that connection forever, so SIGTERM
  // never exited and the socket was never unlinked. Each such request now carries the SAME
  // deadline as an ordinary handler, measured from arrival, and is destroyed when it expires;
  // shutdown destroys whatever is still tracked here before closing the server. Private stalls
  // are a client's fault, not a wedged queue, so they are logged but deliberately NOT counted
  // in queueStats (which drives `opencode-broker health`) and do not notify.
  // OPENCODE_BROKER_TEST_PRIVATE_DEADLINE_MS exists only so tests need not wait 30 s; it is read
  // once, here, at startup.
  const PRIVATE_REQUEST_DEADLINE_MS = Number(process.env.OPENCODE_BROKER_TEST_PRIVATE_DEADLINE_MS) > 0
    ? Number(process.env.OPENCODE_BROKER_TEST_PRIVATE_DEADLINE_MS)
    : HANDLER_DEADLINE_MS;
  const privateRequests = new Map();
  const destroyPrivate = (request, response) => {
    response.destroy();
    request.destroy();
    request.socket?.destroy();
  };
  // Tracks one private request until its response finishes or its connection closes. The
  // returned release() hands a pre-read ordinary request over to the queue's own deadline.
  const trackPrivate = (request, response) => {
    let release = null;
    const timer = setTimeout(() => {
      console.error(`[opencode-broker] private request deadline exceeded: ${request.url} did not finish within ${PRIVATE_REQUEST_DEADLINE_MS / 1000} s; connection destroyed`);
      release();
      destroyPrivate(request, response);
    }, PRIVATE_REQUEST_DEADLINE_MS);
    if (typeof timer?.unref === "function") timer.unref();
    release = () => {
      clearTimeout(timer);
      privateRequests.delete(request);
      response.off("finish", release);
      response.off("close", release);
    };
    privateRequests.set(request, response);
    response.once("finish", release);
    response.once("close", release);
    return release;
  };
  // Private outage paths run OUTSIDE the ordinary queue: /model-health/outcome awaits a worker
  // transaction on that very queue, so wrapping the whole handler in it would deadlock.
  const handleOutage = async (request, response, body) => {
    try {
      if (!isLoopbackControlAddress(request.socket?.remoteAddress)) {
        return reply(response, 403, { error: "loopback control endpoint required", code: "loopback-control-required" });
      }
      if (request.method !== "POST") return reply(response, 405, { error: "POST required" });
      const parsed = body ?? await parseBody(request);
      return reply(response, 200, await outageService.request(request.url, parsed));
    } catch (error) {
      if (abandoned(request, response)) {
        response.destroy();
        return;
      }
      return reply(response, 400, { error: String(error?.message ?? error), code: "outage-health-refused" });
    }
  };
  // Every ordinary request shares one original-arrival fence. Probe prereads keep private
  // ownership until their purpose is known, then hand over only the remaining arrival budget.
  // Lease/failure preflights additionally reserve bounded external-I/O capacity; /release and
  // all other ordinary routes share the fence but deliberately bypass that capacity admission.
  const PREFLIGHT_LIMIT = 64;
  let preflightActive = 0;
  const startPreflight = (request, response, reserveCapacity = true, arrivedAt = Date.now()) => {
    if (reserveCapacity && preflightActive >= PREFLIGHT_LIMIT) {
      reply(response, 503, { error: "broker preflight capacity exceeded" });
      return null;
    }
    if (reserveCapacity) preflightActive += 1;
    const run = { expired: false, deadlineAt: arrivedAt + HANDLER_DEADLINE_MS };
    let references = 1;
    let closed = false;
    const release = () => {
      if (closed || --references !== 0) return;
      closed = true;
      clearTimeout(timer);
      response.off("close", abandon);
      if (reserveCapacity) preflightActive -= 1;
    };
    const retain = () => { if (!closed) references += 1; return release; };
    const abandon = () => { run.expired = true; try { request.destroy(); } catch {} };
    const expire = () => {
      if (run.expired) return;
      run.expired = true;
      queueStats.deadlineHits += 1;
      queueStats.lastDeadlineAt = Date.now();
      alertStall("opencode-broker handler deadline exceeded",
        `${request.url} did not finish within ${HANDLER_DEADLINE_MS / 1000} s; answered 503 (${queueStats.depth} queued behind it)`);
      try { if (!response.writableEnded) reply(response, 503, { error: "broker handler deadline exceeded" }); } catch {}
      try { request.destroy(); } catch {}
    };
    run.expire = expire;
    const timer = setTimeout(expire, Math.max(0, run.deadlineAt - Date.now()));
    if (typeof timer?.unref === "function") timer.unref();
    response.once("close", abandon);
    return { run, retain, release };
  };
  const preflightLease = (request, response) => {
    const preflight = startPreflight(request, response);
    if (!preflight) return;
    const { run, retain, release } = preflight;
    parseBody(request).then(async (body) => {
      if (run.expired || abandoned(request, response)) return;
      const reachesCloud = body?.localOnly !== true && profileReachesCloud(isProfile(body?.profile) ? body.profile : "auto");
      const fetched = fetchPlanUsageReports();
      if (!reachesCloud) {
        // Local admission joins immediately and shares the original arrival fence. It
        // still shares `run` with its detached report apply, so an expired local request cannot
        // later write a quota circuit.
        const releaseFetch = retain();
        const releaseHandler = retain();
        enqueueRequest(request, response, body, run, releaseHandler);
        fetched.then(() => {
          if (run.expired || abandoned(request, response)) return;
          enqueueTransaction(() => {
            if (!run.expired && !abandoned(request, response)) refreshPlanUsage(state);
          }).catch(() => {});
        }, () => {}).finally(releaseFetch);
        return;
      }
      await fetched;
      if (run.expired || abandoned(request, response)) return;
      enqueueRequest(request, response, body, run, retain());
    }, (error) => {
      if (!run.expired && !abandoned(request, response)) reply(response, 400, { error: String(error?.message ?? error) });
    }).catch(() => {}).finally(release);
  };
  const refreshOutsideQueue = (request, response, run) => {
    if (request.method !== "POST" || request.url === "/quota-evidence") return;
    fetchPlanUsageReports().then(() => {
      if (run.expired || abandoned(request, response)) return;
      enqueueTransaction(() => {
        if (!run.expired && !abandoned(request, response)) refreshPlanUsage(state);
      }).catch(() => {});
    }, () => {});
  };
  // A quota failure needs the same fresh report to derive its reset, but its remote wait must
  // remain outside the mutation queue. The arrival fence prevents a late report from settling
  // the failed lease or writing a circuit after the caller has received its deadline response.
  const preflightFailure = (request, response) => {
    const preflight = startPreflight(request, response);
    if (!preflight) return;
    const { run, retain, release } = preflight;
    fetchPlanUsageReports().then(() => {
      if (run.expired || abandoned(request, response)) return;
      enqueueRequest(request, response, undefined, run, retain());
    }, () => {}).finally(release);
  };
  const server = createServer((request, response) => {
    if (outageService && OUTAGE_PRIVATE_PATHS.has(request.url)) {
      trackPrivate(request, response);
      handleOutage(request, response).catch(() => {});
      return;
    }
    if (outageService && OUTAGE_PROBE_PATHS.has(request.url) && request.method === "POST") {
      const arrivedAt = Date.now();
      const release = trackPrivate(request, response);
      // The purpose decides the owner, so the bounded body is read here, once.
      parseBody(request).then((body) => {
        if (abandoned(request, response)) return;
        if (body && typeof body === "object" && body.purpose === "outage-health") {
          return handleOutage(request, response, body);
        }
        // Transfer ownership, not a fresh budget: preread time counts against ordinary work.
        release();
        const ordinary = startPreflight(request, response, false, arrivedAt);
        enqueueRequest(request, response, body, ordinary.run, ordinary.release);
        return undefined;
      }, (error) => {
        if (abandoned(request, response)) { response.destroy(); return; }
        reply(response, 400, { error: String(error?.message ?? error) });
      }).catch(() => {});
      return;
    }
    if (request.url === "/lease" && request.method === "POST") return preflightLease(request, response);
    if (request.url === "/failure" && request.method === "POST") return preflightFailure(request, response);
    const ordinary = startPreflight(request, response, false);
    refreshOutsideQueue(request, response, ordinary.run);
    enqueueRequest(request, response, undefined, ordinary.run, ordinary.release);
  });
  const removeSocket = () => { try { unlinkSync(socketPath); } catch {} };
  server.on("close", removeSocket);
  await new Promise((resolve, reject) => {
    server.once("error", reject);
    server.listen(socketPath, () => {
      chmodSync(socketPath, 0o600);
      resolve();
    });
    if (slotWatch) setInterval(() => { pollSlots().catch(() => {}); }, CONFIG.slotWatch.intervalMs).unref();
  });
  // Providers with no usage reading (lib/provider-check.js) are checked on a timer. The
  // network call runs OUTSIDE the serial queue, so a slow provider never delays a lease;
  // only the circuit change is queued, where it cannot interleave with a handler.
  const runProviderChecks = async () => {
    for (const [providerID, providerConfig] of Object.entries(PROVIDER_BUDGETS)) {
      if (!providerCheckConfigured(providerConfig)) continue;
      const result = await checkProvider(providerID, providerConfig).catch(() => null);
      if (result) serial = serial.then(() => applyCheckResult(state, providerID, result)).catch(() => {});
    }
  };
  runProviderChecks().catch(() => {});
  setInterval(() => { runProviderChecks().catch(() => {}); }, PROVIDER_CHECK_INTERVAL_MS).unref();
  // Plan usage refreshes on a timer too, not only as a side effect of requests: a quiet
  // broker otherwise kept serving the last reading for as long as nothing called it, and every
  // HUD showed that number as current. Fetched outside the queue (warming the cache), applied
  // inside it, where refreshPlanUsage finds the warm reading and only applies it.
  const refreshPlanUsageTick = async () => {
    await fetchPlanUsageReports();
    serial = serial.then(() => refreshPlanUsage(state)).catch(() => {});
  };
  setInterval(() => { refreshPlanUsageTick().catch(() => {}); }, 30_000).unref();
  // Started only once the socket is listening, so its first transaction meets a live queue.
  outageService?.worker.start();
  process.stdout.write(`opencode-broker listening on ${socketPath}\n`);
  for (const note of DEPRECATIONS) process.stderr.write(`opencode-broker: deprecated: ${note}\n`);
  // Once, at startup: target IDs only (registry keys), never pins or the rejected values.
  if (API_CONTINUATION_CONFIG_ERROR !== null) {
    process.stderr.write(`opencode-broker: apiContinuation config invalid -- manual API targets fail closed (unleasable, unverifiable, no grants): ${Object.keys(CONFIG.manualApiTargets).join(", ") || "(none registered)"}\n`);
  }
  for (const signal of ["SIGINT", "SIGTERM"]) {
    process.once(signal, () => {
      const finish = (code) => {
        // A stalled private request would hold server.close() open forever; drop them first.
        for (const [request, response] of [...privateRequests]) destroyPrivate(request, response);
        server.close(() => process.exit(code));
      };
      if (!outageService) return finish(0);
      // Abort and drain outage fetches, probes and timers BEFORE the socket goes away. A close
      // failure is reported and turns the exit status non-zero; it never blocks shutdown.
      outageService.close().then(() => finish(0), (error) => {
        console.error(`[opencode-broker] outage service shutdown failed: ${error?.message ?? error}`);
        finish(1);
      });
    });
  }
};

const main = async () => {
  const [command = "status", targetID, reasonCode] = process.argv.slice(2);
  if (command === "serve") return serve();
  if (command === "status") {
    process.stdout.write(JSON.stringify(await brokerRequest("/status"), null, 2) + "\n");
    return;
  }
  if (command === "health") {
    // Liveness from the OUTSIDE, for a timer: a broker that is alive but mute looks perfectly
    // healthy to systemd, which is how one sat wedged for days. Exit 0 when /status answers
    // promptly and the queue is draining, 1 when it does not answer at all, 2 when it answers
    // but the queue is backed up. Every outcome prints one line.
    const timeoutMs = Number(targetID) > 0 ? Number(targetID) : 10_000;
    let status;
    try {
      status = await brokerRequest("/status", {}, { timeout: timeoutMs });
    } catch (error) {
      process.stdout.write(`unhealthy: /status did not answer within ${timeoutMs / 1000} s (${error?.message ?? error})\n`);
      process.exitCode = 1;
      return;
    }
    const queue = status?.queue ?? {};
    const recentDeadline = Number(queue.lastDeadlineAt) > Date.now() - 300_000;
    if (Number(queue.depth) > 20 || recentDeadline) {
      process.stdout.write(`unhealthy: queue depth ${queue.depth ?? "?"}, ${queue.deadlineHits ?? 0} handler deadline(s) hit` +
        (recentDeadline ? `, the last ${Math.round((Date.now() - queue.lastDeadlineAt) / 1000)} s ago` : "") + "\n");
      // 2, not 1: it answers, so a restart would only lose state -- worth a look, not a kill.
      process.exitCode = 2;
      return;
    }
    process.stdout.write(`ok: queue depth ${queue.depth ?? 0}, ${queue.abandoned ?? 0} abandoned request(s) skipped\n`);
    return;
  }
  if (command === "selection") {
    process.stdout.write(JSON.stringify(await brokerRequest("/selection"), null, 2) + "\n");
    return;
  }
  if (command === "decisions") {
    process.stdout.write(JSON.stringify(await brokerRequest("/decisions", { limit: Number(targetID) || 50 }), null, 2) + "\n");
    return;
  }
  if (command === "usage") {
    // Read straight from the log: a report needs no running broker.
    const days = Number(targetID) > 0 ? Number(targetID) : 7;
    const records = [];
    for (const file of [`${USAGE_LOG}.1`, USAGE_LOG]) {
      let text = "";
      try { text = readFileSync(file, "utf8"); } catch { continue; }
      for (const line of text.split("\n")) {
        if (!line) continue;
        try { records.push(JSON.parse(line)); } catch {}
      }
    }
    // The largest prompt the broker leases onto a local target: the same rule as
    // localContextEligible -- context minus an absolute outputReserve, else the headroom fraction.
    const ceilingOf = (target) => {
      const declared = Number(targetContext(target, {}));
      if (!(declared > 0)) return null;
      const reserve = Number(target.outputReserve);
      return reserve > 0 && reserve < declared ? declared - reserve : Math.floor(declared * targetContextHeadroom(target));
    };
    const rows = summarizeUsage(records, { since: Date.now() - days * 86_400_000, targets: TARGETS, ceilingOf });
    if (!rows.length) {
      process.stdout.write(`no usage recorded in the last ${days} day(s) (${USAGE_LOG})\n`);
      return;
    }
    const k = (n) => (n >= 1000 ? `${Math.round(n / 1000)}K` : String(n));
    process.stdout.write(`prompt tokens per request and per session peak, last ${days} day(s)\n\n`);
    for (const row of rows) {
      const r = row.requests; const p = row.sessionPeaks;
      process.stdout.write(`${row.local ? "local" : "cloud"}  ${row.model}\n`);
      process.stdout.write(`  requests ${r.count}: p50 ${k(r.p50)}  p90 ${k(r.p90)}  p99 ${k(r.p99)}  max ${k(r.max)}\n`);
      process.stdout.write(`  session peaks (${p.count} sessions): p50 ${k(p.p50)}  p90 ${k(p.p90)}  p99 ${k(p.p99)}  max ${k(p.max)}\n`);
      if (row.callers.length) {
        process.stdout.write(`  callers: ${row.callers.map((c) => `${c.caller} x${c.requests}`).join(", ")}\n`);
      }
      for (const window of row.windows) {
        const share = p.count ? ((window.sessionsFit / p.count) * 100).toFixed(1) : "0.0";
        process.stdout.write(`  ${window.targetID} routes up to ${k(window.ceiling)}: ${share}% of session peaks fit\n`);
      }
    }
    return;
  }
  if (command === "rearm") {
    process.stdout.write(JSON.stringify(await brokerRequest("/rearm", { targetID }), null, 2) + "\n");
    return;
  }
  if (command === "quarantine") {
    const match = typeof targetID === "string" ? targetID.match(PROVIDER_SCOPE) : null;
    if (!match) throw new Error("usage: opencode-broker quarantine provider:<id> [reason-code]");
    if (reasonCode !== undefined && reasonCode !== null && !REASON_CODE.test(reasonCode)) {
      throw new Error("invalid reason code");
    }
    process.stdout.write(JSON.stringify(await brokerRequest("/quarantine", {
      scope: "provider",
      kind: "compatibility",
      providerID: match[1],
      reasonCode: reasonCode ?? "operator",
    }), null, 2) + "\n");
    return;
  }
  throw new Error("usage: opencode-broker serve | status | health [timeout-ms] | selection | decisions [n] | usage [days] | rearm [target-or-provider] | quarantine provider:<id> [reason-code]");
};

main().catch((error) => {
  process.stderr.write(`opencode-broker: ${error?.message ?? error}\n`);
  process.exitCode = 1;
});
