        "review": 1.4
      },
      "effort": {
        "review": "medium"
      }
    },
    "local-classifier": {
      "providerID": "llamacpp",
      "modelID": "qwen3.5-4b",
      "kind": "local",
      "capacity": 2,
      "context": 32768
    },
    "local-coder": {
      "providerID": "llamacpp",
      "modelID": "qwen3.5-9b-coder",
      "kind": "local",
      "capacity": 1,
      "context": 32768
    },
    // The vision lane's own declaration of the SAME model local-coder's lane holds behind the
    // 9b: no minContextTokens (a one-image caption is a small request and must not be refused
    // for being small) and a prepareCommand that RESTORES the resting set rather than forcing
    // a swap.
    "vision-27b": {
      "providerID": "llamacpp",
      "modelID": "qwen3.8-27b",
      "kind": "local",
      "capacity": 1,
      "context": 131072,
      "prepareCommand": ["/bin/true", "default"]
    },
    "uncensored-qwen": {
      "providerID": "llamacpp",
      "modelID": "qwen3.8-27b-uncensored",
      "kind": "local",
      "capacity": 1,
      "context": 65536
    },
    // Fixture-only second local candidate in the same lane, carrying a floor. A floor only
    // means anything where there is something to steer BETWEEN, so tests/context-floor.test.mjs
    // needs a lane with two locals; no deployment lane is required to look like this.
    "uncensored-floored": {
      "providerID": "llamacpp",
      "modelID": "floored-uncensored",
      "kind": "local",
      "capacity": 2,
      "context": 65536,
      "minContextTokens": 8000
    },
    // The big-uncensored shape: one model, both GPUs, its own profile lane and NO rung
    // under it -- a rung would suppress the prepareCommand that is its only way back.
    "uncensored-big": {
      "providerID": "llamacpp",
      "modelID": "big-uncensored-70b",
      "kind": "local",
      "capacity": 1,
      "context": 32768,
      "prepareCommand": ["/bin/true", "swap", "big-uncensored-70b"]
    },
    "gpt-luna": {
      "providerID": "openai",
      "modelID": "gpt-5.6-luna",
      "kind": "cloud",
      "effort": {
        "worker": "low",
        "classifier": "low"
      }
    },
    "glm": {
