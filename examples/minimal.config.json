// The smallest useful opencode-broker config: one cloud subscription (Anthropic,
// signed in through opencode) and one model served by llama.cpp on your own GPU.
// Copy to ~/.config/opencode-broker/config.json and change the model ids to yours.
{
  "targets": {
    "sonnet": { "providerID": "anthropic", "modelID": "claude-sonnet-4-5", "kind": "cloud" },
    "haiku": { "providerID": "anthropic", "modelID": "claude-haiku-4-5", "kind": "cloud" },
    // capacity = llama.cpp --parallel; context = tokens per slot (--ctx-size / --parallel).
    "local-coder": { "providerID": "llamacpp", "modelID": "qwen3-coder-30b", "kind": "local", "capacity": 2, "context": 32768 }
  },
  // Each tier is an ordered list of targets. The broker picks among the eligible ones.
  "tiers": {
    "deep": ["sonnet"],
    "smart": ["sonnet"],
    "build": ["sonnet"],
    "fast-build": ["sonnet"],
    "review": ["sonnet"],
    "worker": ["haiku", "local-coder"]
  },
  // F11 in the HUD offers these besides Auto and Manual. `private` is offline by name.
  "profiles": {
    "local": ["local-coder"],
    "private": ["local-coder"]
  },
  // Your subscription's limits, so the broker can spread load before you hit them.
  "budgets": {
    "anthropic": {
      "windows": [{ "id": "5h", "periodMs": 18000000, "meter": "requests", "capacity": 200 }]
    }
  },
  "localModelsUrl": "http://localhost:8080/v1/models"
}
