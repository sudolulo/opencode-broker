// A full opencode-broker config: three cloud subscriptions, a llama.cpp server with
// several local models, and every optional section. JSONC: comments are allowed.
// Copy to ~/.config/opencode-broker/config.json and cut it down to what you run;
// examples/minimal.config.json is the smallest useful starting point.
{
  "targets": {
    "qwen-max": {
      "providerID": "alibaba-token-plan",
      "modelID": "qwen3.8-max",
      "kind": "cloud",
      "fit": {
        "smart": 1.1
      }
    },
    "qwen-flash": {
      "providerID": "alibaba-token-plan",
      "modelID": "qwen3.8-flash",
      "kind": "cloud"
    },
    "deepseek-pro": {
      "providerID": "alibaba-token-plan",
      "modelID": "deepseek-v4-pro-0813",
      "kind": "cloud",
      "fit": {
        "build": 1.15
      }
    },
    "gpt-flagship": {
      "providerID": "openai",
      "modelID": "gpt-5.6-sol",
      "kind": "cloud",
      "fit": {
        "smart": 1.4
      },
      "effort": {
        "smart": "high"
      }
    },
    "gpt-terra": {
      "providerID": "openai",
      "modelID": "gpt-5.6-terra",
      "kind": "cloud",
      "fit": {
        "build": 1.2
      },
      "effort": {
        "build": "medium",
        "review": "medium",
        "fast-build": "low"
      }
    },
    "claude-opus-4-8-fast": {
      "providerID": "anthropic",
      "modelID": "claude-opus-4-8-fast",
      "kind": "cloud",
      "fit": {
        "fast-build": 1.3
      }
    },
    "claude-opus-5-fast": {
      "providerID": "anthropic",
      "modelID": "claude-opus-5-fast",
      "kind": "cloud",
      "fit": {
        "fast-build": 1.3
      }
    },
    // A classifier rung must be SMALL and NON-THINKING. Measured over 14 labelled
    // commands, 3 runs each: qwen3.5-4b scored 13/14, was
    // identical across every run, and answered in ~200ms (1.4s worst). The 9b coder
    // scored 12/14 in 10-54s because it THINKS -- 654 reasoning tokens for `ls -la`,
    // and on one command it hit the token cap and returned an EMPTY verdict, which
    // the caller can only treat as a denial.
    "local-classifier": {
      "providerID": "llamacpp",
      "modelID": "qwen3.5-4b",
      "kind": "local",
      "capacity": 2,
      "context": 32768
    },
    "local-coder": {
      "providerID": "llamacpp",
      "modelID": "qwen3.5-9b-coder",
      "kind": "local",
      "capacity": 1,
      "context": 32768
    },
    // ☠️ THE SAME MODEL AS A LANE ABOVE, DECLARED AGAIN ON PURPOSE, and the differences are
    // the point. A caller who needs THIS model (it is the vision model; an image pipeline and
    // a document OCR service name it too) cannot reach it through a lane that also holds a
    // cheaper sibling -- the broker chooses, and the tiebreak reads nothing about the request.
    // So it gets a lane of its own, and a target of its own to put in it:
    //   - NO `minContextTokens`. The floor on the shared-lane copy is what keeps a scarce
    //     2-slot model out of trivial worker turns; here there is no second candidate to steer
    //     toward, so the floor would only refuse -- and "caption this one image" is a few
    //     hundred tokens, which is exactly the request this lane exists to serve.
    //   - a `prepareCommand` that RESTORES THE RESTING SET rather than forcing a swap. This
    //     model is usually resident and is displaced only by a big exclusive model; the command
    //     that brings it back is the one that also puts back everything else that went with it.
    //     ☠️ Do NOT point it at a forcing "load this model" command: those do no in-use check,
    //     so asking for the vision model would yank a model out from under whoever displaced it,
    //     mid-request.
    // ☠️ Two targets on ONE model means two capacity budgets against one server's `--parallel`.
    // Give each a `modelCapacity` no higher than `--parallel` -- the broker then counts every
    // target's leases on the model against it -- or size the capacities so their SUM does not
    // exceed it. Otherwise the broker hands out more concurrent leases than the model has
    // slots and the extras queue at the server. A `modelCapacity` below `--parallel` keeps
    // the rest of the slots for callers that reach the server without a lease.
    "vision-27b": {
      "providerID": "llamacpp",
      "modelID": "qwen3.8-27b",
      "kind": "local",
      "capacity": 1,
      "context": 131072,
      "prepareCommand": ["/usr/local/bin/model-swap", "default"]
    },
    "uncensored-qwen": {
      "providerID": "llamacpp",
      "modelID": "qwen3.8-27b-uncensored",
      "kind": "local",
      "capacity": 1,
      "context": 65536
    },
    // ☠️ AN EXCLUSIVE model: it needs BOTH GPUs and evicts every other resident model to
    // land, so it is never a peer of the target above -- it is the reason `uncensored-70b`
    // is a profile of its own. Put a model like this in the same lane as a smaller one and
    // the broker will TIE-BREAK between them, which means the cheap choice sometimes costs
    // you every other local consumer on the box (a voice assistant, a vision model, an OCR
    // pipeline) with nobody having asked for it.
    // ☠️ prepareCommand is argv, NOT a shell line, and it is this target's ONLY way back:
    // give the profile below no rungs, or the rung serves the lease and the swap never runs.
    // ☆ `context` is per SLOT (--ctx-size / --parallel), and `capacity` is --parallel.
    "uncensored-big": {
      "providerID": "llamacpp",
      "modelID": "big-uncensored-70b",
      "kind": "local",
      "capacity": 1,
      "context": 32768,
      "prepareCommand": ["/usr/local/bin/model-swap", "swap", "big-uncensored-70b"]
    },
    "gpt-luna": {
      "providerID": "openai",
      "modelID": "gpt-5.6-luna",
      "kind": "cloud",
      "effort": {
        "worker": "low",
        "classifier": "low"
      }
    },
    "glm": {
      "providerID": "alibaba-token-plan",
      "modelID": "glm-5.2",
      "kind": "cloud",
      "fit": {
        "build": 1.1,
        "review": 1.1
      }
    },
    "deepseek-flash": {
      "providerID": "alibaba-token-plan",
      "modelID": "deepseek-v4-flash-0731",
      "kind": "cloud"
    },
    "gpt-pro": {
      "providerID": "openai",
      "modelID": "gpt-5.5-pro",
      "kind": "cloud",
      "effort": {
        "deep": "high"
      }
    },
    "haiku": {
      "providerID": "anthropic",
      "modelID": "claude-haiku-4-5",
      "kind": "cloud",
      "fit": {
        "classifier": 1.3
      }
    }
  },
  "tiers": {
    "smart": [
      "gpt-flagship",
      "qwen-max"
    ],
    "build": [
      "gpt-terra",
      "deepseek-pro",
      "glm"
    ],
    "fast-build": [
      "claude-opus-5-fast",
      "claude-opus-4-8-fast",
      "gpt-terra",
      "deepseek-flash"
    ],
    "worker": [
      "qwen-flash",
      "gpt-luna",
      "deepseek-flash",
      "local-coder"
    ],
    "classifier": [
      "local-classifier"
    ],
    "deep": [
      "gpt-pro",
      "qwen-max"
    ],
    "review": [
      "glm",
      "deepseek-pro",
      "gpt-terra"
    ]
  },
  "fallbacks": {
    // Every primary classifier target is a cloud subscription, so a billing or auth
    // failure takes them out as a GROUP -- and a classifier that cannot answer makes
    // opencode-guard's gate fail closed on every gray-zone command. A local rung has no
    // quota to exhaust, so it is the one rung that survives that.
    // Two requirements: keep it a SMALL NON-THINKING model (a thinking model spends
    // the output budget reasoning and returns no verdict), and the CALLER must send
    // `contextTokens` on the lease -- localContextEligible refuses a null estimate, so
    // a local rung is otherwise configured but permanently unreachable.
    "classifier": [
      [
        "haiku",
        "qwen-flash",
        "gpt-luna"
      ]
    ],
    "smart": [
      [
        "gpt-terra"
      ]
    ],
    "build": [
      [
        "claude-opus-5-fast",
        "claude-opus-4-8-fast"
      ],
      [
        "gpt-flagship"
      ]
    ],
    "fast-build": [
      [
        "gpt-terra"
      ]
    ],
    "deep": [
      [
        "gpt-flagship",
        "qwen-max"
      ],
      [
        "gpt-terra"
      ]
    ],
    "review": [
      [
        "gpt-terra"
      ],
      [
        "gpt-luna"
      ]
    ]
  },
  // Routing profiles, in the order the HUD offers them. `private` and anything ending in
  // `-offline` are OFFLINE (no network at all; shell commands run in a bubblewrap sandbox
  // with no network); set "offlineProfiles" to choose them explicitly.
  "profiles": {
    "local": [
      "local-coder"
    ],
    "private": [
      "local-coder"
    ],
    // A CAPABILITY lane rather than a privacy one: same LAN boundary as `local`, but exactly
    // one target, because "give me the vision model" is not a preference the broker may
    // overrule with the cheaper model standing next to it.
    "vision": [
      "vision-27b"
    ],
    "uncensored": [
      "uncensored-qwen"
    ],
    // ☠️ ONE target, and deliberately not listed anywhere else. `uncensored` and
    // `uncensored-70b` are both uncensored lanes, but they are not substitutes: the user
    // picks the 70B when they want the 70B and accepts what it evicts, and picks
    // `uncensored` when they do not. Merging them into one lane would hand that decision
    // to a round-robin cursor.
    "uncensored-70b": [
      "uncensored-big"
    ],
    "uncensored-offline": [
      "uncensored-qwen"
    ]
  },
  // Fallback rungs for a PROFILE, in the same shape `fallbacks` uses for a tier:
  // ordered groups, first group with an eligible member wins, and none of them is
  // consulted until the profile's own lane has nothing eligible at all. Without a
  // rung a restrictive profile is exactly its lane -- and a profile whose lane is one
  // local model at capacity 1 hard-fails the moment that model is swapped off its
  // GPU. Declare nothing and you keep that behaviour.
  // ☠️ A rung here is filtered to the LAN. A cloud target named under `local`,
  // `private` or an offline profile is DROPPED at load with a message on stderr,
  // because a privacy profile that quietly fails over to a paid API is worse than the
  // error it was avoiding. See `profileCloudEgress` if you really mean it.
  // ☆ Pick rungs the profile's own users would accept: another LAN model of similar
  // shape, ordered by how close it is to the primary. `local-classifier` last is the
  // "something rather than nothing" rung -- small, but it is on a different GPU.
  // ☠️ A rung SUPPRESSES that target's `prepareCommand`: the broker only prepares on
  // the path where it refused the lease, so an eligible rung means the refusal -- and
  // the swap that would bring the primary back -- never happens. Give `uncensored` a
  // rung only if that rung is ALSO uncensored; a censored rung would silently serve the
  // opposite of what the profile is for, forever.
  // ☠️ And weigh whose slots you are borrowing: `local-classifier` has 2, and
  // opencode-guard's safety gate leases from the same target.
  "profileFallbacks": {
    "local": [
      [
        "local-classifier"
      ]
    ],
    "private": [
      [
        "local-classifier"
      ]
    ]
    // ☠️ `uncensored-70b` is ABSENT ON PURPOSE, and the absence is the design. Its target
    // carries a prepareCommand, and a rung would make the lease succeed -- so the refusal
    // that runs the prepare never happens, the 70B is never swapped in, and the profile
    // quietly serves a model the user did not choose, forever. An empty rung list means
    // "refuse once, say the model is being prepared, and heal on the resend", which is the
    // honest answer and the one that actually recovers.
  },
  // The ONLY way a LAN profile's derived pools may name a cloud target. Deliberately a
  // separate top-level allowlist rather than a flag inside a rung: the plausible
  // mistake is pasting a tier's rungs (full of cloud targets) into profileFallbacks,
  // and no amount of pasting can grant egress -- opening the boundary takes a second,
  // differently-shaped edit, and one grep shows every profile that may leave the LAN.
  // ☠️ An OFFLINE profile (`private`, `uncensored-offline`) is refused entry here.
  // Empty, the default, means every restrictive profile stays on the LAN.
  "profileCloudEgress": [],
  "budgets": {
    "anthropic": {
      "windows": [
        {
          "id": "5h",
          "periodMs": 18000000,
          "meter": "requests",
          "capacity": 600
        },
        {
          "id": "week",
          "periodMs": 604800000,
          "meter": "requests",
          "capacity": 12000
        }
      ]
    },
    "openai": {
      "windows": [
        {
          "id": "5h",
          "periodMs": 18000000,
          "meter": "requests",
          "capacity": 300
        },
        {
          "id": "week",
          "periodMs": 604800000,
          "meter": "requests",
          "capacity": 6000
        }
      ]
    },
    "alibaba-token-plan": {
      "windows": [
        {
          "id": "week",
          "periodMs": 604800000,
          "meter": "tokens",
          "capacity": 25000000
        }
      ]
    }
  },
  "localModelsUrl": "http://localhost:8080/v1/models",
  "trustedSubscriptionProviders": [
    "alibaba-token-plan"
  ],
  "workerLocalShareDenominator": 4,
  "profileTools": {
    "localOnlineExtra": [
      "searxng_search",
      "searxng_web_search",
      "searxng_web_url_read"
    ],
    "localOnlinePrefixes": [
      "gitea_"
    ]
  },
  "localContextHeadroom": 0.6,
  "deals": [
    {
      "providerID": "alibaba-token-plan",
      "modelPrefix": "deepseek-",
      "multiplier": 0.5,
      "daily": {
        "start": "22:00",
        "end": "08:00",
        "utcOffsetMinutes": 480
      },
      "note": "Model Studio DeepSeek night discount (22:00-08:00 UTC+8). Unverified whether plan credits get the night rate; steering toward it is harmless either way."
    }
  ],
  "tierProviderWeights": {
    "smart": {
      "anthropic": 2
    },
    "worker": {
      "anthropic": 0.5
    }
  },
  // Which tier each opencode agent rides. Merged over the defaults (build -> build,
  // plan -> smart, general -> inherit, explore -> worker, and tier-named agents to their
  // tier); a trailing * matches a prefix. Anything unmatched rides defaultAgentTier.
  "agentTiers": {
    "reviewer": "review",
    "review-*": "review",
    "researcher": "smart",
    "tester": "worker"
  },
  "defaultAgentTier": "worker",
  // Lease another tier's lane for this one. Only upward: an alias never weakens a tier.
  "tierAliases": {},
  // Where opencode-broker-watch reports catalog changes: argv, run without a shell.
  // {title}, {body} and {kind} are filled in; a command naming neither {title} nor {body}
  // gets the two appended.
  "watch": {
    "notifyCommand": ["/usr/local/bin/notify"]
  },
  // The burn watch: stops a session that is burning its plan in a loop, and notifies on
  // fast spend. On by default with the thresholds in the README; list only what you change.
  // notifyCommand defaults to watch.notifyCommand; [] only logs to the broker's stderr.
  "burnWatch": {
    "notifyCommand": ["/usr/local/bin/notify", "{title}", "{body}", "high", "{kind}"],
    "sessionStopTokens": 6000000,
    "planWindow": "5h"
  },
  // The HUD (hud/tui.js). Every key is optional.
  "hud": {
    // opencode-guard's permission-mode controls: "auto" shows them when the guard is
    // detected; true or false forces it.
    "permissionModes": "auto",
    // Picker copy, badge and the notice shown while a profile's model loads.
    "profiles": {
      "uncensored-70b": {
        "badge": "R:70b",
        "description": "The 70B across both GPUs: evicts every other local model until you leave this profile",
        "prepareNotice": "Loading the 70B across both GPUs -- several minutes. Other local models are down until you leave this profile."
      }
    },
    // Put the resting models back once the last session leaves these profiles.
    "swapBack": {
      "profiles": ["uncensored*"],
      "command": ["/usr/local/bin/model-swap", "default"],
      "activeMarker": "~/.local/state/model-swap/active"
    }
  },
  "modelVariants": {
    "openai/gpt-5.6-sol": [
      "high",
      "low",
      "medium"
    ],
    "openai/gpt-5.6-terra": [
      "high",
      "low",
      "medium"
    ],
    "openai/gpt-5.6-luna": [
      "high",
      "low",
      "medium"
    ],
    "openai/gpt-5.5-pro": [
      "high",
      "low",
      "medium"
    ]
  }
}
